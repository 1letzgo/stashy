ue":"“%@” silinsin mi? Bu işlem geri alınamaz."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"要刪除「%@」嗎？此動作無法還原。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Radera ”%@”? Det går inte att ångra."}},"de":{"stringUnit":{"state":"needs_review","value":"'%@' löschen? Das kann nicht rückgängig gemacht werden."}},"it":{"stringUnit":{"state":"needs_review","value":"Eliminare '%@'? Questa azione non può essere annullata."}},"nb":{"stringUnit":{"state":"needs_review","value":"Slette «%@»? Dette kan ikke angres."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Apagar '%@'? Não é possível desfazer."}},"da":{"stringUnit":{"state":"needs_review","value":"Slet '%@'? Det kan ikke fortrydes."}},"ko":{"stringUnit":{"state":"needs_review","value":"'%@'을(를) 삭제하겠습니까? 이 작업은 실행 취소할 수 없습니다."}},"ja":{"stringUnit":{"state":"needs_review","value":"「%@」を削除しますか？この操作は取り消せません。"}},"en":{"stringUnit":{"state":"needs_review","value":"Delete '%@'? This cannot be undone."}},"ru":{"stringUnit":{"state":"needs_review","value":"Удалить «%@»? Это действие нельзя отменить."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usunąć „%@”? Tej operacji nie można cofnąć."}},"es":{"stringUnit":{"state":"needs_review","value":"¿Eliminar «%@»? Esta acción no se puede deshacer."}},"fr":{"stringUnit":{"state":"needs_review","value":"Supprimer « %@ » ? Cette action est irréversible."}},"nl":{"stringUnit":{"state":"needs_review","value":"'%@' verwijderen? Dit kan niet ongedaan worden gemaakt."}}}},"hint_deletes_covers_previews_sprites_transcodes":{"localizations":{"ko":{"stringUnit":{"state":"needs_review","value":"데이터베이스의 어떤 항목에도 더 이상 속하지 않는 커버, 미리보기, 스프라이트, 트랜스코드, 마커 파일 및 썸네일을 삭제합니다."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usuwa okładki, podglądy, sprite'y, transkodowania, pliki znaczników i miniatury, które nie należą już do niczego w bazie danych."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Apaga capas, pré-visualizações, sprites, transcodificações, arquivos de marcadores e miniaturas que não pertencem mais a nada no banco de dados."}},"ru":{"stringUnit":{"state":"needs_review","value":"Удаляет обложки, превью, спрайты, перекодированные файлы, файлы маркеров и миниатюры, которые больше ни к чему не относятся в базе данных."}},"it":{"stringUnit":{"state":"needs_review","value":"Elimina copertine, anteprime, sprite, transcodifiche, file dei marcatori e miniature che non appartengono più a nulla nel database."}},"fr":{"stringUnit":{"state":"needs_review","value":"Supprime les couvertures, aperçus, sprites, transcodages, fichiers de marqueurs et vignettes qui n'appartiennent plus à rien dans la base de données."}},"da":{"stringUnit":{"state":"needs_review","value":"Sletter covers, forhåndsvisninger, sprites, omkodninger, markørfiler og miniaturer, der ikke længere hører til noget i databasen."}},"ja":{"stringUnit":{"state":"needs_review","value":"データベース内のどの項目にも属さなくなったカバー、プレビュー、スプライト、トランスコード、マーカーファイル、サムネイルを削除します。"}},"de":{"stringUnit":{"state":"needs_review","value":"Löscht Cover, Vorschauen, Sprites, Transcodes, Markerdateien und Thumbnails, die zu nichts mehr in der Datenbank gehören."}},"es":{"stringUnit":{"state":"needs_review","value":"Elimina portadas, vistas previas, sprites, transcodificaciones, archivos de marcadores y miniaturas que ya no pertenecen a nada de la base de datos."}},"nb":{"stringUnit":{"state":"needs_review","value":"Sletter omslag, forhåndsvisninger, sprites, transkodinger, markørfiler og miniatyrbilder som ikke lenger hører til noe i databasen."}},"en":{"stringUnit":{"state":"needs_review","value":"Deletes covers, previews, sprites, transcodes, marker files and thumbnails that no longer belong to anything in the database."}},"nl":{"stringUnit":{"state":"needs_review","value":"Verwijdert omslagen, voorvertoningen, sprites, transcodes, markeringsbestanden en miniaturen die niet meer bij iets in de database horen."}},"tr":{"stringUnit":{"state":"needs_review","value":"Veritabanında artık hiçbir şeye ait olmayan kapakları, önizlemeleri, sprite'ları, dönüştürülmüş videoları, işaretçi dosyalarını ve küçük resimleri siler."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"删除不再属于数据库中任何内容的封面、预览、雪碧图、转码文件、标记文件和缩略图。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Raderar omslag, förhandsvisningar, sprites, omkodningar, markörfiler och miniatyrer som inte längre hör till något i databasen."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"刪除不再屬於資料庫中任何項目的封面、預覽、拼貼圖、轉檔、標記檔案和縮圖。"}}}},"hint_deletes_this_item_and_its":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"確認後刪除此項目及其檔案"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"确认后删除此项目及其文件"}},"sv":{"stringUnit":{"state":"needs_review","value":"Raderar objektet och dess filer efter bekräftelse"}},"tr":{"stringUnit":{"state":"needs_review","value":"Onaydan sonra bu öğeyi ve dosyalarını siler"}},"pl":{"stringUnit":{"state":"needs_review","value":"Usuwa ten element i jego pliki po potwierdzeniu"}},"ko":{"stringUnit":{"state":"needs_review","value":"확인 후 이 항목과 해당 파일을 삭제합니다"}},"es":{"stringUnit":{"state":"needs_review","value":"Elimina este elemento y sus archivos tras confirmar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Supprime cet élément et ses fichiers après confirmation"}},"ja":{"stringUnit":{"state":"needs_review","value":"確認後、この項目とそのファイルを削除します"}},"it":{"stringUnit":{"state":"needs_review","value":"Elimina questo elemento e i suoi file dopo la conferma"}},"ru":{"stringUnit":{"state":"needs_review","value":"Удаляет этот объект и его файлы после подтверждения"}},"nl":{"stringUnit":{"state":"needs_review","value":"Verwijdert dit item en de bestanden ervan na bevestiging"}},"en":{"stringUnit":{"state":"needs_review","value":"Deletes this item and its files after confirmation"}},"de":{"stringUnit":{"state":"needs_review","value":"Löscht diesen Eintrag und seine Dateien nach Bestätigung"}},"da":{"stringUnit":{"state":"needs_review","value":"Sletter dette element og dets filer efter bekræftelse"}},"nb":{"stringUnit":{"state":"needs_review","value":"Sletter dette elementet og filene etter bekreftelse"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Apaga este item e seus arquivos após confirmação"}}}},"hint_double_tap_jumps_to_markers":{"localizations":{"pl":{"stringUnit":{"state":"needs_review","value":"Dwukrotne stuknięcie skacze do znaczników: w Feeds › Sceny dwukrotne stuknięcie po lewej lub prawej przechodzi do poprzedniego lub następnego znacznika sceny, która ma znaczniki. Gdy w tym kierunku nie ma znacznika, przewija jak zwykle o sekundy."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Toque duplo pula para marcadores: em Feeds › Cenas, um toque duplo à esquerda ou à direita vai para o marcador anterior ou seguinte de uma cena que tenha marcadores. Sem marcador nessa direção, pula segundos como de costume."}},"es":{"stringUnit":{"state":"needs_review","value":"Doble toque salta a los marcadores: en Feeds › Escenas, un doble toque a la izquierda o a la derecha va al marcador anterior o siguiente de una escena con marcadores. Si no hay marcador en esa dirección, salta segundos como siempre."}},"ko":{"stringUnit":{"state":"needs_review","value":"이중 탭하여 마커로 이동: Feeds › 영상에서 마커가 있는 영상의 왼쪽이나 오른쪽을 이중 탭하면 이전 또는 다음 마커로 이동합니다. 그 방향에 마커가 없으면 평소처럼 초 단위로 건너뜁니다."}},"de":{"stringUnit":{"state":"needs_review","value":"Doppeltippen springt zu Markern: In Feeds › Szenen springt ein Doppeltippen links oder rechts zum vorherigen oder nächsten Marker einer Szene mit Markern. Gibt es in dieser Richtung keinen Marker, werden wie gewohnt Sekunden übersprungen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Dubbeltik springt naar markeringen: in Feeds › Scènes gaat een dubbeltik links of rechts naar de vorige of volgende markering van een scène met markeringen. Zonder markering in die richting worden zoals gewoonlijk seconden overgeslagen."}},"nb":{"stringUnit":{"state":"needs_review","value":"Dobbelttrykk hopper til markører: I Feeds › Scener går et dobbelttrykk til venstre eller høyre til forrige eller neste markør i en scene som har markører. Uten en markør i den retningen hopper det sekunder som vanlig."}},"en":{"stringUnit":{"state":"needs_review","value":"Double tap jumps to markers: in Feeds › Scenes a double tap on the left or right goes to the previous or next marker of a scene that has markers. Without a marker in that direction it skips seconds as usual."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le double toucher passe aux marqueurs : dans Feeds › Scènes, un double toucher à gauche ou à droite passe au marqueur précédent ou suivant d'une scène qui en possède. Sans marqueur dans cette direction, il avance ou recule de quelques secondes comme d'habitude."}},"ja":{"stringUnit":{"state":"needs_review","value":"ダブルタップでマーカーへ移動：Feeds › シーンで、マーカーのあるシーンの左または右をダブルタップすると、前または次のマーカーへ移動します。その方向にマーカーがない場合は、通常どおり秒単位でスキップします。"}},"it":{"stringUnit":{"state":"needs_review","value":"Il doppio tocco salta ai marcatori: in Feeds › Scene un doppio tocco a sinistra o a destra va al marcatore precedente o successivo di una scena che ha marcatori. Se in quella direzione non ce n'è nessuno, salta i secondi come al solito."}},"da":{"stringUnit":{"state":"needs_review","value":"Dobbelttryk springer til markører: I Feeds › Scener går et dobbelttryk til venstre eller højre til forrige eller næste markør i en scene, der har markører. Uden en markør i den retning springes sekunder over som normalt."}},"ru":{"stringUnit":{"state":"needs_review","value":"Двойное касание — переход к маркерам: в Feeds › Сцены двойное касание слева или справа переходит к предыдущему или следующему маркеру сцены с маркерами. Если в этом направлении маркера нет, перематываются секунды, как обычно."}},"tr":{"stringUnit":{"state":"needs_review","value":"Çift dokunuş işaretçilere atlar: Feeds › Sahneler'de solda veya sağda çift dokunuş, işaretçileri olan bir sahnenin önceki veya sonraki işaretçisine gider. O yönde işaretçi yoksa her zamanki gibi saniye atlar."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"轻点两下跳转到标记：在 Feeds › 短片中，对有标记的短片在左侧或右侧轻点两下，会跳到上一个或下一个标记。若该方向没有标记，则照常快进或快退数秒。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"點兩下跳至標記：在 Feeds › 短片中，於左側或右側點兩下，即可跳至有標記之短片的上一個或下一個標記。若該方向沒有標記，則照常跳轉秒數。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Dubbeltryck hoppar till markörer: i Feeds › Scener går ett dubbeltryck till vänster eller höger till föregående eller nästa markör i en scen som har markörer. Utan markör åt det hållet hoppar det sekunder som vanligt."}}}},"hint_download_arg_speech_model_to":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"下載%@語音模型以啟用即時字幕。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"下载%@语音模型以启用实时字幕。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Canlı altyazıları açmak için %@ konuşma modelini indir."}},"sv":{"stringUnit":{"state":"needs_review","value":"Ladda ner talmodellen för %@ för att aktivera liveundertexter."}},"it":{"stringUnit":{"state":"needs_review","value":"Scarica il modello vocale %@ per attivare i sottotitoli in tempo reale."}},"nb":{"stringUnit":{"state":"needs_review","value":"Last ned talemodellen for %@ for å slå på direkteteksting."}},"en":{"stringUnit":{"state":"needs_review","value":"Download the %@ speech model to enable live captions."}},"nl":{"stringUnit":{"state":"needs_review","value":"Download het spraakmodel %@ om live bijschriften in te schakelen."}},"es":{"stringUnit":{"state":"needs_review","value":"Descarga el modelo de voz %@ para activar los subtítulos en directo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Téléchargez le modèle vocal %@ pour activer les sous-titres en direct."}},"ko":{"stringUnit":{"state":"needs_review","value":"실시간 캡션을 사용하려면 %@ 음성 모델을 다운로드하세요."}},"da":{"stringUnit":{"state":"needs_review","value":"Download talemodellen til %@ for at slå live-undertekster til."}},"pt-BR":{"stringUnit":{"stat