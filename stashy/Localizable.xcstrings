value":"Classifica suas principais cenas, artistas, estúdios e etiquetas em Ferramentas, por critérios como contagem O ou avaliação."}},"ja":{"stringUnit":{"state":"needs_review","value":"Oカウントや評価などの指標で、トップのシーン、出演者、スタジオ、タグをツールでランキング表示します。"}},"da":{"stringUnit":{"state":"needs_review","value":"Rangerer dine topscener, -kunstnere, -studier og -tags i Værktøjer efter mål som O-tæller eller bedømmelse."}},"nb":{"stringUnit":{"state":"needs_review","value":"Rangerer de beste scenene, utøverne, studioene og taggene dine i Verktøy, etter mål som O-teller eller vurdering."}},"en":{"stringUnit":{"state":"needs_review","value":"Ranks your top scenes, performers, studios and tags in Tools, by measures like O Count or rating."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在「工具」中依 O 計數或評分等指標，為你最常看的短片、演員、工作室和標籤排名。"}},"ar":{"stringUnit":{"state":"needs_review","value":"يرتّب أفضل مشاهدك ومؤديك واستوديوهاتك ووسومك في الأدوات، وفق مقاييس مثل عدّاد O أو التقييم."}},"sv":{"stringUnit":{"state":"needs_review","value":"Rangordnar dina främsta scener, stjärnor, studior och taggar i Verktyg, efter mått som O-räknare eller betyg."}},"pl":{"stringUnit":{"state":"needs_review","value":"Tworzy w Narzędziach rankingi Twoich najlepszych scen, aktorów, studiów i tagów według miar takich jak licznik O czy ocena."}}}},"hint_ratings_that_were_not_saved":{"localizations":{"pl":{"stringUnit":{"state":"needs_review","value":"Niezapisane oceny zostaną utracone."}},"da":{"stringUnit":{"state":"needs_review","value":"Bedømmelser, der ikke blev gemt, går tabt."}},"ar":{"stringUnit":{"state":"needs_review","value":"ستُفقد التقييمات التي لم يتم حفظها."}},"ja":{"stringUnit":{"state":"needs_review","value":"保存されていない評価は失われます。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Avaliações que não foram salvas serão perdidas."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les notes non enregistrées sont perdues."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"未儲存的評分將會遺失。"}},"de":{"stringUnit":{"state":"needs_review","value":"Nicht gespeicherte Bewertungen gehen verloren."}},"nb":{"stringUnit":{"state":"needs_review","value":"Vurderinger som ikke ble lagret, går tapt."}},"sv":{"stringUnit":{"state":"needs_review","value":"Betyg som inte sparades går förlorade."}},"nl":{"stringUnit":{"state":"needs_review","value":"Beoordelingen die niet zijn bewaard, gaan verloren."}},"en":{"stringUnit":{"state":"needs_review","value":"Ratings that were not saved are lost."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"未存储的评分将会丢失。"}}}},"hint_remove_arg_from_stash_other":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"要從 Stash 移除「%@」嗎？其他裝置將失去此已儲存的篩選條件。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Retirer « %@ » de Stash ? Les autres appareils perdront ce filtre enregistré."}},"sv":{"stringUnit":{"state":"needs_review","value":"Ta bort ”%@” från Stash? Andra enheter förlorar det här sparade filtret."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"要从 Stash 中移除“%@”吗？其他设备将失去此已存过滤器。"}},"ja":{"stringUnit":{"state":"needs_review","value":"「%@」をStashから削除しますか？他のデバイスでもこの保存済みフィルターが使えなくなります。"}},"en":{"stringUnit":{"state":"needs_review","value":"Remove “%@” from Stash? Other devices will lose this saved filter."}},"nl":{"stringUnit":{"state":"needs_review","value":"'%@' uit Stash verwijderen? Andere apparaten verliezen dit bewaarde filter."}},"da":{"stringUnit":{"state":"needs_review","value":"Fjern “%@” fra Stash? Andre enheder mister dette gemte filter."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usunąć „%@” ze Stash? Inne urządzenia stracą ten zapisany filtr."}},"de":{"stringUnit":{"state":"needs_review","value":"„%@“ aus Stash entfernen? Andere Geräte verlieren diesen gespeicherten Filter."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Remover “%@” do Stash? Outros dispositivos perderão este filtro salvo."}},"ar":{"stringUnit":{"state":"needs_review","value":"إزالة “%@” من Stash؟ ستفقد الأجهزة الأخرى هذا الفلتر المحفوظ."}},"nb":{"stringUnit":{"state":"needs_review","value":"Fjerne «%@» fra Stash? Andre enheter mister dette lagrede filteret."}}}},"hint_remove_arg_from_this_device":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"「%@」をこのデバイスから削除しますか？この操作は取り消せません。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"要从此设备中移除“%@”吗？此操作无法撤销。"}},"da":{"stringUnit":{"state":"needs_review","value":"Fjern “%@” fra denne enhed? Det kan ikke fortrydes."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usunąć „%@” z tego urządzenia? Tej operacji nie można cofnąć."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Remover “%@” deste dispositivo? Não é possível desfazer."}},"sv":{"stringUnit":{"state":"needs_review","value":"Ta bort ”%@” från den här enheten? Det går inte att ångra."}},"de":{"stringUnit":{"state":"needs_review","value":"„%@“ von diesem Gerät entfernen? Das kann nicht rückgängig gemacht werden."}},"nl":{"stringUnit":{"state":"needs_review","value":"'%@' van dit apparaat verwijderen? Dit kan niet ongedaan worden gemaakt."}},"fr":{"stringUnit":{"state":"needs_review","value":"Retirer « %@ » de cet appareil ? Cette action est irréversible."}},"en":{"stringUnit":{"state":"needs_review","value":"Remove “%@” from this device? This cannot be undone."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"要從此裝置移除「%@」嗎？此動作無法還原。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Fjerne «%@» fra denne enheten? Dette kan ikke angres."}},"ar":{"stringUnit":{"state":"needs_review","value":"إزالة “%@” من هذا الجهاز؟ لا يمكن التراجع عن ذلك."}}}},"hint_removes_arg_from_dashboard_saved":{"localizations":{"pt-BR":{"stringUnit":{"state":"needs_review","value":"Remove \"%@\" do Dashboard. O filtro salvo em si continua no servidor."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"從 Dashboard 移除「%@」。已儲存的篩選條件本身仍會保留在伺服器上。"}},"ar":{"stringUnit":{"state":"needs_review","value":"يزيل \"%@\" من Dashboard. يبقى الفلتر المحفوظ نفسه على الخادم."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"从 Dashboard 中移除“%@”。已存过滤器本身仍保留在服务器上。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Verwijdert '%@' van het dashboard. Het bewaarde filter zelf blijft op de server."}},"ja":{"stringUnit":{"state":"needs_review","value":"「%@」をDashboardから削除します。保存済みフィルター自体はサーバーに残ります。"}},"da":{"stringUnit":{"state":"needs_review","value":"Fjerner \"%@\" fra Dashboard. Selve det gemte filter bliver på serveren."}},"de":{"stringUnit":{"state":"needs_review","value":"Entfernt „%@“ aus dem Dashboard. Der gespeicherte Filter selbst bleibt auf dem Server."}},"en":{"stringUnit":{"state":"needs_review","value":"Removes \"%@\" from the dashboard. The saved filter itself stays on the server."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usuwa „%@” z Dashboardu. Sam zapisany filtr pozostaje na serwerze."}},"nb":{"stringUnit":{"state":"needs_review","value":"Fjerner «%@» fra Dashboard. Selve det lagrede filteret blir værende på serveren."}},"fr":{"stringUnit":{"state":"needs_review","value":"Retire « %@ » du Dashboard. Le filtre enregistré reste sur le serveur."}},"sv":{"stringUnit":{"state":"needs_review","value":"Tar bort ”%@” från Dashboard. Själva det sparade filtret finns kvar på servern."}}}},"hint_removes_cached_artwork_for_active":{"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Entfernt die zwischengespeicherten Bilder des aktiven Servers. Bilder werden beim Anzeigen neu geladen."}},"ar":{"stringUnit":{"state":"needs_review","value":"يزيل الصور المخزنة مؤقتًا للخادم النشط. يُعاد تنزيل الصور عند ظهورها."}},"sv":{"stringUnit":{"state":"needs_review","value":"Tar bort cachade bilder för den aktiva servern. Bilderna laddas ner igen när de visas."}},"nb":{"stringUnit":{"state":"needs_review","value":"Fjerner de bufrede bildene for den aktive serveren. Bildene lastes ned på nytt når de vises."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"移除使用中伺服器的快取插圖。圖片會在顯示時重新下載。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Verwijdert de bewaarde illustraties voor de actieve server. Afbeeldingen worden opnieuw gedownload zodra ze verschijnen."}},"ja":{"stringUnit":{"state":"needs_review","value":"使用中のサーバーのキャッシュ画像を削除します。画像は表示されるときに再ダウンロードされます。"}},"en":{"stringUnit":{"state":"needs_review","value":"Removes the cached artwork for the active server. Images are downloaded again as they appear."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usuwa zapisane grafiki aktywnego serwera. Obrazy zostaną ponownie pobrane, gdy się pojawią."}},"fr":{"stringUnit":{"state":"needs_review","value":"Supprime les illustrations en cache du serveur actif. Les images sont retéléchargées lorsqu'elles apparaissent."}},"da":{"stringUnit":{"state":"needs_review","value":"Fjerner de cachelagrede billeder for den aktive server. Billederne downloades igen, når de vises."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Remove as imagens em cache do servidor ativo. As imagens são baixadas novamente quando aparecerem."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"移除当前服务器的缓存图片。图片再次出现时会重新下载。"}}}},"hint_removes_downloaded_speech_models_and":{"localizations":{"pt-BR":{"stringUnit":{"state":"needs_review","value":"Remove os modelos de fala e pacotes de tradução baixados. As legendas por IA os baixam novamente quando necessário."}},"ar":{"stringUnit":{"state":"needs_review","value":"يزيل نماذج الكلام وحزم الترجمة التي تم تنزيلها. تنزّلها ترجمات الذكاء الاصطناعي مجددًا عند الحاجة."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usuwa pobrane modele mowy i pakiety tłumaczeń. Napisy AI pobiorą je ponownie w razie potrzeby."}},"nb":{"stringUnit":{"state":"needs_review","value":"Fjerner nedlastede talemodeller og oversettelsespakker. AI-undertekster laster dem ned igjen ved behov."}},"de":{"stringUnit":{"state":"needs_review","value":"Entfernt die geladenen Sprachmodelle und Übersetzungspakete. KI-Untertitel laden sie bei Bedarf erneut."}},"sv":{"stringUnit":{"state":"needs_review","value":"Tar bort nedladdade talmodeller och översättningspaket. AI-undertexter laddar ner dem igen vid behov."}},"ja":{"stringUnit":{"state":"needs_review","value":"ダウンロード済みの音声モデルと翻訳パックを削除します。AI字幕は必要に応じて再ダウンロードします。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"移除已下载的语音模型和翻译包。AI 字幕会在需要时重新下载它们。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"移除已下載的語音模型和翻譯套件。AI 字幕會在需要時重新下載。"}},"en":{"stringUnit":{"state":"needs_review","value":"Removes the downloaded speech models and translation packs. AI subtitles download them again when needed."}},"nl":{"stringUnit":{"state":"needs_review","value":"Verwijdert de gedownloade spraakmodellen en vertaalpakketten. AI-ondertiteling downloadt ze opnieuw wanneer nodig."}},"fr":{"stringUnit":{"state":"needs_review","value":"Supprime les modèles vocaux et packs de traduction téléchargés. Les sous-titres IA les retéléchargent au besoin."}},"da":{"stringUnit":{"state":"needs_review","value":"Fjerner de downloadede talemodeller og oversættelsespakker. AI-undertekster downloader dem igen efter behov."}}}},"hint_removes_scenes_images_and_galleries":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"移除文件已不存在的短片、图片和图库及其生成的文件。此操作无法撤销。试运行只会写入服务器日志。"}},"de":{"stringUnit":{"state":"needs_review","value":"Entfernt Szenen, Bilder und Galerien, deren Dateien nicht mehr existieren, samt ihren generierten Dateien. Das kann nicht rückgängig gemacht werden. Ein Probelauf schreibt nur ins Server-Log."}},"fr":{"stringUnit":{"state":"needs_review","value":"Supprime les scènes, images et galeries dont les fichiers n'existent plus, ainsi que leurs fichiers générés. Cette action est irréversible. Une simulation écrit seulement dans le journal du serveur."}},"sv":{"stringUnit":{"state":"needs_review","value":"Tar bort scener, bilder och gallerier vars filer inte längre finns, tillsammans med deras genererade filer. Det går inte att ångra. En testkörning skriver bara till serverloggen."}},"en":{"stringUnit":{"state":"needs_review","value":"Removes scenes, images and galleries whose files no longer exist, with their generated files. This cannot be undone. A dry run only writes to the server log."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"移除檔案已不存在的短片、圖片和圖庫，以及其產生的檔案。此動作無法還原。試執行只會寫入伺服器日誌。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Fjerner scener, bilder og gallerier der filene ikke lenger finnes, sammen med de genererte filene. Dette kan ikke angres. En prøvekjøring skriver bare til serverloggen."}},"ar":{"stringUnit":{"state":"needs_review","value":"يزيل المشاهد والصور والمعارض التي لم تعد ملفاتها موجودة، مع ملفاتها المولّدة. لا يمكن التراجع عن ذلك. التجربة دون تنفيذ تكتب في سجل الخادم فقط."}},"ja":{"stringUnit":{"state":"needs_review","value":"ファイルが存在しなくなったシーン、画像、ギャラリーを、生成されたファイルとともに削除します。この操作は取り消せません。ドライランではサーバーログへの書き込みのみ行います。"}},"da":{"stringUnit":{"state":"needs_review","value":"Fjerner scener, billeder og gallerier, hvis filer ikke længere findes, sammen med deres genererede filer. Det kan ikke fortrydes. En prøvekørsel skriver kun til serverloggen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Remove cenas, imagens e galerias cujos arquivos não existem mais, junto com seus arquivos gerados. Não é possível desfazer. Uma simulação apenas escreve no log do servidor."}},"nl":{"stringUnit":{"state":"needs_review","value":"Verwijdert scènes, afbeeldingen en galerijen waarvan de bestanden niet meer bestaan, met hun gegenereerde bestanden. Dit kan niet ongedaan worden gemaakt. Een proefrun schrijft alleen naar het serverlogboek."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usuwa sceny, obrazy i galerie, których pliki już nie istnieją, wraz z wygenerowanymi plikami. Tej operacji nie można cofnąć. Próba na sucho zapisuje tylko w dzienniku serwera."}}}},"hint_remove_this_filter_this_cannot":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Ta bort det här filtret? Det går inte att ångra."}},"en":{"stringUnit":{"state":"needs_review","value":"Remove this filter? This cannot be undone."}},"da":{"stringUnit":{"state":"needs_review","value":"Fjern dette filter? Det kan ikke fortrydes."}},"ar":{"stringUnit":{"state":"needs_review","value":"إزالة هذا الفلتر؟ لا يمكن التراجع عن ذلك."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"要移除此篩選條件嗎？此動作無法還原。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Dit filter verwijderen? Dit kan niet ongedaan worden gemaakt."}},"ja":{"stringUnit":{"state":"needs_review","value":"このフィルターを削除しますか？この操作は取り消せません。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Usunąć ten filtr? Tej operacji nie można cofnąć."}},"de":{"stringUnit":{"state":"needs_review","value":"Diesen Filter entfernen? Das kann nicht rückgängig gemacht werden."}},"fr":{"stringUnit":{"state":"needs_review","value":"Retirer ce filtre ? Cette action est irréversible."}},"nb":{"stringUnit":{"state":"needs_review","value":"Fjerne dette filteret? Dette kan ikke angres."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"要移除此过滤器吗？此操作无法撤销。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Remover este filtro? Não é possível desfazer."}}}},"hint_renames_selected_stash_saved_filter":{"localizations":{"nb":{"stringUnit":{"state":"needs_review","value":"Gir det valgte lagrede Stash-filteret eller filteret på enheten nytt navn."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"重新命名所選的 Stash 已儲存篩選條件或裝置上的篩選條件。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Renomeia o filtro salvo do Stash ou o filtro do dispositivo selecionado."}},"fr":{"stringUnit":{"state":"needs_review","value":"Renomme le filtre enregistré Stash ou le filtre local sélectionné."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"重命名所选的 Stash 已存过滤器或设备上的过滤器。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Zmienia nazwę wybranego zapisanego filtra Stash lub filtra na urządzeniu."}},"da":{"stringUnit":{"sta