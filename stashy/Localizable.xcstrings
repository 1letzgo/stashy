 bedømmelser."}},"de":{"stringUnit":{"state":"needs_review","value":"Szenen, ausgewählt aus deinen Wiedergaben, O-Zählern und Bewertungen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Scènes gekozen uit je weergaven, O-tellers en beoordelingen."}},"sv":{"stringUnit":{"state":"needs_review","value":"Scener utvalda utifrån dina uppspelningar, O-räknare och betyg."}},"nb":{"stringUnit":{"state":"needs_review","value":"Scener valgt ut fra avspillinger, O-tellere og vurderinger."}},"ru":{"stringUnit":{"state":"needs_review","value":"Сцены, подобранные по вашим воспроизведениям, O и рейтингам."}},"it":{"stringUnit":{"state":"needs_review","value":"Scene scelte in base a riproduzioni, contatori O e valutazioni."}},"fr":{"stringUnit":{"state":"needs_review","value":"Scènes sélectionnées à partir de vos lectures, compteurs O et notes."}},"es":{"stringUnit":{"state":"needs_review","value":"Escenas seleccionadas a partir de tus reproducciones, contadores O y valoraciones."}}}},"hint_scenes_played_in_this_period":{"localizations":{"ru":{"stringUnit":{"state":"needs_review","value":"Сцены, воспроизведенные в этот период, не предлагаются."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les scènes lues pendant cette période ne sont pas suggérées."}},"ja":{"stringUnit":{"state":"needs_review","value":"この期間に再生したシーンは提案されません。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Scènes die in deze periode zijn afgespeeld, worden niet voorgesteld."}},"en":{"stringUnit":{"state":"needs_review","value":"Scenes played in this period are not suggested."}},"it":{"stringUnit":{"state":"needs_review","value":"Le scene riprodotte in questo periodo non vengono suggerite."}},"nb":{"stringUnit":{"state":"needs_review","value":"Scener som er spilt i denne perioden, blir ikke foreslått."}},"ko":{"stringUnit":{"state":"needs_review","value":"이 기간에 재생한 영상은 제안되지 않습니다."}},"pl":{"stringUnit":{"state":"needs_review","value":"Sceny odtwarzane w tym okresie nie są proponowane."}},"da":{"s