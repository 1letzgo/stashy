"en":{"stringUnit":{"state":"needs_review","value":"Puts performers against each other in Tools. You pick the winner and their ratings update on your server."}},"ru":{"stringUnit":{"state":"needs_review","value":"Сталкивает исполнителей друг с другом в «Инструментах». Вы выбираете победителя, а их рейтинги обновляются на сервере."}},"de":{"stringUnit":{"state":"needs_review","value":"Lässt in Werkzeuge Darsteller gegeneinander antreten. Du wählst den Gewinner, und ihre Bewertungen werden auf deinem Server aktualisiert."}},"es":{"stringUnit":{"state":"needs_review","value":"Enfrenta a intérpretes entre sí en Herramientas. Tú eliges al ganador y sus valoraciones se actualizan en tu servidor."}},"it":{"stringUnit":{"state":"needs_review","value":"Mette i performer uno contro l'altro in Strumenti. Scegli tu il vincitore e le loro valutazioni vengono aggiornate sul server."}},"ja":{"stringUnit":{"state":"needs_review","value":"ツールで出演者同士を対戦させます。勝者を選ぶと、サーバー上の評価が更新されます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"도구에서 배우끼리 대결시킵니다. 승자를 고르면 서버의 별점이 업데이트됩니다."}},"fr":{"stringUnit":{"state":"needs_review","value":"Oppose des performeurs les uns aux autres dans Outils. Vous choisissez le gagnant et leurs notes sont mises à jour sur votre serveur."}},"nl":{"stringUnit":{"state":"needs_review","value":"Zet performers tegen elkaar op in Tools. Jij kiest de winnaar en hun beoordelingen worden op je server bijgewerkt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zestawia aktorów ze sobą w Narzędziach. Wybierasz zwycięzcę, a ich oceny aktualizują się na serwerze."}},"nb":{"stringUnit":{"state":"needs_review","value":"Setter utøvere opp mot hverandre i Verktøy. Du velger vinneren, og vurderingene oppdateres på serveren."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Coloca artistas uns contra os outros em Ferramentas. Você escolhe o vencedor e as avaliações deles são atualizadas no seu servidor."}},"da":{"stringUnit":{"state":"needs_review","value":"Sætter kunstnere op mod hinanden i Værktøjer. Du vælger vinderen, og deres bedømmelser opdateres på din server."}}}},"hint_puts_performers_against_each_other_under":{"localizations":{"da":{"stringUnit":{"state":"needs_review","value":"Sætter kunstnere op mod hinanden under Opdag. Du vælger vinderen, og deres bedømmelser opdateres på din server."}},"sv":{"stringUnit":{"state":"needs_review","value":"Ställer stjärnor mot varandra under Upptäck. Du väljer vinnaren och deras betyg uppdateras på servern."}},"ja":{"stringUnit":{"state":"needs_review","value":"「見つける」で出演者同士を対戦させます。勝者を選ぶと、サーバー上の評価が更新されます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"둘러보기에서 배우끼리 대결시킵니다. 승자를 고르면 서버의 별점이 업데이트됩니다."}},"es":{"stringUnit":{"state":"needs_review","value":"Enfrenta a intérpretes entre sí en Descubrir. Tú eliges al ganador y sus valoraciones se actualizan en tu servidor."}},"nl":{"stringUnit":{"state":"needs_review","value":"Zet performers tegen elkaar op onder Ontdek. Jij kiest de winnaar en hun beoordelingen worden op je server bijgewerkt."}},"fr":{"stringUnit":{"state":"needs_review","value":"Oppose des performeurs les uns aux autres dans Découvrir. Vous choisissez le gagnant et leurs notes sont mises à jour sur votre serveur."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zestawia aktorów ze sobą w sekcji Odkrywaj. Wybierasz zwycięzcę, a ich oceny aktualizują się na serwerze."}},"de":{"stringUnit":{"state":"needs_review","value":"Lässt unter Entdecken Darsteller gegeneinander antreten. Du wählst den Gewinner, und ihre Bewertungen werden auf deinem Server aktualisiert."}},"it":{"stringUnit":{"state":"needs_review","value":"Mette i performer uno contro l'altro in Scopri. Scegli tu il vincitore e le loro valutazioni vengono aggiornate sul server."}},"ru":{"stringUnit":{"state":"needs_review","value":"Сталкивает исполнителей друг с другом в разделе «Открытия». Вы выбираете победителя, а их рейтинги обновляются на сервере."}},"en":{"stringUnit":{"state":"needs_review","value":"Puts performers against each other under Discover. You pick the winner and their ratings update on your server."}},"nb":{"stringUnit":{"state":"needs_review","value":"Setter utøvere opp mot hverandre under Utforsk. Du velger vinneren, og vurderingene oppdateres på serveren."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Coloca artistas uns contra os outros em Descobrir. Você escolhe o vencedor e as avaliações deles são atualizadas no seu servidor."}},"tr":{"stringUnit":{"state":"needs_review","value":"Keşfet altında oyuncuları karşı karşıya getirir. Kazananı sen seçersin ve puanları sunucunda güncellenir."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在“发现”中让演员两两对决。你选出胜者，其评分会在你的服务器上更新。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在「探索」中讓演員互相對決。由你選出勝者，其評分會在你的伺服器上更新。"}}}},"hint_ranks_your_top_scenes_performers":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在「工具」中依 O 計數或評分等指標，為你最常看的短片、演員、工作室和標籤排名。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Rangordnar dina främsta scener, stjärnor, studior och taggar i Verktyg, efter mått som O-räknare eller betyg."}},"tr":{"stringUnit":{"state":"needs_review","value":"Araçlar'da en iyi sahnelerini, oyuncularını, stüdyolarını ve etiketlerini O Sayısı veya puan gibi ölçülere göre sıralar."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在“工具”中按 O 计数或评分等指标为你的热门短片、演员、工作室和标签排名。"}},"en":{"stringUnit":{"state":"needs_review","value":"Ranks your top scenes, performers, studios and tags in Tools, by measures like O Count or rating."}},"ru":{"stringUnit":{"state":"needs_review","value":"Составляет в «Инструментах» рейтинги ваших лучших сцен, исполнителей, студий и тегов — по счетчику O, рейтингу и другим показателям."}},"ja":{"stringUnit":{"state":"needs_review","value":"Oカウントや評価などの指標で、トップのシーン、出演者、スタジオ、タグをツールでランキング表示します。"}},"es":{"stringUnit":{"state":"needs_review","value":"Clasifica tus escenas, intérpretes, estudios y etiquetas favoritos en Herrami