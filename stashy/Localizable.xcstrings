nce ücretli uygulama olarak aldıysan veya TestFlight'tan yeni geçtiysen Satın Alınanları Geri Yükle'ye dokun."}}}},"hint_need_at_least_arg_performers":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Minst %@ stjärnor med bilder krävs för de valda könen."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"所選性別至少需要 %@ 位有圖片的演員。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Seçili cinsiyetler için resmi olan en az %@ oyuncu gerekli."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"所选性别中至少需要 %@ 位有图片的演员。"}},"ja":{"stringUnit":{"state":"needs_review","value":"選択した性別で画像のある出演者が%@人以上必要です。"}},"de":{"stringUnit":{"state":"needs_review","value":"Mindestens %@ Darsteller mit Bildern für die gewählten Geschlechter nötig."}},"nb":{"stringUnit":{"state":"needs_review","value":"Trenger minst %@ utøvere med bilder for de valgte kjønnene."}},"it":{"stringUnit":{"state":"needs_review","value":"Servono almeno %@ performer con immagini per i generi selezionati."}},"en":{"stringUnit":{"state":"needs_review","value":"Need at least %@ performers with images for the selected genders."}},"da":{"stringUnit":{"state":"needs_review","value":"Der kræves mindst %@ kunstnere med billeder for de valgte køn."}},"ar":{"stringUnit":{"state":"needs_review","value":"يلزم %@ مؤدين على الأقل لديهم صور للأجناس المحددة."}},"fr":{"stringUnit":{"state":"needs_review","value":"Il faut au moins %@ performeurs avec image pour les genres sélectionnés."}},"ru":{"stringUnit":{"state":"needs_review","value":"Для выбранного пола нужно не менее %@ исполнителей с изображениями."}},"pl":{"stringUnit":{"state":"needs_review","value":"Potrzeba co najmniej %@ aktorów ze zdjęciami dla wybranych płci."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"São necessários pelo menos %@ artistas com imagens para os gêneros selecionados."}},"ko":{"stringUnit":{"state":"needs_review","value":"선택한 성별에 사진이 있는 배우가 최소 %@명 필요합니다."}},"es":{"stringUnit":{"state":"needs_review","value":