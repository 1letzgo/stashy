"en":{"stringUnit":{"state":"needs_review","value":"Opens this scene; Back returns to RateMe"}},"ja":{"stringUnit":{"state":"needs_review","value":"このシーンを開きます。戻るでRateMeに戻ります"}},"pl":{"stringUnit":{"state":"needs_review","value":"Otwiera tę scenę; Wstecz wraca do RateMe"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Abre esta cena; Voltar retorna ao RateMe"}},"de":{"stringUnit":{"state":"needs_review","value":"Öffnet diese Szene; Zurück kehrt zu RateMe zurück"}},"ar":{"stringUnit":{"state":"needs_review","value":"يفتح هذا المشهد؛ «رجوع» يعود إلى RateMe"}},"es":{"stringUnit":{"state":"needs_review","value":"Abre esta escena; Atrás vuelve a RateMe"}},"ru":{"stringUnit":{"state":"needs_review","value":"Открывает эту сцену; «Назад» возвращает в RateMe"}},"it":{"stringUnit":{"state":"needs_review","value":"Apre questa scena; Indietro torna a RateMe"}},"nb":{"stringUnit":{"state":"needs_review","value":"Åpner denne scenen; Tilbake går tilbake til RateMe"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ouvre cette scène ; Retour ramène à RateMe"}},"da":{"stringUnit":{"state":"needs_review","value":"Åbner denne scene; Tilbage vender tilbage til RateMe"}},"nl":{"stringUnit":{"state":"needs_review","value":"Opent deze scène; Terug keert terug naar RateMe"}},"ko":{"stringUnit":{"state":"needs_review","value":"이 영상을 엽니다. 뒤로를 누르면 RateMe로 돌아갑니다"}}}},"hint_optional_used_instead_of_address":{"localizations":{"pt-BR":{"stringUnit":{"state":"needs_review","value":"Opcional. Usado no lugar do endereço acima sempre que responder, por exemplo na sua rede doméstica. Volta automaticamente ao outro."}},"de":{"stringUnit":{"state":"needs_review","value":"Optional. Wird statt der Adresse oben verwendet, sobald sie antwortet, etwa in deinem Heimnetz. Wechselt automatisch zurück."}},"ar":{"stringUnit":{"state":"needs_review","value":"اختياري. يُستخدم بدلًا من العنوان أعلاه كلما استجاب، مثلًا على شبكتك المنزلية. يعود تلقائيًا إلى العنوان الأساسي."}},"da":{"stringUnit":{"state":"needs_review","value":"Valgfri. Bruges i stedet for adressen ovenfor, når den svarer, f.eks. på dit hjemmenetværk. Skifter automatisk tilbage."}},"ru":{"stringUnit":{"state":"needs_review","value":"Необязательно. Используется вместо адреса выше, когда отвечает, например в домашней сети. При недоступности — автоматический возврат."}},"fr":{"stringUnit":{"state":"needs_review","value":"Facultatif. Utilisée à la place de l'adresse ci-dessus dès qu'elle répond, par exemple sur votre réseau domestique. Bascule automatiquement sinon."}},"nb":{"stringUnit":{"state":"needs_review","value":"Valgfritt. Brukes i stedet for adressen ovenfor når den svarer, for eksempel på hjemmenettverket. Faller automatisk tilbake."}},"es":{"stringUnit":{"state":"needs_review","value":"Opcional. Se usa en lugar de la dirección de arriba siempre que responda, por ejemplo en tu red doméstica. Si no, se vuelve a la otra automáticamente."}},"en":{"stringUnit":{"state":"needs_review","value":"Optional. Used instead of the address above whenever it answers, for example on your home network. Falls back automatically."}},"nl":{"stringUnit":{"state":"needs_review","value":"Optioneel. Wordt gebruikt in plaats van het adres hierboven zodra het antwoordt, bijvoorbeeld op je thuisnetwerk. Valt automatisch terug."}},"ko":{"stringUnit":{"state":"needs_review","value":"선택 사항. 홈 네트워크 등에서 응답할 때마다 위의 주소 대신 사용됩니다. 응답하지 않으면 자동으로 되돌아갑니다."}},"ja":{"stringUnit":{"state":"needs_review","value":"任意。応答がある場合（自宅のネットワークなど）は、上のアドレスの代わりに使用されます。自動的に切り替わります。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Valfritt. Används i stället för adressen ovan när den svarar, till exempel på ditt hemnätverk. Faller tillbaka automatiskt."}},"it":{"stringUnit":{"state":"needs_review","value":"Facoltativo. Usato al posto dell'indirizzo qui sopra ogni volta che risponde, ad esempio sulla rete di casa. Altrimenti torna automaticamente all'altro."}},"pl":{"stringUnit":{"state":"needs_review","value":"Opcjonalnie. Używany zamiast powyższego adresu, gdy tylko odpowiada, np. w sieci domowej. W razie potrzeby automatycznie wraca do zwykłego adresu."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選填。只要能連上，就會取代上方的位址，例如在你的家用網路中。連不上時會自動改用原位址。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"可选。只要该地址有响应（例如在家庭网络中），就会代替上方地址使用。会自动回退。"}},"tr":{"stringUnit":{"state":"needs_review","value":"İsteğe bağlı. Yanıt verdiği sürece, örneğin ev ağında, yukarıdaki adres yerine kullanılır. Otomatik olarak geri döner."}}}},"hint_original_could_not_be_played":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法播放原始檔 — 改用伺服器轉檔"}},"tr":{"stringUnit":{"state":"needs_review","value":"Orijinal oynatılamadı — sunucu dönüştürmesi kullanılıyor"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法播放原始文件 — 正在使用服务器转码"}},"ko":{"stringUnit":{"state":"needs_review","value":"원본을 재생할 수 없습니다 — 서버 트랜스코드를 사용합니다"}},"sv":{"stringUnit":{"state":"needs_review","value":"Originalet kunde inte spelas – använder serverns omkodning"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można odtworzyć oryginału — używane jest transkodowanie serwera"}},"fr":{"stringUnit":{"state":"needs_review","value":"L'original n'a pas pu être lu — utilisation du transcodage du serveur"}},"ar":{"stringUnit":{"state":"needs_review","value":"تعذّر تشغيل الملف الأصلي — يتم استخدام الملف المحوّل من الخادم"}},"ja":{"stringUnit":{"state":"needs_review","value":"オリジナルを再生できませんでした — サーバーのトランスコードを使用します"}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось воспроизвести оригинал — используется перекодировка сервера"}},"nl":{"stringUnit":{"state":"needs_review","value":"Origineel kon niet worden afgespeeld – de servertranscode wordt gebruikt"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível reproduzir o original — usando a transcodificação do servidor"}},"nb":{"stringUnit":{"state":"needs_review","value":"Originalen kunne ikke spilles av – bruker serverens transkoding"}},"da":{"stringUnit":{"state":"needs_review","value":"Originalen kunne ikke afspilles – bruger serverens omkodning"}},"en":{"stringUnit":{"state":"needs_review","value":"Original could not be played — using the server transcode"}},"es":{"stringUnit":{"state":"needs_review","value":"No se pudo reproducir el original; se usa la transcodificación del servidor"}},"de":{"stringUnit":{"state":"needs_review","value":"Original konnte nicht abgespielt werden – Server-Transcode wird verwendet"}},"it":{"stringUnit":{"state":"needs_review","value":"Impossibile riprodurre l'originale: uso della transcodifica del server"}}}},"hint_other_names_for_this_tag":{"localizations":{"en":{"stringUnit":{"state":"needs_review","value":"Other names for this tag. Swipe left to remove one."}},"pl":{"stringUnit":{"state":"needs_review","value":"Inne nazwy tego tagu. Przesuń w lewo, aby usunąć."}},"ar":{"stringUnit":{"state":"needs_review","value":"أسماء أخرى لهذا الوسم. اسحب لليسار لإزالة أحدها."}},"da":{"stringUnit":{"state":"needs_review","value":"Andre navne for dette tag. Stryg til venstre for at fjerne et."}},"nl":{"stringUnit":{"state":"needs_review","value":"Andere namen voor dit label. Veeg naar links om er een te verwijderen."}},"ru":{"stringUnit":{"state":"needs_review","value":"Другие названия этого тега. Смахните влево, чтобы удалить."}},"ko":{"stringUnit":{"state":"needs_review","value":"이 태그의 다른 이름입니다. 제거하려면 왼쪽으로 쓸어넘기세요."}},"ja":{"stringUnit":{"state":"needs_review","value":"このタグの別名です。左にスワイプして削除します。"}},"it":{"stringUnit":{"state":"needs_review","value":"Altri nomi per questo tag. Scorri a sinistra per rimuoverne uno."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Outros nomes para esta etiqueta. Deslize para a esquerda para remover um."}},"fr":{"stringUnit":{"state":"needs_review","value":"Autres noms de cette étiquette. Balayez vers la gauche pour en retirer un."}},"es":{"stringUnit":{"state":"needs_review","value":"Otros nombres de esta etiqueta. Desliza a la izquierda para quitar uno."}},"de":{"stringUnit":{"state":"needs_review","value":"Andere Namen für diesen Tag. Nach links wischen, um einen zu entfernen."}},"nb":{"stringUnit":{"state":"needs_review","value":"Andre navn på denne taggen. Sveip til venstre for å fjerne ett."}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu etiketin diğer adları. Birini kaldırmak için sola kaydır."}},"sv":{"stringUnit":{"state":"needs_review","value":"Andra namn på taggen. Svep åt vänster för att ta bort ett."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"此标签的其他名称。向左轻扫可移除。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"此標籤的其他名稱。向左滑動即可移除。"}}}},"hint_payment_is_charged_to_your":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Ödeme Apple Kimliğin'den alınır. Abonelikler, dönem bitmeden en az 24 saat önce iptal edilmezse otomatik olarak yenilenir. App Store ayarlarından istediğin zaman yönet veya iptal et."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"费用将从你的 Apple 账户扣除。除非在当前周期结束前至少 24 小时取消，否则订阅将自动续订。可随时在 App Store 设置中管理或取消。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"款項將從你的 Apple ID 扣款。除非在期間結束前至少 24 小時取消，否則訂閱會自動續訂。你可隨時在 App Store 設定中管理或取消。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Betalingen belastes Apple-ID-en din. Abonnementer fornyes automatisk med mindre de avsluttes minst 24 timer før perioden slutter. Administrer eller avslutt når som helst i App Store-innstillingene."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le paiement est débité sur votre identifiant Apple. Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 heures avant la fin de la période. Gérez-les ou résiliez-les à tout moment dans les réglages de l'App Store."}},"pl":{"stringUnit":{"state":"needs_review","value":"Płatność zostanie pobrana z Twojego Apple ID. Subskrypcje odnawiają się automatycznie, chyba że zostaną anulowane co najmniej 24 godziny przed końcem okresu. Zarządzaj nimi lub anuluj w dowolnym momencie w ustawieniach App Store."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O pagamento é cobrado no seu Apple ID. As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período. Gerencie ou cancele quando quiser nos ajustes da App Store."}},"da":{"stringUnit":{"state":"needs_review","value":"Betalingen trækkes på dit Apple-id. Abonnementer fornyes automatisk, medmindre de opsiges mindst 24 timer før periodens udløb. Administrer eller opsig når som helst i dine App Store-indstillinger."}},"sv":{"stringUnit":{"state":"needs_review","value":"Betalningen debiteras ditt Apple-ID. Prenumerationer förnyas automatiskt om de inte avslutas minst 24 timmar innan perioden slutar. Hantera eller avsluta när som helst i dina App Store-inställningar."}},"es":{"stringUnit":{"state":"needs_review","value":"El pago se carga en tu Apple ID. Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes de que termine el periodo. Gestiónalas o cancélalas cuando quieras en los ajustes del App Store."}},"ja":{"stringUnit":{"state":"needs_review","value":"お支払いはApple IDに請求されます。サブスクリプションは期間終了の24時間以上前に解約しない限り自動更新されます。App Storeの設定でいつでも管理または解約できます。"}},"de":{"stringUnit":{"state":"needs_review","value":"Die Zahlung wird über deine Apple-ID abgerechnet. Abos verlängern sich automatisch, wenn sie nicht mindestens 24 Stunden vor Ablauf des Zeitraums gekündigt werden. Verwalten oder kündigen jederzeit in deinen App-Store-Einstellungen."}},"ar":{"stringUnit":{"state":"needs_review","value":"يُحصَّل المبلغ من Apple ID الخاص بك. تتجدد الاشتراكات تلقائيًا ما لم تُلغَ قبل 24 ساعة على الأقل من نهاية الفترة. يمكنك الإدارة أو الإلغاء في أي وقت من إعدادات App Store."}},"ko":{"stringUnit":{"state":"needs_review","value":"결제 금액은 Apple ID로 청구됩니다. 구독 기간이 끝나기 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다. 언제든지 App Store 설정에서 관리하거나 취소할 수 있습니다."}},"en":{"stringUnit":{"state":"needs_review","value":"Payment is charged to your Apple ID. Subscriptions renew automatically unless cancelled at least 24 hours before the period ends. Manage or cancel anytime in your App Store settings."}},"nl":{"stringUnit":{"state":"needs_review","value":"De betaling wordt in rekening gebracht via je Apple ID. Abonnementen worden automatisch verlengd, tenzij je ze minstens 24 uur voor het einde van de periode opzegt. Beheer of zeg op wanneer je wilt in je App Store-instellingen."}},"it":{"stringUnit":{"state":"needs_review","value":"Il pagamento viene addebitato sul tuo ID Apple. Gli abbonamenti si rinnovano automaticamente se non vengono annullati almeno 24 ore prima della fine del periodo. Gestiscili o annullali quando vuoi nelle impostazioni dell'App Store."}},"ru":{"stringUnit":{"state":"needs_review","value":"Оплата списывается с вашего Apple ID. Подписка продлевается автоматически, если не отменить ее как минимум за 24 часа до конца периода. Управлять подпиской или отменить ее можно в любое время в настройках App Store."}}}},"hint_payment_is_charged_to_your_google":{"localizations":{"nb":{"stringUnit":{"state":"needs_review","value":"Betalingen belastes Google Play-kontoen din. Abonnementer fornyes automatisk med mindre de avsluttes. Administrer eller avslutt når som helst i Play Store."}},"da":{"stringUnit":{"state":"needs_review","value":"Betalingen trækkes på din Google Play-konto. Abonnementer fornyes automatisk, medmindre de opsiges. Administrer eller opsig når som helst i Play Butik."}},"ja":{"stringUnit":{"state":"needs_review","value":"お支払いはGoogle Playアカウントに請求されます。サブスクリプションは解約しない限り自動更新されます。Playストアでいつでも管理または解約できます。"}},"it":{"stringUnit":{"state":"needs_review","value":"Il pagamento viene addebitato sul tuo account Google Play. Gli abbonamenti si rinnovano automaticamente se non vengono annullati. Gestiscili o annullali quando vuoi nel Play Store."}},"nl":{"stringUnit":{"state":"needs_review","value":"De betaling wordt in rekening gebracht via je Google Play-account. Abonnementen worden automatisch verlengd, tenzij je ze opzegt. Beheer of zeg op wanneer je wilt in de Play Store."}},"de":{"stringUnit":{"state":"needs_review","value":"Die Zahlung wird über dein Google-Play-Konto abgerechnet. Abos verlängern sich automatisch, wenn sie nicht gekündigt werden. Verwalten oder kündigen jederzeit im Play Store."}},"pl":{"stringUnit":{"state":"needs_review","value":"Płatność zostanie pobrana z Twojego konta Google Play. Subskrypcje odnawiają się automatycznie, chyba że zostaną anulowane. Zarządzaj nimi lub anuluj w dowolnym momencie w Sklepie Play."}},"en":{"stringUnit":{"state":"needs_review","value":"Payment is charged to your Google Play account. Subscriptions renew automatically unless cancelled. Manage or cancel anytime in the Play Store."}},"es":{"stringUnit":{"state":"needs_review","value":"El pago se carga en tu cuenta de Google Play. Las suscripciones se renuevan automáticamente salvo que se cancelen. Gestiónalas o cancélalas cuando quieras en Play Store."}},"ar":{"stringUnit":{"state":"needs_review","value":"يُحصَّل المبلغ من حساب Google Play الخاص بك. تتجدد الاشتراكات تلقائيًا ما لم تُلغَ. يمكنك الإدارة أو الإلغاء في أي وقت من Play Store."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le paiement est débité sur votre compte Google Play. Les abonnements se renouvellent automatiquement sauf résiliation. Gérez-les ou résiliez-les à tout moment dans le Play Store."}},"sv":{"stringUnit":{"state":"needs_review","value":"Betalningen debiteras ditt Google Play-konto. Prenumerationer förnyas automatiskt om de inte avslutas. Hantera eller avsluta när som helst i Play Butik."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O pagamento é cobrado na sua conta do Google Play. As assinaturas são renovadas automaticamente, a menos que sejam canceladas. Gerencie ou cancele quando quiser na Play Store."}},"ko":{"stringUnit":{"state":"needs_review","value":"결제 금액은 Google Play 계정으로 청구됩니다. 취소하지 않으면 구독이 자동으로 갱신됩니다. 언제든지 Play 스토어에서 관리하거나 취소할 수 있습니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Оплата списывается с вашего аккаунта Google Play. Подписка продлевается автоматически, пока ее не отменят. Управлять подпиской или отменить ее можно в любое время в Play Store."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"款項將從你的 Google Play 帳戶扣款。除非取消，否則訂閱會自動續訂。你可隨時在 Play 商店中管理或取消。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ödeme Google Play hesabından alınır. Abonelikler iptal edilmezse otomatik olarak yenilenir. Play Store'da istediğin zaman yönet veya iptal et."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"费用将从你的 Google Play 帐户扣除。除非取消，否则订阅将自动续订。可随时在 Play 商店中管理或取消。"}}}},"hint_pick_accent_color_used_for":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Uygulama genelinde odak vurguları ve simgeler için kullanılan vurgu rengini seç."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择用于整个 App 中焦点高亮和图标的强调色。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Välj accentfärgen för fokusmarkeringar och symboler i hela appen."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇整個 App 中焦點醒目提示和圖像所使用的強調色。"}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle die Akzentfarbe für Fokus-Hervorhebungen und Symbole in der ganzen App."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli il colore di accento usato per l'evidenziazione del focus e le icone in tutta l'app."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige el color de acento que se usa para resaltar el foco y los iconos en toda la app."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies de accentkleur voor focusmarkeringen en symbolen in de hele app."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez la couleur d'accentuation utilisée pour la mise en évidence et les icônes dans toute l'app."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz kolor akcentu używany do podświetleń fokusu i ikon w całej aplikacji."}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg aksentfargen som brukes for fokusmarkering og ikoner i hele appen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha a cor de destaque usada nos destaques de foco e ícones em todo o app."}},"ja":{"stringUnit":{"state":"needs_review","value":"アプリ全体のフォーカスのハイライトとアイコンに使うアクセントカラーを選択します。"}},"ar":{"stringUnit":{"state":"needs_review","value":"اختر لون التمييز المستخدم لإبراز التركيز والأيقونات في جميع أنحاء التطبيق."}},"ko":{"stringUnit":{"state":"needs_review","value":"앱 전체에서 포커스 강조 표시와 아이콘에 사용할 강조 색상을 선택하세요."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите цвет акцента для выделения фокуса и значков во всем приложении."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg den accentfarve, der bruges til fokusmarkeringer og ikoner i hele appen."}},"en":{"stringUnit":{"state":"needs_review","value":"Pick the accent color used for focus highlights and icons throughout the app."}}}},"hint_pick_app_theme_and_accent":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"アプリのテーマと、アプリ全体のフォーカスのハイライトとアイコンに使うアクセントカラーを選択します。"}},"en":{"stringUnit":{"state":"needs_review","value":"Pick the app theme and the accent color used for focus highlights and icons throughout the app."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies het thema van de app en de accentkleur voor focusmarkeringen en symbolen in de hele app."}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle das App-Design und die Akzentfarbe für Fokus-Hervorhebungen und Symbole in der ganzen App."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha o tema do app e a cor de destaque usada nos destaques de foco e ícones em todo o app."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg apptemaet og den accentfarve, der bruges til fokusmarkeringer og ikoner i hele appen."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите тему приложения и цвет акцента для выделения фокуса и значков во всем приложении."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli il tema dell'app e il colore di accento usato per l'evidenziazione del focus e le icone in tutta l'app."}},"ko":{"stringUnit":{"state":"needs_review","value":"앱 테마와 앱 전체에서 포커스 강조 표시와 아이콘에 사용할 강조 색상을 선택하세요."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez le thème de l'app et la couleur d'accentuation utilisée pour la mise en évidence et les icônes dans toute l'app."}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg apptemaet og aksentfargen som brukes for fokusmarkering og ikoner i hele appen."}},"ar":{"stringUnit":{"state":"needs_review","value":"اختر سمة التطبيق ولون التمييز المستخدم لإبراز التركيز والأيقونات في جميع أنحاء التطبيق."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige el tema de la app y el color de acento que se usa para resaltar el foco y los iconos en toda la app."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz motyw aplikacji i kolor akcentu używany do podświetleń fokusu i ikon w całej aplikacji."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择 App 主题以及用于整个 App 中焦点高亮和图标的强调色。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Uygulama temasını ve uygulama genelinde odak vurguları ve simgeler için kullanılan vurgu rengini seç."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇 App 主題，以及整個 App 中焦點醒目提示和圖像所使用的強調色。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Välj apptema och accentfärgen för fokusmarkeringar och symboler i hela appen."}}}},"hint_picked_on_this_device_from":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Utvalt på den här enheten utifrån dina uppspelningar, O-räknare och betyg."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"根据你的播放、O 计数和评分在此设备上挑选。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"依據你的播放、O 計數和評分，在此裝置上挑選。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Oynatmalarından, O Sayılarından ve puanlarından bu aygıtta seçildi."}},"en":{"stringUnit":{"state":"needs_review","value":"Picked on this device from your plays, O Counts and ratings."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolhidas neste dispositivo a partir das suas reproduções, contagens O e avaliações."}},"es":{"stringUnit":{"state":"needs_review","value":"Seleccionado en este dispositivo a partir de tus reproducciones, contadores O y valoraciones."}},"nb":{"stringUnit":{"state":"needs_review","value":"Valgt på denne enheten ut fra avspillinger, O-tellere og vurderinger."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierane na tym urządzeniu na podstawie Twoich odtworzeń, liczników O i ocen."}},"de":{"stringUnit":{"state":"needs_review","value":"Auf diesem Gerät aus deinen Wiedergaben, O-Zählern und Bewertungen ausgewählt."}},"ko":{"stringUnit":{"state":"needs_review","value":"재생, O 카운트 및 별점을 바탕으로 이 기기에서 선택했습니다."}},"it":{"stringUnit":{"state":"needs_review","value":"Scelte su questo dispositivo in base a riproduzioni, contatori O e valutazioni."}},"nl":{"stringUnit":{"state":"needs_review","value":"Op dit apparaat gekozen uit je weergaven, O-tellers en beoordelingen."}},"ar":{"stringUnit":{"state":"needs_review","value":"مختارة على هذا الجهاز بناءً على مرات تشغيلك وعدّادات O والتقييمات."}},"fr":{"stringUnit":{"state":"needs_review","value":"Sélectionnées sur cet appareil à partir de vos lectures, compteurs O et notes."}},"da":{"stringUnit":{"state":"needs_review","value":"Udvalgt på denne enhed ud fra dine afspilninger, O-tællere og bedømmelser."}},"ru":{"stringUnit":{"state":"needs_review","value":"Подобрано на этом устройстве по вашим воспроизведениям, O и рейтингам."}},"ja":{"stringUnit":{"state":"needs_review","value":"再生、Oカウント、評価をもとにこのデバイスで選ばれます。"}}}},"hint_pick_performer_to_start_rise":{"localizations":{"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha um artista para iniciar a rodada Rise"}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez un performeur pour lancer la partie Rise"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz aktora, aby rozpocząć rundę Rise"}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies een performer om de Rise-run te starten"}},"en":{"stringUnit":{"state":"needs_review","value":"Pick a performer to start the Rise run"}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg en kunstner for at starte Rise-runden"}},"ja":{"stringUnit":{"state":"needs_review","value":"Riseランを開始する出演者を選択"}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle einen Darsteller, um den Rise-Lauf zu starten"}},"es":{"stringUnit":{"state":"needs_review","value":"Elige un intérprete para empezar la partida de Rise"}},"ko":{"stringUnit":{"state":"needs_review","value":"Rise 진행을 시작할 배우를 선택하세요"}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg en utøver for å starte Rise-runden"}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите исполнителя, чтобы начать забег Rise"}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli un performer per iniziare la partita Rise"}},"ar":{"stringUnit":{"state":"needs_review","value":"اختر مؤديًا لبدء جولة Rise"}},"sv":{"stringUnit":{"state":"needs_review","value":"Välj en stjärna för att starta Rise-omgången"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇一位演員以開始 Rise 回合"}},"tr":{"stringUnit":{"state":"needs_review","value":"Rise turunu başlatmak için bir oyuncu seç"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择一位演员开始 Rise 回合"}}}},"hint_play_count_history_resume_point":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Sunucudaki oynatma sayısı, geçmiş, devam noktası ve izleme süresi. Oynatıcı menüsü bunu bir sahne için duraklatabilir."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"服务器上的播放次数、历史记录、续播位置和观看时长。可通过播放器菜单对单个短片暂停记录。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"伺服器上的播放次數、紀錄、續播位置和觀看時間。播放器選單可針對單一短片暫停記錄。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Antal visningar, historik, återupptagningspunkt och visningstid på servern. Spelarmenyn kan pausa det för en scen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Afspeelaantal, geschiedenis, hervatpunt en kijktijd op de server. Het spelermenu kan dit voor één scène pauzeren."}},"nb":{"stringUnit":{"state":"needs_review","value":"Antall avspillinger, historikk, gjenopptakingspunkt og seertid på serveren. Spillermenyen kan sette det på pause for én scene."}},"ar":{"stringUnit":{"state":"needs_review","value":"عدد مرات التشغيل والسجل ونقطة الاستئناف ووقت المشاهدة على الخادم. يمكن لقائمة المشغّل إيقاف ذلك مؤقتًا لمشهد واحد."}},"ru":{"stringUnit":{"state":"needs_review","value":"Число воспроизведений, история, точка продолжения и время просмотра на сервере. В меню плеера это можно приостановить для одной сцены."}},"ja":{"stringUnit":{"state":"needs_review","value":"再生回数、履歴、再開位置、再生時間をサーバーに記録します。プレーヤーメニューで1つのシーンだけ一時停止できます。"}},"en":{"stringUnit":{"state":"needs_review","value":"Play count, history, resume point and watch time on the server. The player menu can pause it for one scene."}},"fr":{"stringUnit":{"state":"needs_review","value":"Nombre de lectures, historique, point de reprise et durée de visionnage sur le serveur. Le menu du lecteur permet de le suspendre pour une scène."}},"it":{"stringUnit":{"state":"needs_review","value":"Numero di riproduzioni, cronologia, punto di ripresa e tempo di visione sul server. Il menu del player può sospenderli per una scena."}},"de":{"stringUnit":{"state":"needs_review","value":"Wiedergaben, Verlauf, Fortsetzungspunkt und Wiedergabezeit auf dem Server. Im Player-Menü lässt es sich für eine Szene pausieren."}},"pl":{"stringUnit":{"state":"needs_review","value":"Liczba odtworzeń, historia, punkt wznowienia i czas oglądania na serwerze. Menu odtwarzacza może to wstrzymać dla jednej sceny."}},"da":{"stringUnit":{"state":"needs_review","value":"Antal afspilninger, historik, genoptagelsespunkt og afspilningstid på serveren. Afspillermenuen kan sætte det på pause for én scene."}},"es":{"stringUnit":{"state":"needs_review","value":"Número de reproducciones, historial, punto de reanudación y tiempo de reproducción en el servidor. El menú del reproductor puede pausarlo para una escena."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Contagem de reproduções, histórico, ponto de retomada e tempo assistido no servidor. O menu do player pode pausar isso para uma cena."}},"ko":{"stringUnit":{"state":"needs_review","value":"서버의 재생 횟수, 기록, 이어서 재생 위치 및 시청 시간입니다. 플레이어 메뉴에서 영상 하나에 대해 일시 중지할 수 있습니다."}}}},"hint_plays_scenes_back_to_back":{"localizations":{"es":{"stringUnit":{"state":"needs_review","value":"Reproduce escenas una tras otra desde una fila de Inicio: estrenadas recientemente, añadidas recientemente o tus filtros de escenas guardados. Las páginas de intérpretes, estudios, etiquetas y grupos tienen su propio canal."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Reproduz cenas em sequência a partir de uma linha do Início: lançadas recentemente, adicionadas recentemente ou seus filtros salvos de cenas. Páginas de artistas, estúdios, etiquetas e grupos têm seu próprio canal."}},"en":{"stringUnit":{"state":"needs_review","value":"Plays scenes back to back from a row on Home: recently released, recently added or your saved scene filters. Performer, studio, tag and group pages get their own channel."}},"ja":{"stringUnit":{"state":"needs_review","value":"ホームの行からシーンを連続再生します：最近リリース、最近追加、または保存済みシーンフィルター。出演者、スタジオ、タグ、グループのページにはそれぞれ専用のチャンネルがあります。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Speelt scènes achter elkaar af uit een rij op Home: recent uitgebracht, recent toegevoegd of je bewaarde scènefilters. Pagina's van performers, studio's, labels en groepen krijgen hun eigen kanaal."}},"sv":{"stringUnit":{"state":"needs_review","value":"Spelar scener i följd från en rad på Hem: nyligen släppta, nyligen tillagda eller dina sparade scenfilter. Sidor för stjärnor, studior, taggar och grupper får en egen kanal."}},"nb":{"stringUnit":{"state":"needs_review","value":"Spiller scener etter hverandre fra en rad på Hjem: nylig utgitt, nylig lagt til eller de lagrede scenefiltrene dine. Utøver-, studio-, tagg- og gruppesider får sin egen kanal."}},"da":{"stringUnit":{"state":"needs_review","value":"Afspiller scener efter hinanden fra en række på Hjem: senest udgivet, senest tilføjet eller dine gemte scenefiltre. Sider for kunstnere, studier, tags og grupper får deres egen kanal."}},"pl":{"stringUnit":{"state":"needs_review","value":"Odtwarza sceny jedna po drugiej z wiersza ekranu Start: ostatnio wydane, ostatnio dodane lub Twoje zapisane filtry scen. Strony aktorów, studiów, tagów i grup mają własny kanał."}},"fr":{"stringUnit":{"state":"needs_review","value":"Lit les scènes à la suite depuis une rangée de l'accueil : sorties récentes, ajouts récents ou vos filtres de scènes enregistrés. Les pages de performeur, studio, étiquette et groupe ont leur propre chaîne."}},"ko":{"stringUnit":{"state":"needs_review","value":"홈의 행(최근 공개, 최근 추가 또는 저장된 영상 필터)에서 영상을 연속으로 재생합니다. 배우, 스튜디오, 태그 및 그룹 페이지에는 자체 채널이 있습니다."}},"ar":{"stringUnit":{"state":"needs_review","value":"يشغّل المشاهد متتالية من صف في الرئيسية: الصادرة حديثًا أو المضافة حديثًا أو فلاتر المشاهد المحفوظة. تحصل صفحات المؤدين والاستوديوهات والوسوم والمجموعات على قناتها الخاصة."}},"it":{"stringUnit":{"state":"needs_review","value":"Riproduce scene una dopo l'altra da una riga della Home: uscite di recente, aggiunte di recente o i tuoi filtri scene salvati. Le pagine di performer, studi, tag e gruppi hanno il loro canale."}},"ru":{"stringUnit":{"state":"needs_review","value":"Воспроизводит подряд сцены из ряда главной: недавно вышедшие, недавно добавленные или ваши сохраненные фильтры сцен. У страниц исполнителей, студий, тегов и групп — свой канал."}},"de":{"stringUnit":{"state":"needs_review","value":"Spielt Szenen nacheinander aus einer Zeile auf Start: kürzlich erschienen, kürzlich hinzugefügt oder deine gespeicherten Szenenfilter. Darsteller-, Studio-, Tag- und Gruppenseiten haben einen eigenen Kanal."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"從首頁的某一列連續播放短片：最近發行、最近加入或你已儲存的短片篩選條件。演員、工作室、標籤和群組頁面也有各自的頻道。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ana Sayfa'daki bir satırdan sahneleri art arda oynatır: son çıkanlar, son eklenenler veya kayıtlı sahne filtrelerin. Oyuncu, stüdyo, etiket ve grup sayfalarının kendi kanalı olur."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"连续播放主页某一行中的短片：最近发行、最近添加或你的已存短片过滤器。演员、工作室、标签和集合页面有各自的频道。"}}}},"hint_please_configure_your_stash_server":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Konfigurera din Stash-server för att komma igång."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請設定你的 Stash 伺服器以開始使用。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请配置你的 Stash 服务器以开始使用。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Başlamak için Stash sunucunu yapılandır."}},"pl":{"stringUnit":{"state":"needs_review","value":"Skonfiguruj serwer Stash, aby rozpocząć."}},"da":{"stringUnit":{"state":"needs_review","value":"Konfigurer din Stash-server for at komme i gang."}},"nb":{"stringUnit":{"state":"needs_review","value":"Konfigurer Stash-serveren din for å komme i gang."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Configure seu servidor Stash para começar."}},"en":{"stringUnit":{"state":"needs_review","value":"Please configure your Stash server to get started."}},"ar":{"stringUnit":{"state":"needs_review","value":"يُرجى تكوين خادم Stash للبدء."}},"ko":{"stringUnit":{"state":"needs_review","value":"시작하려면 Stash 서버를 구성하세요."}},"ja":{"stringUnit":{"state":"needs_review","value":"始めるにはStashサーバーを設定してください。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Для начала настройте сервер Stash."}},"nl":{"stringUnit":{"state":"needs_review","value":"Stel je Stash-server in om te beginnen."}},"de":{"stringUnit":{"state":"needs_review","value":"Richte deinen Stash-Server ein, um loszulegen."}},"it":{"stringUnit":{"state":"needs_review","value":"Configura il tuo server Stash per iniziare."}},"fr":{"stringUnit":{"state":"needs_review","value":"Configurez votre serveur Stash pour commencer."}},"es":{"stringUnit":{"state":"needs_review","value":"Configura tu servidor Stash para empezar."}}}},"hint_please_enable_dashboard_performers_studios":{"localizations":{"nb":{"stringUnit":{"state":"needs_review","value":"Slå på Dashboard, Utøvere, Studioer, Tagger, Grupper eller Markører i Innstillinger"}},"pl":{"stringUnit":{"state":"needs_review","value":"Włącz w Ustawieniach Dashboard, Aktorów, Studia, Tagi, Grupy lub Znaczniki"}},"ru":{"stringUnit":{"state":"needs_review","value":"Включите в настройках Dashboard, исполнителей, студии, теги, группы или маркеры"}},"es":{"stringUnit":{"state":"needs_review","value":"Activa Dashboard, Intérpretes, Estudios, Etiquetas, Grupos o Marcadores en Ajustes"}},"ja":{"stringUnit":{"state":"needs_review","value":"設定でDashboard、出演者、スタジオ、タグ、グループ、マーカーのいずれかを有効にしてください"}},"en":{"stringUnit":{"state":"needs_review","value":"Please enable Dashboard, Performers, Studios, Tags, Groups or Markers in Settings"}},"fr":{"stringUnit":{"state":"needs_review","value":"Activez Dashboard, Performeurs, Studios, Étiquettes, Groupes ou Marqueurs dans les réglages"}},"ar":{"stringUnit":{"state":"needs_review","value":"يُرجى تفعيل Dashboard أو المؤدين أو الاستوديوهات أو الوسوم أو المجموعات أو العلامات في الإعدادات"}},"de":{"stringUnit":{"state":"needs_review","value":"Aktiviere Dashboard, Darsteller, Studios, Tags, Gruppen oder Marker in den Einstellungen"}},"da":{"stringUnit":{"state":"needs_review","value":"Slå Dashboard, Kunstnere, Studier, Tags, Grupper eller Markører til i Indstillinger"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ative Dashboard, Artistas, Estúdios, Etiquetas, Grupos ou Marcadores em Ajustes"}},"sv":{"stringUnit":{"state":"needs_review","value":"Aktivera Dashboard, St