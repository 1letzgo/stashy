zations":{"it":{"stringUnit":{"state":"needs_review","value":"Tutte le %@ O registrate e le loro date vengono eliminate definitivamente dal server. Questa azione non può essere annullata."}},"es":{"stringUnit":{"state":"needs_review","value":"Se eliminarán definitivamente del servidor las %@ entradas de O registradas y sus fechas. Esta acción no se puede deshacer."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wszystkie zapisane wpisy O (%@) wraz z datami zostaną trwale usunięte z serwera. Tej operacji nie można cofnąć."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Todos os %@ registros de O e suas datas serão apagados permanentemente no servidor. Não é possível desfazer."}},"de":{"stringUnit":{"state":"needs_review","value":"Alle %@ erfassten O-Einträge und ihre Daten werden auf dem Server endgültig gelöscht. Das kann nicht rückgängig gemacht werden."}},"nb":{"stringUnit":{"state":"needs_review","value":"Alle %@ registrerte O-oppføringer og datoene deres slettes permanent på serveren. Dette kan ikke angres."}},"sv":{"stringUnit":{"state":"needs_review","value":"Alla %@ registrerade O-poster och deras datum raderas permanent på servern. Det går inte att ångra."}},"ru":{"stringUnit":{"state":"needs_review","value":"Все записанные O (%@) и их даты будут безвозвратно удалены на сервере. Это действие нельзя отменить."}},"ko":{"stringUnit":{"state":"needs_review","value":"기록된 O 항목 %@개와 해당 날짜가 서버에서 영구적으로 삭제됩니다. 이 작업은 실행 취소할 수 없습니다."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les %@ entrées O enregistrées et leurs dates seront définitivement supprimées du serveur. Cette action est irréversible."}},"ja":{"stringUnit":{"state":"needs_review","value":"記録された%@件のOとその日付がすべてサーバーから完全に削除されます。この操作は取り消せません。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Alle %@ geregistreerde O-items en hun datums worden definitief verwijderd op de server. Dit kan niet ongedaan worden gemaakt."}},"en":{"stringUnit":{"state":"needs_review","value":"All %@ recorded O entries and their dates are permanently deleted on the server. This cannot be undone."}},"da":{"stringUnit":{"state":"needs_review","value":"Alle %@ registrerede O-poster og deres datoer slettes permanent på serveren. Det kan ikke fortrydes."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"全部 %@ 条已记录的 O 及其日期将从服务器上永久删除。此操作无法撤销。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"全部 %@ 筆已記錄的 O 項目及其日期將從伺服器永久刪除。此動作無法還原。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kayıtlı %@ O girişinin tümü ve tarihleri sunucudan kalıcı olarak silinir. Bu işlem geri alınamaz."}}}},"hint_all_conditions_below_must_be":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Aşağıdaki tüm koşullar sağlanmalı."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"須符合下方所有條件。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"必须满足下方所有条件。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Должны выполняться все условия ниже."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wszystkie poniższe warunki muszą być spełnione."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Todas as condições abaixo devem ser verdadeiras."}},"de":{"stringUnit":{"state":"needs_review","value":"Alle Bedingungen unten müssen zutreffen."}},"nb":{"stringUnit":{"state":"needs_review","value":"Alle betingelsene nedenfor må være oppfylt."}},"nl":{"stringUnit":{"state":"needs_review","value":"Aan alle voorwaarden hieronder moet worden voldaan."}},"ko":{"stringUnit":{"state":"needs_review","value":"아래의 모든 조건을 충족해야 합니다."}},"ja":{"stringUnit":{"state":"needs_review","value":"以下のすべての条件を満たす必要があります。"}},"es":{"stringUnit":{"state":"needs_review","value":"Deben cumplirse todas las condiciones de abajo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Toutes les conditions ci-dessous doivent être remplies."}},"en":{"stringUnit":{"state":"needs_review","value":"All conditions below must be true."}},"sv":{"stringUnit":{"state":"needs_review","value":