ate":"needs_review","value":"Turn Off and Remove from iCloud"}},"ru":{"stringUnit":{"state":"needs_review","value":"Выключить и удалить из iCloud"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"關閉並從 iCloud 移除"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"关闭并从 iCloud 中移除"}},"sv":{"stringUnit":{"state":"needs_review","value":"Stäng av och ta bort från iCloud"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kapat ve iCloud'dan Kaldır"}}}},"hint_turn_off_if_dolby_vision":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Stäng av om en Dolby Vision-scen visar gröna eller lila färger. Den spelas då som HDR10, som din TV fortfarande visar i HDR."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"若 Dolby Vision 短片出現綠色或紫色色彩，請關閉此選項。短片會改以 HDR10 播放，你的電視仍會以 HDR 顯示。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"如果 Dolby Vision 短片显示绿色或紫色，请关闭此项。之后它将以 HDR10 播放，你的电视仍会以 HDR 显示。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bir Dolby Vision sahnesi yeşil veya mor renkler gösteriyorsa kapat. Sahne o zaman HDR10 olarak oynatılır; TV'n bunu yine HDR olarak gösterir."}},"en":{"stringUnit":{"state":"needs_review","value":"Turn off if a Dolby Vision scene shows green or purple colors. It then plays as HDR10, which your TV still shows in HDR."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wyłącz, jeśli scena Dolby Vision ma zielone lub fioletowe kolory. Będzie wtedy odtwarzana jako HDR10, który telewizor nadal pokazuje w HDR."}},"de":{"stringUnit":{"state":"needs_review","value":"Schalte es aus, wenn eine Dolby-Vision-Szene grüne oder violette Farben zeigt. Sie läuft dann als HDR10, das dein TV weiterhin in HDR zeigt."}},"es":{"stringUnit":{"state":"needs_review","value":"Desactívalo si una escena Dolby Vision muestra colores verdes o morados. Entonces se reproduce como HDR10, que tu televisor sigue mostrando en HDR."}},"ja":{"stringUnit":{"state":"needs_review","value":"Dolby Visionのシーンが緑や紫に表示される場合はオフにしてください。その場合HDR10で再生され、テレビでは引き続きHDRで表示されます。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Выключите, если сцена Dolby Vision отображается с зелеными или фиолетовыми оттенками. Тогда она воспроизводится как HDR10, и телевизор по-прежнему показывает ее в HDR."}},"ko":{"stringUnit":{"state":"needs_review","value":"Dolby Vision 영상에 녹색이나 보라색이 나타나면 끄세요. 그러면 HDR10으로 재생되며 TV에서는 여전히 HDR로 표시됩니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Slå av hvis en Dolby Vision-scene viser grønne eller lilla farger. Den spilles da av som HDR10, som TV-en fortsatt viser i HDR."}},"nl":{"stringUnit":{"state":"needs_review","value":"Schakel uit als een Dolby Vision-scène groene of paarse kleuren toont. Hij speelt dan af als HDR10, wat je tv nog steeds in HDR toont."}},"da":{"stringUnit":{"state":"needs_review","value":"Slå fra, hvis en Dolby Vision-scene viser grønne eller lilla farver. Den afspilles så som HDR10, som dit tv stadig viser i HDR."}},"fr":{"stringUnit":{"state":"needs_review","value":"Désactivez si une scène Dolby Vision affiche des couleurs vertes ou violettes. Elle est alors lue en HDR10, que votre téléviseur affiche toujours en HDR."}},"it":{"stringUnit":{"state":"needs_review","value":"Disattiva se una scena Dolby Vision mostra colori verdi o viola. Verrà riprodotta come HDR10, che la TV mostra comunque in HDR."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Desative se uma cena Dolby Vision mostrar cores verdes ou roxas. Ela passa a ser reproduzida como HDR10, que sua TV ainda mostra em HDR."}}}},"hint_turn_on_tag_suggestions_or":{"localizations":{"es":{"stringUnit":{"state":"needs_review","value":"Activa Sugerencias de etiquetas o Escenas similares para mostrar Para ti en Inicio."}},"de":{"stringUnit":{"state":"needs_review","value":"Schalte Tag-Vorschläge oder Ähnliche Szenen ein, um Für dich auf Start zu zeigen."}},"it":{"stringUnit":{"state":"needs_review","value":"Attiva Suggerimenti tag o Scene simili per mostrare Per te nella Home."}},"pl":{"stringUnit":{"state":"needs_review","value":"Włącz sugestie tagów lub podobne sceny, aby pokazać Dla Ciebie na ekranie Start."}},"ru":{"stringUnit":{"state":"needs_review","value":"Включите «Предложения тегов» или «Похожие сцены», чтобы показать «Для вас» на главной."}},"fr":{"stringUnit":{"state":"needs_review","value":"Activez Suggestions d'étiquettes ou Scènes similaires pour afficher Pour vous sur l'accueil."}},"en":{"stringUnit":{"state":"needs_review","value":"Turn on Tag suggestions or Similar scenes to show For You on Home."}},"da":{"stringUnit":{"state":"needs_review","value":"Slå Tagforslag eller Lignende scener til for at vise Til dig på Hjem."}},"ja":{"stringUnit":{"state":"needs_review","value":"ホームにおすすめを表示するには、タグの提案または類似シーンをオンにしてください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"홈에 맞춤 추천을 표시하려면 태그 제안 또는 유사한 영상을 켜세요."}},"nl":{"stringUnit":{"state":"needs_review","value":"Schakel Labelsuggesties of Vergelijkbare scènes in om 'Voor jou' op Home te tonen."}},"nb":{"stringUnit":{"state":"needs_review","value":"Slå på Taggforslag eller Lignende scener for å vise For deg på Hjem."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ative Sugestões de etiquetas ou Cenas semelhantes para mostrar Para você no Início."}},"sv":{"stringUnit":{"state":"needs_review","value":"Slå på Taggförslag eller Liknande scener för att visa För dig på Hem."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"開啟「標籤建議」或「相似短片」，以在首頁顯示「為你推薦」。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ana Sayfa'da Sana Özel'i göstermek için Etiket önerileri veya Benzer sahneler'i aç."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"打开“标签建议”或“相似短片”以在主页显示“为你推荐”。"}}}},"hint_turn_on_tag_suggestions_or_similar":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Ana Sayfa'da Unutulan Favoriler'i göstermek için Etiket önerileri veya Benzer sahneler'i aç."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"打开“标签建议”或“相似短片”以在主页显示“被遗