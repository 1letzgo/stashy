te":"needs_review","value":"Oculto nunca o mostra. Acima de 1× também traz novas cenas."}},"nb":{"stringUnit":{"state":"needs_review","value":"Skjult viser den aldri. Over 1× gir også nye scener."}},"es":{"stringUnit":{"state":"needs_review","value":"Oculto no lo muestra nunca. Por encima de 1× también trae escenas nuevas."}},"fr":{"stringUnit":{"state":"needs_review","value":"Masqué ne l'affiche jamais. Au-delà de 1×, de nouvelles scènes sont aussi proposées."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"「已隱藏」表示永不顯示。高於 1× 時也會帶來新短片。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Gizli, onu hiç göstermez. 1× üzeri yeni sahneler de getirir."}},"sv":{"stringUnit":{"state":"needs_review","value":"Dold visar det aldrig. Över 1× ger också nya scener."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"“隐藏”表示永不显示。高于 1× 还会带来新的短片。"}}}},"hint_hidden_never_shows_it_above_1":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Dold visar det aldrig. Över 1× ger också nya scener. Svep för att ta bort."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"“隐藏”表示永不显示。高于 1× 还会带来新的短片。轻扫以移除。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Gizli, onu hiç göstermez. 1× üzeri yeni sahneler de getirir. Kaldırmak için kaydır."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"「已隱藏」表示永不顯示。高於 1× 時也會帶來新短片。滑動即可移除。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Oculto nunca o mostra. Acima de 1× também traz novas cenas. Deslize para remover."}},"it":{"stringUnit":{"state":"needs_review","value":"Nascosto non lo mostra mai. Sopra 1× porta anche nuove scene. Scorri per rimuovere."}},"fr":{"stringUnit":{"state":"needs_review","value":"Masqué ne l'affiche jamais. Au-delà de 1×, de nouvelles scènes sont aussi proposées. Balayez pour retirer."}},"en":{"stringUnit":{"state":"needs_review","value":"Hidden never shows it. Above 1× also brings new scenes. Swipe to remove."}},"nl":{"stringUnit":{"state":"needs_review","value":"Verborgen toont het nooit. Boven 1× komen er ook nieuwe scènes. Veeg om te verwijderen."}},"ru":{"stringUnit":{"state":"needs_review","value":"«Скрыто» — никогда не показывать. Выше 1× — также приносит новые сцены. Смахните, чтобы удалить."}},"de":{"stringUnit":{"state":"needs_review","value":"Ausgeblendet zeigt es nie. Über 1× bringt auch neue Szenen. Zum Entfernen wischen."}},"nb":{"stringUnit":{"state":"needs_review","value":"Skjult viser den aldri. Over 1× gir også nye scener. Sveip for å fjerne."}},"ko":{"stringUnit":{"state":"needs_review","value":"가려짐으로 설정하면 표시되지 않습니다. 1×보다 높으면 새로운 영상도 가져옵니다. 쓸어넘겨 제거하세요."}},"ja":{"stringUnit":{"state":"needs_review","value":"「非表示」にすると表示されません。1×より上にすると新しいシーンも表示されます。スワイプで削除。"}},"da":{"stringUnit":{"state":"needs_review","value":"Skjult viser det aldrig. Over 1× giver også nye scener. Stryg for at fjerne."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ukryte nigdy się nie pojawia. Powyżej 1× przynosi też nowe sceny. Przesuń, aby usunąć."}},"es":{"stringUnit":{"state":"needs_review","value":"Oculto no lo muestra nunca. Por encima de 1× también trae escenas nuevas. Desliza para quitar."}}}},"hint_hide_sections_you_do_not":{"localizations":{"nb":{"stringUnit":{"state":"needs_review","value":"Skjul deler du ikke bruker. De forsvinner fra sidepanelet."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ukryj nieużywane sekcje. Znikną z paska bocznego."}},"ja":{"stringUnit":{"state":"needs_review","value":"使わないセクションを非表示にします。サイドバーから消えます。"}},"da":{"stringUnit":{"state":"needs_review","value":"Skjul sektioner, du ikke bruger. De forsvinder fra sidepanelet."}},"nl":{"stringUnit":{"state":"needs_review","value":"Verberg onderdelen die je niet gebruikt. Ze verdwijnen uit de navigatiekolom."}},"ru":{"stringUnit":{"state":"needs_review","value":"Скройте неиспользуемые разделы. Они исчезнут с боковой панели."}},"de":{"stringUnit":{"state":"needs_review","value":"Blende Bereiche aus, die du nicht nutzt. Sie verschwinden aus der Sei