니다"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybiera, który tryb Feed pokazać"}},"es":{"stringUnit":{"state":"needs_review","value":"Elige qué modo de feed mostrar"}},"en":{"stringUnit":{"state":"translated","value":"Chooses which feed mode to show"}}}},"hint_chooses_which_settings_section_to":{"localizations":{"nl":{"stringUnit":{"state":"needs_review","value":"Kiest welk instellingenonderdeel wordt getoond"}},"nb":{"stringUnit":{"state":"needs_review","value":"Velger hvilken innstillingsdel som vises"}},"it":{"stringUnit":{"state":"needs_review","value":"Sceglie quale sezione delle impostazioni mostrare"}},"ru":{"stringUnit":{"state":"needs_review","value":"Выбор раздела настроек"}},"ja":{"stringUnit":{"state":"needs_review","value":"表示する設定セクションを選択します"}},"en":{"stringUnit":{"state":"translated","value":"Chooses which settings section to show"}},"de":{"stringUnit":{"state":"needs_review","value":"Wählt, welcher Einstellungsbereich angezeigt wird"}},"da":{"stringUnit":{"state":"needs_review","value":"Vælger, hvilken indstillingssektion der vises"}},"ko":{"stringUnit":{"state":"needs_review","value":"표시할 설정 섹션을 선택합니다"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolhe qual seção de ajustes mostrar"}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisit la section de réglages à afficher"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybiera, którą sekcję ustawień pokazać"}},"es":{"stringUnit":{"state":"needs_review","value":"Elige qué sección de ajustes mostrar"}},"tr":{"stringUnit":{"state":"needs_review","value":"Gösterilecek ayarlar bölümünü seçer"}},"sv":{"stringUnit":{"state":"needs_review","value":"Väljer vilken inställningssektion som visas"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择要显示的设置版块"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇要顯示的設定區段"}}}},"hint_clear_cached_artwork_for_active":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"清除使用中伺服器的快取插圖。圖片會在再次顯示時