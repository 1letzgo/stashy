: %@"}},"ja":{"stringUnit":{"state":"needs_review","value":"動画プレーヤーを起動できませんでした：%@"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie można uruchomić odtwarzacza wideo: %@"}},"es":{"stringUnit":{"state":"needs_review","value":"No se pudo iniciar el reproductor de video: %@"}},"da":{"stringUnit":{"state":"needs_review","value":"Videoafspilleren kunne ikke startes: %@"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Não foi possível iniciar o player de vídeo: %@"}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось запустить видеоплеер: %@"}},"fr":{"stringUnit":{"state":"needs_review","value":"Impossible de démarrer le lecteur vidéo : %@"}},"nb":{"stringUnit":{"state":"needs_review","value":"Videospilleren kunne ikke startes: %@"}},"de":{"stringUnit":{"state":"needs_review","value":"Der Videoplayer konnte nicht gestartet werden: %@"}},"sv":{"stringUnit":{"state":"needs_review","value":"Videospelaren kunde inte startas: %@"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無法啟動影片播放器：%@"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无法启动视频播放器：%@"}},"tr":{"stringUnit":{"state":"needs_review","value":"Video oynatıcı başlatılamadı: %@"}}}},"hint_watch_few_scenes_and_stashy":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"觀看幾部短片後，stashy 會在這裡推薦類似的內容。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"观看几个短片，stashy 就会在这里推荐更多类似的内容。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Birkaç sahne izle, stashy burada onlara benzer sahneler önersin."}},"it":{"stringUnit":{"state":"needs_review","value":"Guarda qualche scena e stashy te ne suggerirà altre simili qui."}},"ja":{"stringUnit":{"state":"needs_review","value":"いくつかシーンを視聴すると、stashyが似たシーンをここに提案します。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Titta på några scener så föreslår stashy fler liknande här."}},"nb":{"stringUnit":{"state":"needs_review","value":"Se noen scener, så foreslår stashy flere lignende her."}},"de":{"stringUnit":{"state":"needs_review","value":"Schau ein paar Szenen, dann schlägt stashy hier ähnliche vor."}},"pl":{"stringUnit":{"state":"needs_review","value":"Obejrzyj kilka scen, a stashy zaproponuje tutaj więcej podobnych."}},"en":{"stringUnit":{"state":"translated","value":"Watch a few scenes and stashy will suggest more like them here."}},"es":{"stringUnit":{"state":"needs_review","value":"Mira algunas escenas y stashy te sugerirá aquí otras parecidas."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Assista a algumas cenas e o stashy sugerirá outras parecidas aqui."}},"fr":{"stringUnit":{"state":"needs_review","value":"Regardez quelques scènes et stashy vous en suggérera d'autres du même genre ici."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посмотрите несколько сцен, и stashy предложит здесь похожие."}},"nl":{"stringUnit":{"state":"needs_review","value":"Bekijk een paar scènes en stashy stelt hier vergelijkbare voor."}},"da":{"stringUnit":{"state":"needs_review","value":"Se et par scener, så foreslår stashy flere lignende her."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상을 몇 개 시청하면 stashy가 비슷한 영상을 여기에 제안합니다."}}}},"hint_were_checking_if_your_server":{"localizations":{"ko":{"stringUnit":{"state":"needs_review","value":"서버에 연결할 수 있는지 확인하는 중입니다"}},"ru":{"stringUnit":{"state":"needs_review","value":"Проверяем доступность вашего сервера"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Estamos verificando se seu servidor está acessível"}},"sv":{"stringUnit":{"state":"needs_review","value":"Vi kontrollerar om din server kan nås"}},"it":{"stringUnit":{"state":"needs_review","value":"Stiamo verificando se il tuo server è raggiungibile"}},"nb":{"stringUnit":{"state":"needs_review","value":"Vi sjekker om serveren din kan nås"}},"es":{"stringUnit":{"state":"needs_review","value":"Estamos comprobando si se puede acceder a tu servidor"}},"da":{"stringUnit":{"state":"needs_review","value":"Vi tjekker, om din server kan nås"}},"nl":{"stringUnit":{"state":"needs_review","value":"We controleren of je server bereikbaar is"}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバーに接続できるか確認しています"}},"pl":{"stringUnit":{"state":"needs_review","value":"Sprawdzamy, czy serwer jest osiągalny"}},"de":{"stringUnit":{"state":"needs_review","value":"Wir prüfen, ob dein Server erreichbar ist"}},"en":{"stringUnit":{"state":"translated","value":"We're checking if your server is reachable"}},"fr":{"stringUnit":{"state":"needs_review","value":"Nous vérifions si votre serveur est joignable"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"我们正在检查你的服务器是否可访问"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sunucuna ulaşılıp ulaşılamadığını denetliyoruz"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"正在檢查是否能連上你的伺服器"}}}},"hint_with_api_keys_file_gives":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Med API-nycklar ger filen full åtkomst till dina servrar. Håll den privat."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"包含 API 密钥时，此文件可完全访问你的服务器。请妥善保管。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"包含 API 金鑰時，此檔案可完整存取你的伺服器。請妥善保管。"}},"tr":{"stringUnit":{"state":"needs_review","value":"API anahtarlarıyla birlikte dosya sunucularına tam erişim verir. Gizli tut."}},"nb":{"stringUnit":{"state":"needs_review","value":"Med API-nøkler gir filen full tilgang til serverne dine. Hold den privat."}},"es":{"stringUnit":{"state":"needs_review","value":"Con las claves de API, el archivo da acceso completo a tus servidores. Mantenlo en privado."}},"nl":{"stringUnit":{"state":"needs_review","value":"Met API-sleutels geeft het bestand volledige toegang tot je servers. Houd het privé."}},"ko":{"stringUnit":{"state":"needs_review","value":"API 키가 포함된 파일은 서버에 대한 전체 접근 권한을 부여합니다. 비공개로 보관하세요."}},"ja":{"stringUnit":{"state":"needs_review","value":"APIキーを含むファイルは、サーバーへのフルアクセスを与えます。他人と共有しないでください。"}},"da":{"stringUnit":{"state":"needs_review","value":"Med API-nøgler giver filen fuld adgang til dine servere. Hold den privat."}},"ru":{"stringUnit":{"state":"needs_review","value":"С ключами API файл дает полный доступ к вашим серверам. Не передавайте его другим."}},"de":{"stringUnit":{"state":"needs_review","value":"Mit API-Schlüsseln gibt die Datei vollen Zugriff auf deine Server. Halte sie privat."}},"en":{"stringUnit":{"state":"translated","value":"With API keys the file gives full access to your servers. Keep it private."}},"it":{"stringUnit":{"state":"needs_review","value":"Con le chiavi API il file dà accesso completo ai tuoi server. Tienilo privato."}},"fr":{"stringUnit":{"state":"needs_review","value":"Avec les clés API, le fichier donne un accès complet à vos serveurs. Gardez-le privé."}},"pl":{"stringUnit":{"state":"needs_review","value":"Z kluczami API plik daje pełny dostęp do Twoich serwerów. Nie udostępniaj go."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Com chaves de API, o arquivo dá acesso total aos seus servidores. Mantenha-o privado."}}}},"hint_you_bought_stashy_before_it":{"localizations":{"it":{"stringUnit":{"state":"needs_review","value":"Hai acquistato stashy prima del passaggio agli abbonamenti, quindi stashy+ resta tuo per sempre. Da allora l'app è cresciuta enormemente. Se vuoi sostenerne lo sviluppo, una mancia è un bel gesto, del tutto facoltativo."}},"ja":{"stringUnit":{"state":"needs_review","value":"サブスクリプション制に移行する前にstashyを購入されたため、stashy+はずっとご利用いただけます。それ以降、アプリは大きく成長しました。開発を応援していただける場合は、チップをいただけると嬉しいです（まったくの任意です）。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Vous avez acheté stashy avant le passage aux abonnements, stashy+ vous reste donc acquis à vie. Depuis, l'app s'est énormément enrichie. Si vous souhaitez soutenir son développement, un pourboire est un geste apprécié, entièrement facultatif."}},"pl":{"stringUnit":{"state":"needs_review","value":"Kupiłeś stashy, zanim przeszło na subskrypcje, więc stashy+ jest Twoje dożywotnio. Od tego czasu aplikacja bardzo się rozrosła. Jeśli chcesz wesprzeć jej rozwój, napiwek będzie miłym gestem — całkowicie opcjonalnym."}},"de":{"stringUnit":{"state":"needs_review","value":"Du hast stashy vor der Umstellung auf Abos gekauft, daher bleibt stashy+ für immer deins. Seitdem ist die App enorm gewachsen. Wenn du die Entwicklung unterstützen möchtest, ist ein Trinkgeld eine nette Geste – ganz freiwillig."}},"ru":{"stringUnit":{"state":"needs_review","value":"Вы купили stashy до перехода на подписки, поэтому stashy+ остается вашим навсегда. С тех пор приложение сильно выросло. Если хотите поддержать разработку, чаевые будут приятным, но совершенно необязательным жестом."}},"es":{"stringUnit":{"state":"needs_review","value":"Compraste stashy antes de que pasara a suscripciones, así que stashy+ es tuyo de por vida. Desde entonces la app ha crecido muchísimo. Si quieres apoyar su desarrollo, una propina es un bonito gesto, totalmente opcional."}},"en":{"stringUnit":{"state":"translated","value":"You bought stashy before it moved to subscriptions, so stashy+ stays yours for life. Since then the app has grown massively. If you'd like to support its development, a tip is a kind gesture, entirely optional."}},"nb":{"stringUnit":{"state":"needs_review","value":"Du kjøpte stashy før appen gikk over til abonnement, så stashy+ er ditt for alltid. Siden den gang har appen vokst enormt. Hvis du vil støtte utviklingen, er et tips en hyggelig gest – helt valgfritt."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je hebt stashy gekocht voordat het overstapte op abonnementen, dus stashy+ blijft levenslang van jou. Sindsdien is de app enorm gegroeid. Wil je de ontwikkeling steunen, dan is een fooi een vriendelijk gebaar, geheel vrijblijvend."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Você comprou o stashy antes de ele passar para assinaturas, então o stashy+ é seu para sempre. Desde então, o app cresceu muito. Se quiser apoiar o desenvolvimento, uma gorjeta é um gesto gentil, totalmente opcional."}},"da":{"stringUnit":{"state":"needs_review","value":"Du købte stashy, før appen gik over til abonnementer, så stashy+ er din for livet. Siden da er appen vokset enormt. Hvis du vil støtte udviklingen, er drikkepenge en venlig gestus – helt valgfrit."}},"ko":{"stringUnit":{"state":"needs_review","value":"구독제로 전환되기 전에 stashy를 구입하셨기 때문에 stashy+를 평생 사용할 수 있습니다. 그 이후로 앱이 크게 성장했습니다. 개발을 후원하고 싶다면 팁을 보내 주시면 감사하겠습니다. 전적으로 선택 사항입니다."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你在 stashy 改为订阅制之前就已购买，因此 stashy+ 永久归你所有。此后 App 已大幅成长。如果你愿意支持它的开发，打赏是一份心意，完全自愿。"}},"tr":{"stringUnit":{"state":"needs_review","value":"stashy'yi aboneliğe geçmeden önce satın aldın, bu yüzden stashy+ ömür boyu senin. O zamandan beri uygulama çok büyüdü. Gelişimini desteklemek istersen bir bahşiş güzel bir jest olur, tamamen isteğe bağlı."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你在 stashy 改為訂閱制之前就已購買，因此 stashy+ 將終身屬於你。自那時起，App 已大幅成長。如果你想支持它的開發，給點小費是一份心意，完全自由選擇。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Du köpte stashy innan appen gick över till prenumerationer, så stashy+ är ditt för alltid. Sedan dess har appen vuxit enormt. Om du vill stödja utvecklingen är dricks en vänlig gest, helt frivillig."}}}},"hint_your_api_key_is_invalid":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的 API 金鑰無效或已過期。請檢查你的伺服器設定。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的 API 密钥无效或已过期。请检查服务器配置。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Din API-nyckel är ogiltig eller har gått ut. Kontrollera serverkonfigurationen."}},"tr":{"stringUnit":{"state":"needs_review","value":"API anahtarın geçersiz veya süresi dolmuş. Sunucu yapılandırmanı denetle."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua chave de API é inválida ou expirou. Verifique a configuração do servidor."}},"ja":{"stringUnit":{"state":"needs_review","value":"APIキーが無効か、期限切れです。サーバー設定を確認してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"API 키가 유효하지 않거나 만료되었습니다. 서버 구성을 확인하세요."}},"de":{"stringUnit":{"state":"needs_review","value":"Dein API-Schlüssel ist ungültig oder abgelaufen. Prüfe deine Serverkonfiguration."}},"ru":{"stringUnit":{"state":"needs_review","value":"Ваш ключ API недействителен или истек. Проверьте конфигурацию сервера."}},"en":{"stringUnit":{"state":"translated","value":"Your API key is invalid or expired. Please check your server configuration."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je API-sleutel is ongeldig of verlopen. Controleer de configuratie van je server."}},"it":{"stringUnit":{"state":"needs_review","value":"La tua chiave API non è valida o è scaduta. Controlla la configurazione del server."}},"es":{"stringUnit":{"state":"needs_review","value":"Tu clave de API no es válida o ha caducado. Comprueba la configuración del servidor."}},"da":{"stringUnit":{"state":"needs_review","value":"Din API-nøgle er ugyldig eller udløbet. Tjek din serverkonfiguration."}},"fr":{"stringUnit":{"state":"needs_review","value":"Votre clé API est invalide ou a expiré. Vérifiez la configuration de votre serveur."}},"nb":{"stringUnit":{"state":"needs_review","value":"API-nøkkelen din er ugyldig eller utløpt. Sjekk serverkonfigurasjonen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Twój klucz API jest nieprawidłowy lub wygasł. Sprawdź konfigurację serwera."}}}},"hint_your_license_key_expired_on":{"localizations":{"it":{"stringUnit":{"state":"needs_review","value":"La tua chiave di licenza è scaduta il %@."}},"fr":{"stringUnit":{"state":"needs_review","value":"Votre clé de licence a expiré le %@."}},"sv":{"stringUnit":{"state":"needs_review","value":"Din licensnyckel gick ut %@."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua chave de licença expirou em %@."}},"nb":{"stringUnit":{"state":"needs_review","value":"Lisensnøkkelen din utløp %@."}},"pl":{"stringUnit":{"state":"needs_review","value":"Twój klucz licencyjny wygasł %@."}},"ja":{"stringUnit":{"state":"needs_review","value":"ライセンスキーは%@に期限切れになりました。"}},"ko":{"stringUnit":{"state":"needs_review","value":"라이선스 키가 %@에 만료되었습니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Срок действия вашего лицензионного ключа истек %@."}},"en":{"stringUnit":{"state":"translated","value":"Your license key expired on %@."}},"es":{"stringUnit":{"state":"needs_review","value":"Tu clave de licencia caducó el %@."}},"de":{"stringUnit":{"state":"needs_review","value":"Dein Lizenzschlüssel ist am %@ abgelaufen."}},"da":{"stringUnit":{"state":"needs_review","value":"Din licensnøgle udløb den %@."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je licentiesleutel is verlopen op %@."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的许可证密钥已于 %@ 过期。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的授權碼已於 %@ 到期。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Lisans anahtarının süresi %@ tarihinde doldu."}}}},"hint_your_server_configuration_is_missing":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Sunucu yapılandırmanda bazı bilgiler eksik."}},"sv":{"stringUnit":{"state":"needs_review","value":"Din serverkonfiguration saknar vissa uppgifter."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的伺服器設定缺少部分資訊。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的服务器配置缺少部分信息。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Faltam alguns dados na configuração do servidor."}},"nb":{"stringUnit":{"state":"needs_review","value":"Serverkonfigurasjonen din mangler noen detaljer."}},"it":{"stringUnit":{"state":"needs_review","value":"Nella configurazione del server mancano alcuni dati."}},"fr":{"stringUnit":{"state":"needs_review","value":"Il manque des détails dans la configuration de votre serveur."}},"nl":{"stringUnit":{"state":"needs_review","value":"In je serverconfiguratie ontbreken enkele gegevens."}},"da":{"stringUnit":{"state":"needs_review","value":"Din serverkonfiguration mangler nogle oplysninger."}},"pl":{"stringUnit":{"state":"needs_review","value":"W konfiguracji serwera brakuje niektórych danych."}},"de":{"stringUnit":{"state":"needs_review","value":"In deiner Serverkonfiguration fehlen einige Angaben."}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバー設定に一部の情報が不足しています。"}},"ru":{"stringUnit":{"state":"needs_review","value":"В конфигурации сервера не хватает некоторых данных."}},"ko":{"stringUnit":{"state":"needs_review","value":"서버 구성에 일부 세부사항이 누락되었습니다."}},"es":{"stringUnit":{"state":"needs_review","value":"A la configuración de tu servidor le faltan algunos datos."}},"en":{"stringUnit":{"state":"translated","value":"Your server configuration is missing some details."}}}},"hint_your_subscription_is_active_buying":{"localizations":{"it":{"stringUnit":{"state":"needs_review","value":"Il tuo abbonamento è attivo. Acquistando Lifetime mantieni stashy+ per sempre, anche dopo aver annullato."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je abonnement is actief. Met Levenslang houd je stashy+ voor altijd, ook na opzeggen."}},"de":{"stringUnit":{"state":"needs_review","value":"Dein Abo ist aktiv. Mit Lifetime behältst du stashy+ für immer, auch nach einer Kündigung."}},"ja":{"stringUnit":{"state":"needs_review","value":"サブスクリプションは有効です。買い切り版を購入すると、解約後もstashy+をずっと利用できます。"}},"da":{"stringUnit":{"state":"needs_review","value":"Dit abonnement er aktivt. Køber du livstid, beholder du stashy+ for altid, også efter opsigelse."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua assinatura está ativa. Comprar o vitalício mantém o stashy+ para sempre, mesmo após cancelar."}},"en":{"stringUnit":{"state":"translated","value":"Your subscription is active. Buying Lifetime keeps stashy+ forever, even after cancelling."}},"es":{"stringUnit":{"state":"needs_review","value":"Tu suscripción está activa. Si compras la versión de por vida, conservarás stashy+ para siempre, incluso tras cancelar."}},"sv":{"stringUnit":{"state":"needs_review","value":"Din prenumeration är aktiv. Köper du Livstid behåller du stashy+ för alltid, även efter att du avslutat prenumerationen."}},"ko":{"stringUnit":{"state":"needs_review","value":"구독이 활성 상태입니다. 평생 이용권을 구입하면 구독을 취소한 후에도 stashy+를 계속 사용할 수 있습니다."}},"fr":{"stringUnit":{"state":"needs_review","value":"Votre abonnement est actif. L'achat à vie conserve stashy+ pour toujours, même après résiliation."}},"ru":{"stringUnit":{"state":"needs_review","value":"Ваша подписка активна. Покупка навсегда сохранит stashy+ даже после отмены подписки."}},"nb":{"stringUnit":{"state":"needs_review","value":"Abonnementet ditt er aktivt. Kjøper du livstid, beholder du stashy+ for alltid, også etter at du avslutter abonnementet."}},"pl":{"stringUnit":{"state":"needs_review","value":"Twoja subskrypcja jest aktywna. Zakup dożywotni zachowuje stashy+ na zawsze, nawet po anulowaniu."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的訂閱目前有效。購買終身版可永久保有 stashy+，即使取消訂閱也一樣。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的订阅有效。购买终身版可永久保留 stashy+，即使取消订阅后也是如此。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Aboneliğin etkin. Ömür Boyu satın alırsan stashy+ iptal ettikten sonra bile sonsuza dek senin olur."}}}},"hip_body":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"臀部 / 身体"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kalça / Gövde"}},"sv":{"stringUnit":{"state":"needs_review","value":"Höft/kropp"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"臀部／身體"}},"nl":{"stringUnit":{"state":"needs_review","value":"Heup / lichaam"}},"fr":{"stringUnit":{"state":"needs_review","value":"Hanches / corps"}},"es":{"stringUnit":{"state":"needs_review","value":"Cadera / cuerpo"}},"de":{"stringUnit":{"state":"needs_review","value":"Hüfte / Körper"}},"ja":{"stringUnit":{"state":"needs_review","value":"ヒップ / 体"}},"da":{"stringUnit":{"state":"needs_review","value":"Hofte/krop"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Quadril / corpo"}},"ko":{"stringUnit":{"state":"needs_review","value":"엉덩이 / 몸"}},"pl":{"stringUnit":{"state":"needs_review","value":"Biodra / ciało"}},"nb":{"stringUnit":{"state":"needs_review","value":"Hofte / kropp"}},"ru":{"stringUnit":{"state":"needs_review","value":"Бедра / тело"}},"en":{"stringUnit":{"state":"translated","value":"Hip / Body"}},"it":{"stringUnit":{"state":"needs_review","value":"Fianchi / corpo"}}}},"hold_next":{"localizations":{"fr":{"stringUnit":{"state":"needs_review","value":"Maintenir ▼ Suivant"}},"ko":{"stringUnit":{"state":"needs_review","value":"▼ 길게 눌러 다음"}},"it":{"stringUnit":{"state":"needs_review","value":"Tieni premuto ▼ Successivo"}},"de":{"stringUnit":{"state":"needs_review","value":"▼ halten: Weiter"}},"ja":{"stringUnit":{"state":"needs_review","value":"▼長押し：次へ"}},"nl":{"stringUnit":{"state":"needs_review","value":"Houd ▼ vast: volgende"}},"en":{"stringUnit":{"state":"translated","value":"Hold ▼ Next"}},"da":{"stringUnit":{"state":"needs_review","value":"Hold ▼ Næste"}},"es":{"stringUnit":{"state":"needs_review","value":"Mantén ▼ Siguiente"}},"ru":{"stringUnit":{"state":"needs_review","value":"Удерживайте ▼ — далее"}},"nb":{"stringUnit":{"state":"needs_review","value":"Hold ▼ Neste"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Segure ▼ Próximo"}},"pl":{"stringUnit":{"state":"needs_review","value":"Przytrzymaj ▼ Następne"}},"tr":{"stringUnit":{"state":"needs_review","value":"▼ Basılı Tut: Sonraki"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"按住 ▼ 下一个"}},"sv":{"stringUnit":{"state":"needs_review","value":"Håll ▼ Nästa"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"按住 ▼ 下一個"}}}},"hold_prev":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"按住 ▲ 上一個"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"按住 ▲ 上一个"}},"tr":{"stringUnit":{"state":"needs_review","value":"▲ Basılı Tut: Önceki"}},"ko":{"stringUnit":{"state":"needs_review","value":"▲ 길게 눌러 이전"}},"nl":{"stringUnit":{"state":"needs_review","value":"Houd ▲ vas