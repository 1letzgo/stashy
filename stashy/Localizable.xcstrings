 dimenticati nella Home."}}}},"hint_turn_rows_on_in_settings":{"localizations":{"fr":{"stringUnit":{"state":"needs_review","value":"Activez des rangées dans Réglages › Rangées de l'accueil."}},"nb":{"stringUnit":{"state":"needs_review","value":"Slå på rader i Innstillinger › Rader på Hjem."}},"en":{"stringUnit":{"state":"needs_review","value":"Turn rows on in Settings › Home Rows."}},"es":{"stringUnit":{"state":"needs_review","value":"Activa filas en Ajustes › Filas de Inicio."}},"nl":{"stringUnit":{"state":"needs_review","value":"Schakel rijen in via Instellingen › Home-rijen."}},"ru":{"stringUnit":{"state":"needs_review","value":"Включите ряды в меню «Настройки › Ряды главной»."}},"it":{"stringUnit":{"state":"needs_review","value":"Attiva le righe in Impostazioni › Righe della Home."}},"de":{"stringUnit":{"state":"needs_review","value":"Schalte Zeilen unter Einstellungen › Start-Zeilen ein."}},"ko":{"stringUnit":{"state":"needs_review","value":"설정 › 홈 행에서 행을 켜세요."}},"pl":{"stringUnit":{"state":"needs_review","value":"Włącz wiersze w Ustawienia › Wiersze ekranu Start."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ative linhas em Ajustes › Linhas do Início."}},"ja":{"stringUnit":{"state":"needs_review","value":"設定 › ホームの行で行をオンにしてください。"}},"da":{"stringUnit":{"state":"needs_review","value":"Slå rækker til under Indstillinger › Rækker på Hjem."}},"tr":{"stringUnit":{"state":"needs_review","value":"Satırları Ayarlar › Ana Sayfa Satırları'ndan aç."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請在「設定 › 首頁列」中開啟列。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Slå på rader i Inställningar › Rader på Hem."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请在“设置 › 主页行”中打开行。"}}}},"hint_turn_subtitles_on_automatically_choose":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Slå på undertexter automatiskt, välj språket en scen ska börja med och ställ in hur texterna ser ut."}},"tr":{"stringUnit":{"state":"needs_revie