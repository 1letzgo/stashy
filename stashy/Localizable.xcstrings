},"pl":{"stringUnit":{"state":"needs_review","value":"Niezapisane oceny zostaną utracone."}},"da":{"stringUnit":{"state":"needs_review","value":"Bedømmelser, der ikke blev gemt, går tabt."}},"nb":{"stringUnit":{"state":"needs_review","value":"Vurderinger som ikke ble lagret, går tapt."}},"nl":{"stringUnit":{"state":"needs_review","value":"Beoordelingen die niet zijn bewaard, gaan verloren."}},"ja":{"stringUnit":{"state":"needs_review","value":"保存されていない評価は失われます。"}},"de":{"stringUnit":{"state":"needs_review","value":"Nicht gespeicherte Bewertungen gehen verloren."}},"it":{"stringUnit":{"state":"needs_review","value":"Le valutazioni non salvate andranno perse."}},"ko":{"stringUnit":{"state":"needs_review","value":"저장되지 않은 별점은 사라집니다."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les notes non enregistrées sont perdues."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"未存储的评分将会丢失。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Betyg som inte sparades går förlorade."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"未儲存的評分將會遺失。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kaydedilmeyen puanlar kaybolur."}}}},"hint_remove_arg_from_stash_other":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"要从 Stash 中移除“%@”吗？其他设备将失去此已存过滤器。"}},"tr":{"stringUnit":{"state":"needs_review","value":"“%@” Stash'ten kaldırılsın mı? Diğer aygıtlar bu kayıtlı filtreyi kaybeder."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"要從 Stash 移除「%@」嗎？其他裝置將失去此已儲存的篩選條件。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Ta bort ”%@” från Stash? Andra enheter förlorar det här sparade filtret."}},"da":{"stringUnit":{"state":"needs_review","value":"Fjern “%@” fra Stash? Andre enheder mister dette gemte filter."}},"pl":{"stringUnit":{"state":"needs_review","value":"Usunąć „%@” ze Stash? Inne urządzenia stracą ten zapisany filtr."}},"nl":{"stringUnit":{"state":"needs_review","value":"'%@' uit Stash verwijderen? Andere apparaten