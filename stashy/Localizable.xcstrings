 color you pick."}},"it":{"stringUnit":{"state":"needs_review","value":"Cambia l'icona dell'app stashy nel colore che scegli."}},"fr":{"stringUnit":{"state":"needs_review","value":"Donne à l'icône de stashy la couleur choisie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Altera o ícone do app stashy para a cor escolhida."}},"nb":{"stringUnit":{"state":"needs_review","value":"Endrer stashy-appikonet til fargen du velger."}},"es":{"stringUnit":{"state":"needs_review","value":"Cambia el icono de stashy al color que elijas."}},"nl":{"stringUnit":{"state":"needs_review","value":"Wijzigt het stashy-appsymbool naar de kleur die je kiest."}},"ko":{"stringUnit":{"state":"needs_review","value":"stashy 앱 아이콘을 선택한 색상으로 변경합니다."}},"da":{"stringUnit":{"state":"needs_review","value":"Ændrer stashys appikon til den farve, du vælger."}},"ja":{"stringUnit":{"state":"needs_review","value":"stashyのAppアイコンを選んだ色に変更します。"}},"de":{"stringUnit":{"state":"needs_review","value":"Ändert das stashy-App-Icon in die gewählte Farbe."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zmienia ikonę aplikacji stashy na wybrany kolor."}},"ru":{"stringUnit":{"state":"needs_review","value":"Меняет цвет значка stashy на выбранный."}}}},"hint_choose_appearance_of_app":{"localizations":{"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha a aparência do app."}},"ja":{"stringUnit":{"state":"needs_review","value":"Appの外観を選択します。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg utseendet til appen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies de weergave van de app."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите оформление приложения."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige la apariencia de la app."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg appens udseende."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli l'aspetto dell'app."}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle die Dars