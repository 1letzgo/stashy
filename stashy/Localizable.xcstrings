iew","value":"使用你的 Stash 凭证登录以获取 API 密钥。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Faça login com suas credenciais do Stash para obter a chave de API."}},"it":{"stringUnit":{"state":"needs_review","value":"Accedi con le tue credenziali Stash per ottenere la chiave API."}},"de":{"stringUnit":{"state":"needs_review","value":"Melde dich mit deinen Stash-Zugangsdaten an, um den API-Schlüssel abzurufen."}},"es":{"stringUnit":{"state":"needs_review","value":"Inicia sesión con tus credenciales de Stash para obtener la clave de API."}},"nb":{"stringUnit":{"state":"needs_review","value":"Logg inn med Stash-påloggingen din for å hente API-nøkkelen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Log in met je Stash-gegevens om de API-sleutel op te halen."}},"fr":{"stringUnit":{"state":"needs_review","value":"Connectez-vous avec vos identifiants Stash pour récupérer la clé API."}},"ru":{"stringUnit":{"state":"needs_review","value":"Войдите с учетными данными Stash, чтобы получить ключ API."}},"ko":{"stringUnit":{"state":"needs_review","value":"API 키를 가져오려면 Stash 자격 증명으로 로그인하세요."}},"ja":{"stringUnit":{"state":"needs_review","value":"StashのログインIDとパスワードでログインして、APIキーを取得します。"}},"en":{"stringUnit":{"state":"needs_review","value":"Login with your Stash credentials to retrieve the API key."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zaloguj się danymi Stash, aby pobrać klucz API."}},"da":{"stringUnit":{"state":"needs_review","value":"Log ind med dine Stash-loginoplysninger for at hente API-nøglen."}}}},"hint_love_spouse_2_4g_toys":{"localizations":{"en":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4g toys use BLE advertising. Ensure Bluetooth is enabled and the toy is in pairing/scan mode. Both toys in range will react simultaneously."}},"nl":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4G-speeltjes gebruiken BLE-advertising. Zorg dat Bluetooth aanstaat en het speeltje in koppel-/scanmodus staat. Alle speeltjes binnen bereik reageren tegelijk."}},"nb":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4g-leketøy bruker BLE-annonsering. Sørg for at Bluetooth er slått på og at leketøyet er i paringsmodus/skannemodus. Alle leketøy innenfor rekkevidde reagerer samtidig."}},"da":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4g-legetøj bruger BLE-annoncering. Sørg for, at Bluetooth er slået til, og at legetøjet er i parrings-/scanningstilstand. Alt legetøj inden for rækkevidde reagerer samtidigt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zabawki Love Spouse 2.4g używają rozgłaszania BLE. Upewnij się, że Bluetooth jest włączony, a zabawka jest w trybie parowania/skanowania. Obie zabawki w zasięgu zareagują jednocześnie."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les jouets Love Spouse 2.4g utilisent les annonces BLE. Vérifiez que le Bluetooth est activé et que le jouet est en mode appairage/recherche. Tous les jouets à portée réagiront simultanément."}},"ko":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4g 토이는 BLE 광고를 사용합니다. Bluetooth가 켜져 있고 토이가 페어링/스캔 모드인지 확인하세요. 범위 내의 토이 두 개가 동시에 반응합니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Игрушки Love Spouse 2.4g используют рекламные пакеты BLE. Убедитесь, что Bluetooth включен, а игрушка находится в режиме сопряжения/поиска. Все игрушки в радиусе действия будут реагировать одновременно."}},"es":{"stringUnit":{"state":"needs_review","value":"Los juguetes Love Spouse de 2,4 GHz usan anuncios BLE. Asegúrate de que el Bluetooth esté activado y de que el juguete esté en modo de emparejamiento/búsqueda. Todos los juguetes al alcance reaccionarán a la vez."}},"it":{"stringUnit":{"state":"needs_review","value":"I giocattoli Love Spouse 2.4g usano l'advertising BLE. Assicurati che il Bluetooth sia attivo e che il giocattolo sia in modalità abbinamento/scansione. Tutti i giocattoli nel raggio d'azione reagiranno contemporaneamente."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Brinquedos Love Spouse 2.4g usam anúncios BLE. Verifique se o Bluetooth está ativado e se o brinquedo está em modo de pareamento/busca. Todos os brinquedos ao alcance reagirão ao mesmo tempo."}},"de":{"stringUnit":{"state":"needs_review","value":"Love-Spouse-2.4g-Toys nutzen BLE-Advertising. Stelle sicher, dass Bluetooth aktiv ist und das Toy im Kopplungs-/Suchmodus ist. Alle Toys in Reichweite reagieren gleichzeitig."}},"ja":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4gトイはBLEアドバタイズを使用します。Bluetoothがオンで、トイがペアリング/スキャンモードになっていることを確認してください。範囲内のすべてのトイが同時に反応します。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4G 玩具使用 BLE 广播。请确保已开启蓝牙且玩具处于配对/扫描模式。范围内的所有玩具都会同时响应。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4g oyuncakları BLE yayını kullanır. Bluetooth'un açık ve oyuncağın eşleme/tarama modunda olduğundan emin ol. Menzildeki tüm oyuncaklar aynı anda tepki verir."}},"sv":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4g-leksaker använder BLE-annonsering. Se till att Bluetooth är på och att leksaken är i parkopplings-/sökläge. Alla leksaker inom räckhåll reagerar samtidigt."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"Love Spouse 2.4g 玩具使用 BLE 廣播。請確定藍牙已開啟，且玩具處於配對／掃描模式。範圍內的所有玩具會同時反應。"}}}},"hint_match_and_rateme_are_part":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Match ve RateMe stashy+'nın parçasıdır."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"Match 和 RateMe 属于 stashy+。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"Match 和 RateMe 是 stashy+ 的一部分。"}},"da":{"stringUnit":{"state":"needs_review","value":"Match og RateMe er en del af stashy+."}},"en":{"stringUnit":{"state":"needs_review","value":"Match and RateMe are part of stashy+."}},"nb":{"stringUnit":{"state":"needs_review","value":"Match og RateMe er en del av stashy+."}},"it":{"stringUnit":{"state":"needs_review","value":"Match e RateMe fanno parte di stashy+."}},"sv":{"stringUnit":{"state":"needs_review","value":"Match och RateMe ingår i stashy+."}},"pl":{"stringUnit":{"state":"needs_review","value":"Match i RateMe są częścią stashy+."}},"fr":{"stringUnit":{"state":"needs_review","value":"Match et RateMe font partie de stashy+."}},"de":{"stringUnit":{"state":"needs_review","value":"Match und RateMe sind Teil von stashy+."}},"nl":{"stringUnit":{"state":"needs_review","value":"Match en RateMe maken deel uit van stashy+."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Match e RateMe fazem parte do stashy+."}},"es":{"stringUnit":{"state":"needs_review","value":"Match y RateMe forman parte de stashy+."}},"ja":{"stringUnit":{"state":"needs_review","value":"MatchとRateMeはstashy+の機能です。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Match 및 RateMe는 stashy+의 일부입니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Match и RateMe входят в stashy+."}}}},"hint_matches_performer_studio_and_tag":{"localizations":{"ko":{"stringUnit":{"state":"needs_review","value":"배우, 스튜디오 및 태그 이름을 파일 경로와 대조하여 영상, 이미지 및 갤러리에 추가합니다. 짧은 이름은 잘못 일치할 수 있습니다."}},"fr":{"stringUnit":{"state":"needs_review","value":"Compare les noms de performeurs, studios et étiquettes aux chemins de fichiers et les ajoute aux scènes, images et galeries. Les noms courts peuvent correspondre par erreur."}},"es":{"stringUnit":{"state":"needs_review","value":"Compara los nombres de intérpretes, estudios y etiquetas con las rutas de archivo y los añade a escenas, imágenes y galerías. Los nombres cortos pueden coincidir por error."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Compara nomes de artistas, estúdios e etiquetas com os caminhos dos arquivos e os adiciona a cenas, imagens e galerias. Nomes curtos podem corresponder por engano."}},"it":{"stringUnit":{"state":"needs_review","value":"Confronta i nomi di performer, studi e tag con i percorsi dei file e li aggiunge a scene, immagini e gallerie. I nomi brevi possono corrispondere per errore."}},"de":{"stringUnit":{"state":"needs_review","value":"Gleicht Darsteller-, Studio- und Tag-Namen mit Dateipfaden ab und fügt sie Szenen, Bildern und Galerien hinzu. Kurze Namen können versehentlich passen."}},"en":{"stringUnit":{"state":"needs_review","value":"Matches performer, studio and tag names against file paths and adds them to scenes, images and galleries. Short names can match by mistake."}},"nb":{"stringUnit":{"state":"needs_review","value":"Sammenligner utøver-, studio- og taggnavn med filstier og legger dem til scener, bilder og gallerier. Korte navn kan gi feil treff."}},"ru":{"stringUnit":{"state":"needs_review","value":"Сопоставляет имена исполнителей, студий и тегов с путями файлов и добавляет их к сценам, изображениям и галереям. Короткие имена могут совпасть ошибочно."}},"ja":{"stringUnit":{"state":"needs_review","value":"出演者、スタジオ、タグの名前をファイルパスと照合し、シーン、画像、ギャラリーに追加します。短い名前は誤って一致することがあります。"}},"da":{"stringUnit":{"state":"needs_review","value":"Matcher kunstner-, studie- og tagnavne med filstier og føjer dem til scener, billeder og gallerier. Korte navne kan matche ved en fejl."}},"nl":{"stringUnit":{"state":"needs_review","value":"Vergelijkt namen van performers, studio's en labels met bestandspaden en voegt ze toe aan scènes, afbeeldingen en galerijen. Korte namen kunnen per ongeluk overeenkomen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Dopasowuje nazwy aktorów, studiów i tagów do ścieżek plików i dodaje je do scen, obrazów i galerii. Krótkie nazwy mogą dopasować się przez pomyłkę."}},"tr":{"stringUnit":{"state":"needs_review","value":"Oyuncu, stüdyo ve etiket adlarını dosya yollarıyla eşleştirir ve bunları sahnelere, resimlere ve galerilere ekler. Kısa adlar yanlışlıkla eşleşebilir."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"将演员、工作室和标签名称与文件路径进行匹配，并将其添加到短片、图片和图库。较短的名称可能会误匹配。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"將演員、工作室和標籤名稱與檔案路徑比對，並加入短片、圖片和圖庫。較短的名稱可能會誤判。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Matchar namn på stjärnor, studior och taggar mot filsökvägar och lägger till dem i scener, bilder och gallerier. Korta namn kan ge felaktiga träffar."}}}},"hint_matches_when_at_least_one":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"下方至少有一个条件成立时即匹配。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"只要符合下方至少一個條件即算相符。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Aşağıdaki koşullardan en az biri sağlandığında eşleşir."}},"sv":{"stringUnit":{"state":"needs_review","value":"Matchar när minst ett villkor nedan är uppfyllt."}},"nl":{"stringUnit":{"state":"needs_review","value":"Komt overeen als aan minstens één voorwaarde hieronder is voldaan."}},"ja":{"stringUnit":{"state":"needs_review","value":"下の条件のうち少なくとも1つが真の場合に一致します。"}},"de":{"stringUnit":{"state":"needs_review","value":"Trifft zu, wenn mindestens eine Bedingung unten erfüllt ist."}},"da":{"stringUnit":{"state":"needs_review","value":"Matcher, når mindst én betingelse nedenfor er opfyldt."}},"fr":{"stringUnit":{"state":"needs_review","value":"Correspond si au moins une condition ci-dessous est remplie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Corresponde quando pelo menos uma condição abaixo é verdadeira."}},"en":{"stringUnit":{"state":"needs_review","value":"Matches when at least one condition below is true."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pasuje, gdy co najmniej jeden z poniższych warunków jest spełniony."}},"ru":{"stringUnit":{"state":"needs_review","value":"Совпадает, если выполняется хотя бы одно условие ниже."}},"nb":{"stringUnit":{"state":"needs_review","value":"Samsvarer når minst én betingelse nedenfor er oppfylt."}},"ko":{"stringUnit":{"state":"needs_review","value":"아래 조건 중 하나 이상이 충족되면 일치합니다."}},"es":{"stringUnit":{"state":"needs_review","value":"Coincide cuando se cumple al menos una de las condiciones de abajo."}},"it":{"stringUnit":{"state":"needs_review","value":"Corrisponde quando almeno una delle condizioni qui sotto è vera."}}}},"hint_mini_player_arg_opens_player":{"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Miniplayer: %@. Öffnet den Player"}},"pl":{"stringUnit":{"state":"needs_review","value":"Miniodtwarzacz: %@. Otwiera odtwarzacz"}},"ko":{"stringUnit":{"state":"needs_review","value":"미니 플레이어: %@. 플레이어를 엽니다"}},"fr":{"stringUnit":{"state":"needs_review","value":"Mini-lecteur : %@. Ouvre le lecteur"}},"sv":{"stringUnit":{"state":"needs_review","value":"Minispelare: %@. Öppnar spelaren"}},"it":{"stringUnit":{"state":"needs_review","value":"Mini player: %@. Apre il player"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Miniplayer: %@. Abre o player"}},"nb":{"stringUnit":{"state":"needs_review","value":"Minispiller: %@. Åpner spilleren"}},"da":{"stringUnit":{"state":"needs_review","value":"Miniafspiller: %@. Åbner afspilleren"}},"en":{"stringUnit":{"state":"needs_review","value":"Mini player: %@. Opens the player"}},"ru":{"stringUnit":{"state":"needs_review","value":"Мини-плеер: %@. Открывает плеер"}},"nl":{"stringUnit":{"state":"needs_review","value":"Minispeler: %@. Opent de speler"}},"ja":{"stringUnit":{"state":"needs_review","value":"ミニプレーヤー：%@。プレーヤーを開きます"}},"es":{"stringUnit":{"state":"needs_review","value":"Minirreproductor: %@. Abre el reproductor"}},"tr":{"stringUnit":{"state":"needs_review","value":"Mini oynatıcı: %@. Oynatıcıyı açar"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"迷你播放器：%@。打开播放器"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"迷你播放器：%@。打開播放器"}}}},"hint_missing_from_store_offering_arg":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"商店方案中缺少：%@"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"商店产品中缺少：%@"}},"sv":{"stringUnit":{"state":"needs_review","value":"Saknas i butikens utbud: %@"}},"tr":{"stringUnit":{"state":"needs_review","value":"Mağaza teklifinde eksik: %@"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Ausente da oferta da lo