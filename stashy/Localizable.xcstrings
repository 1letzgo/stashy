ringUnit":{"state":"needs_review","value":"De downloadede billeder fjernes fra denne enhed."}}}},"hint_downloaded_scenes_will_appear_here":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"ダウンロードしたシーンはここに表示され、オフラインで視聴できます。"}},"en":{"stringUnit":{"state":"needs_review","value":"Downloaded scenes will appear here for offline viewing."}},"nb":{"stringUnit":{"state":"needs_review","value":"Nedlastede scener vises her for visning uten nett."}},"ru":{"stringUnit":{"state":"needs_review","value":"Здесь появятся загруженные сцены для просмотра офлайн."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"As cenas baixadas aparecerão aqui para assistir offline."}},"de":{"stringUnit":{"state":"needs_review","value":"Geladene Szenen erscheinen hier zum Offline-Ansehen."}},"da":{"stringUnit":{"state":"needs_review","value":"Downloadede scener vises her til offlinevisning."}},"nl":{"stringUnit":{"state":"needs_review","value":"Gedownloade scènes verschijnen hier om offline te bekijken."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pobrane sceny pojawią się tutaj do oglądania offline."}},"es":{"stringUnit":{"state":"needs_review","value":"Las escenas descargadas aparecerán aquí para verlas sin conexión."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les scènes téléchargées apparaîtront ici pour un visionnage hors ligne."}},"ko":{"stringUnit":{"state":"needs_review","value":"다운로드한 영상이 여기에 표시되며 오프라인으로 시청할 수 있습니다."}},"it":{"stringUnit":{"state":"needs_review","value":"Le scene scaricate appariranno qui per la visione offline."}},"sv":{"stringUnit":{"state":"needs_review","value":"Nedladdade scener visas här för visning offline."}},"tr":{"stringUnit":{"state":"needs_review","value":"İndirilen sahneler çevrim dışı izlemek için burada görünür."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已下載的短片會顯示在這裡，供離線觀看。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已下载的短片会显示在这里，供离线观看。"}}}},"hint_downloading_arg_speech_model_arg":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"正在下載%@語音模型… %@ %%"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"正在下载%@语音模型… %@ %%"}},"sv":{"stringUnit":{"state":"needs_review","value":"Laddar ner talmodell för %@… %@ %%"}},"tr":{"stringUnit":{"state":"needs_review","value":"%@ konuşma modeli indiriliyor… %%%@"}},"ko":{"stringUnit":{"state":"needs_review","value":"%@ 음성 모델 다운로드 중… %@%%"}},"en":{"stringUnit":{"state":"needs_review","value":"Downloading %@ speech model… %@ %%"}},"de":{"stringUnit":{"state":"needs_review","value":"Sprachmodell %@ wird geladen… %@ %%"}},"es":{"stringUnit":{"state":"needs_review","value":"Descargando modelo de voz %@… %@ %%"}},"ja":{"stringUnit":{"state":"needs_review","value":"%@の音声モデルをダウンロード中… %@ %%"}},"fr":{"stringUnit":{"state":"needs_review","value":"Téléchargement du modèle vocal %@… %@ %%"}},"ru":{"stringUnit":{"state":"needs_review","value":"Загрузка речевой модели %@… %@ %%"}},"nl":{"stringUnit":{"state":"needs_review","value":"Spraakmodel %@ downloaden… %@ %%"}},"da":{"stringUnit":{"state":"needs_review","value":"Downloader talemodel til %@… %@ %%"}},"nb":{"stringUnit":{"state":"needs_review","value":"Laster ned talemodell for %@… %@ %%"}},"it":{"stringUnit":{"state":"needs_review","value":"Download del modello vocale %@… %@ %%"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Baixando modelo de fala %@… %@ %%"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pobieranie modelu mowy %@… %@ %%"}}}},"hint_download_is_managed_by_ios":{"localizations":{"it":{"stringUnit":{"state":"needs_review","value":"Il download è gestito da iOS e può occupare diverse centinaia di megabyte."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Download wird von iOS verwaltet und kann mehrere hundert Megabyte groß sein."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pobieraniem zarządza iOS, a plik może mieć kilkaset megabajtów."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le téléchargement est géré par iOS et peut atteindre plusieurs centaines de mégaoctets."}},"ru":{"stringUnit":{"state":"needs_review","value":"Загрузкой управляет iOS, ее объем может составить несколько сотен мегабайт."}},"ja":{"stringUnit":{"state":"needs_review","value":"ダウンロードはiOSによって管理され、数百MBになる場合があります。"}},"en":{"stringUnit":{"state":"needs_review","value":"The download is managed by iOS and can be several hundred megabytes."}},"nl":{"stringUnit":{"state":"needs_review","value":"De download wordt door iOS beheerd en kan enkele honderden megabytes groot zijn."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O download é gerenciado pelo iOS e pode ter várias centenas de megabytes."}},"es":{"stringUnit":{"state":"needs_review","value":"iOS gestiona la descarga, que puede ocupar varios cientos de megabytes."}},"da":{"stringUnit":{"state":"needs_review","value":"Downloaden styres af iOS og kan fylde flere hundrede megabyte."}},"nb":{"stringUnit":{"state":"needs_review","value":"Nedlastingen håndteres av iOS og kan være på flere hundre megabyte."}},"ko":{"stringUnit":{"state":"needs_review","value":"다운로드는 iOS에서 관리하며 수백 MB에 이를 수 있습니다."}},"tr":{"stringUnit":{"state":"needs_review","value":"İndirme iOS tarafından yönetilir ve birkaç yüz megabayt olabilir."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"下载由 iOS 管理，可能有数百 MB。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"下載由 iOS 管理，大小可能達數百 MB。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Nedladdningen hanteras av iOS och kan vara flera hundra megabyte."}}}},"hint_downloads_are_part_of_stashy":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"下载功能属于 stashy+ — 请在设置中解锁"}},"sv":{"stringUnit":{"state":"needs_review","value":"Nedladdningar ingår i stashy+ – lås upp i Inställningar"}},"tr":{"stringUnit":{"state":"needs_review","value":"İndirmeler stashy+'nın parçasıdır — Ayarlar'da kilidini aç"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"下載功能是 stashy+ 的一部分 — 請在「設定」中解鎖"}},"it":{"stringUnit":{"state":"needs_review","value":"I download fanno parte di stashy+: sbloccali in Impostazioni"}},"en":{"stringUnit":{"state":"needs_review","value":"Downloads are part of stashy+ — unlock in Settings"}},"es":{"stringUnit":{"state":"needs_review","value":"Las descargas forman parte de stashy+; desbloquéalo en Ajustes"}},"da":{"stringUnit":{"state":"needs_review","value":"Downloads er en del af stashy+ – lås op i Indstillinger"}},"ko":{"stringUnit":{"state":"needs_review","value":"다운로드는 stashy+의 일부입니다 — 설정에서 잠금 해제하세요"}},"ja":{"stringUnit":{"state":"needs_review","value":"ダウンロードはstashy+の機能です。設定でロックを解除してください"}},"fr":{"stringUnit":{"state":"needs_review","value":"Les téléchargements font partie de stashy+ — débloquez-les dans les réglages"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pobieranie jest częścią stashy+ — odblokuj w Ustawieniach"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Downloads fazem parte do stashy+ — desbloqueie em Ajustes"}},"de":{"stringUnit":{"state":"needs_review","value":"Downloads sind Teil von stashy+ – in den Einstellungen freischalten"}},"ru":{"stringUnit":{"state":"needs_review","value":"Загрузки входят в stashy+ — разблокируйте в настройках"}},"nl":{"stringUnit":{"state":"needs_review","value":"Downloads maken deel uit van stashy+ – ontgrendel in Instellingen"}},"nb":{"stringUnit":{"state":"needs_review","value":"Nedlastinger er en del av stashy+ – lås opp i Innstillinger"}}}},"hint_downloads_newest_scenes_or_all":{"localizations":{"nl":{"stringUnit":{"state":"needs_review","value":"Downloadt de nieuwste scènes, of allemaal"}},"ja":{"stringUnit":{"state":"needs_review","value":"最新のシーン、またはすべてのシーンをダウンロードします"}},"da":{"stringUnit":{"state":"needs_review","value":"Downloader de nyeste scener eller dem alle"}},"fr":{"stringUnit":{"state":"needs_review","value":"Télécharge les scènes les plus récentes, ou toutes"}},"it":{"stringUnit":{"state":"needs_review","value":"Scarica le scene più recenti o tutte"}},"de":{"stringUnit":{"state":"needs_review","value":"Lädt die neuesten Szenen oder alle"}},"nb":{"stringUnit":{"state":"needs_review","value":"Laster ned de nyeste scenene, eller alle"}},"es":{"stringUnit":{"state":"needs_review","value":"Descarga las escenas más recientes o todas"}},"ko":{"stringUnit":{"state":"needs_review","value":"최신 영상 또는 모든 영상을 다운로드합니다"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Baixa as cenas mais recentes ou todas"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pobiera najnowsze sceny lub wszystkie"}},"en":{"stringUnit":{"state":"needs_review","value":"Downloads the newest scenes, or all of them"}},"ru":{"stringUnit":{"state":"needs_review","value":"Загружает новейшие сцены или все"}},"sv":{"stringUnit":{"state":"needs_review","value":"Laddar ner de senaste scenerna, eller alla"}},"tr":{"stringUnit":{"state":"needs_review","value":"En yeni sahneleri veya tümünü indirir"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"下載最新的短片，或全部短片"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"下载最新的短片或全部短片"}}}},"hint_drag_to_reorder_cards_below":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Video oynatıcının altındaki kartları yeniden sıralamak için sürükle; gizlemek için kartı kapat. Yatay görünümde Gruplar ve Etiketler yan yana olduklarında aynı satırı paylaşır."}},"sv":{"stringUnit":{"state":"needs_review","value":"Dra för att ändra ordning på korten under videospelaren; stäng av ett kort för att dölja det. I liggande läge delar Grupper och Taggar en rad när de ligger bredvid varandra."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"拖移以重新排列影片播放器下方的卡片；關閉卡片即可隱藏。橫向時，群組和標籤相鄰時會共用一列。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"拖移以重新排列视频播放器下方的卡片；关闭某张卡片即可隐藏它。横排时，集合和标签相邻时会共用一行。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Перетаскивайте карточки под видеоплеером, чтобы изменить их порядок; выключите карточку, чтобы скрыть ее. В альбомной ориентации группы и теги занимают один ряд, если стоят рядом."}},"da":{"stringUnit":{"state":"needs_review","value":"Træk for at ændre rækkefølgen af kortene under videoafspilleren; slå et kort fra for at skjule det. I liggende format deler Grupper og Tags en række, når de står ved siden af hinanden."}},"de":{"stringUnit":{"state":"needs_review","value":"Ziehe die Karten unter dem Videoplayer, um sie neu anzuordnen; schalte eine Karte aus, um sie auszublenden. Im Querformat teilen sich Gruppen und Tags eine Zeile, wenn sie nebeneinander liegen."}},"en":{"stringUnit":{"state":"needs_review","value":"Drag to reorder the cards below the video player; switch a card off to hide it. In landscape, Groups and Tags share a row when they sit next to each other."}},"es":{"stringUnit":{"state":"needs_review","value":"Arrastra para reordenar las tarjetas bajo el reproductor; desactiva una tarjeta para ocultarla. En horizontal, Grupos y Etiquetas comparten fila cuando están una junto a otra."}},"fr":{"stringUnit":{"state":"needs_review","value":"Faites glisser pour réordonner les cartes sous le lecteur vidéo ; désactivez une carte pour la masquer. En paysage, Groupes et Étiquettes partagent une rangée lorsqu'ils se suivent."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Arraste para reordenar os cartões abaixo do player de vídeo; desative um cartão para ocultá-lo. Na horizontal, Grupos e Etiquetas dividem uma linha quando estão um ao lado do outro."}},"it":{"stringUnit":{"state":"needs_review","value":"Trascina per riordinare le schede sotto il player video; disattiva una scheda per nasconderla. In orizzontale, Gruppi e Tag condividono una riga quando sono vicini."}},"ja":{"stringUnit":{"state":"needs_review","value":"ドラッグして動画プレーヤーの下のカードを並べ替えます。カードをオフにすると非表示になります。横向きでは、グループとタグが隣り合っている場合に1行を共有します。"}},"ko":{"stringUnit":{"state":"needs_review","value":"드래그하여 비디오 플레이어 아래의 카드 순서를 변경하고, 카드를 끄면 가려집니다. 가로 모드에서는 그룹과 태그가 서로 인접해 있으면 한 행을 함께 사용합니다."}},"pl":{"stringUnit":{"state":"needs_review","value":"Przeciągnij, aby zmienić kolejność kart pod odtwarzaczem; wyłącz kartę, aby ją ukryć. W poziomie Grupy i Tagi dzielą wiersz, gdy sąsiadują ze sobą."}},"nb":{"stringUnit":{"state":"needs_review","value":"Dra for å endre rekkefølgen på kortene under videospilleren; slå av et kort for å skjule det. I liggende format deler Grupper og Tagger en rad når de står ved siden av hverandre."}},"nl":{"stringUnit":{"state":"needs_review","value":"Sleep om de kaarten onder de videospeler te ordenen; schakel een kaart uit om hem te verbergen. In liggende stand delen Groepen en Labels een rij als ze naast elkaar staan."}}}},"hint_drag_to_reorder_cards_below_video":{"localizations":{"es":{"stringUnit":{"state":"needs_review","value":"Arrastra para reordenar las tarjetas bajo el reproductor; desactiva una tarjeta para ocultarla. En horizontal, Grupos y Etiquetas se colocan lado a lado cuando están una junto a otra. Las tarjetas sin nada que mostrar permanecen ocultas en cualquier caso."}},"pl":{"stringUnit":{"state":"needs_review","value":"Przeciągnij, aby zmienić kolejność kart pod odtwarzaczem; wyłącz kartę, aby ją ukryć. W poziomie Grupy i Tagi są obok siebie, gdy sąsiadują ze sobą. Karty, które nie mają nic do pokazania, i tak pozostają ukryte."}},"nl":{"stringUnit":{"state":"needs_review","value":"Sleep om de kaarten onder de videospeler te ordenen; schakel een kaart uit om hem te verbergen. In liggende stand staan Groepen en Labels naast elkaar als ze op elkaar volgen. Kaarten zonder inhoud blijven hoe dan ook verborgen."}},"ja":{"stringUnit":{"state":"needs_review","value":"ドラッグして動画プレーヤーの下のカードを並べ替えます。カードをオフにすると非表示になります。横向きでは、グループとタグが隣り合っている場合に横に並びます。表示する内容がないカードはどちらの場合も非表示のままです。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Dra for å endre rekkefølgen på kortene under videospilleren; slå av et kort for å skjule det. I liggende format står Grupper og Tagger side om side når de er ved siden av hverandre. Kort som ikke har noe å vise, forblir skjult uansett."}},"ko":{"stringUnit":{"state":"needs_review","value":"드래그하여 비디오 플레이어 아래의 카드 순서를 변경하고, 카드를 끄면 가려집니다. 가로 모드에서는 그룹과 태그가 서로 인접해 있으면 나란히 배치됩니다. 표시할 내용이 없는 카드는 어느 경우든 가려집니다."}},"it":{"stringUnit":{"state":"needs_review","value":"Trascina per riordinare le schede sotto il player video; disattiva una scheda per nasconderla. In orizzontale, Gruppi e Tag stanno affiancati quando sono vicini. Le schede senza contenuto restano comunque nascoste."}},"de":{"stringUnit":{"state":"needs_review","value":"Ziehe die Karten unter dem Videoplayer, um sie neu anzuordnen; schalte eine Karte aus, um sie auszublenden. Im Querformat stehen Gruppen und Tags nebeneinander, wenn sie aufeinander folgen. Karten ohne Inhalt bleiben in jedem Fall ausgeblendet."}},"da":{"stringUnit":{"state":"needs_review","value":"Træk for at ændre rækkefølgen af kortene under videoafspilleren; slå et kort fra for at skjule det. I liggende format står Grupper og Tags side om side, når de står ved siden af hinanden. Kort uden indhold forbliver skjult under alle omstændigheder."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Arraste para reordenar os cartões abaixo do player de vídeo; desative um cartão para ocultá-lo. Na horizontal, Grupos e Etiquetas ficam lado a lado quando estão um ao lado do outro. Cartões sem nada para mostrar ficam ocultos de qualquer forma."}},"en":{"stringUnit":{"state":"needs_review","value":"Drag to reorder the cards below the video player; switch a card off to hide it. In landscape, Groups and Tags sit side by side when they are next to each other. Cards that have nothing to show stay hidden either way."}},"fr":{"stringUnit":{"state":"needs_review","value":"Faites glisser pour réordonner les cartes sous le lecteur vidéo ; désactivez une carte pour la masquer. En paysage, Groupes et Étiquettes se placent côte à côte lorsqu'ils se suivent. Les cartes sans contenu restent masquées dans tous les cas."}},"ru":{"stringUnit":{"state":"needs_review","value":"Перетаскивайте карточки под видеоплеером, чтобы изменить их порядок; выключите карточку, чтобы скрыть ее. В альбомной ориентации группы и теги располагаются рядом, если стоят друг за другом. Карточки без содержимого в любом случае скрыты."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"拖移以重新排列视频播放器下方的卡片；关闭某张卡片即可隐藏它。横排时，集合和标签相邻时会并排显示。没有内容可显示的卡片始终隐藏。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"拖移以重新排列影片播放器下方的卡片；關閉卡片即可隱藏。橫向時，群組和標籤相鄰時會並排顯示。沒有內容可顯示的卡片無論如何都會隱藏。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Video oynatıcının altındaki kartları yeniden sıralamak için sürükle; gizlemek için kartı kapat. Yatay görünümde Gruplar ve Etiketler art arda olduklarında yan yana durur. Gösterecek bir şeyi olmayan kartlar her durumda gizli kalır."}},"sv":{"stringUnit":{"state":"needs_review","value":"Dra för att ändra ordning på korten under videospelaren; stäng av ett kort för att dölja det. I liggande läge visas Grupper och Taggar sida vid sida när de ligger bredvid varandra. Kort som inte har något att visa förblir dolda ändå."}}}},"hint_dynamically_linked_so_library_can":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"採用動態連結，因此可將函式庫替換為修改後的版本。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Dinamik olarak bağlıdır, bu nedenle kütüphane değiştirilmiş bir sürümle değiştirilebilir."}},"sv":{"stringUnit":{"state":"needs_review","value":"Dynamiskt länkat, så biblioteket kan ersättas med en modifierad version."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"动态链接，因此该库可被替换为修改后的版本。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Dynamisk lenket, slik at biblioteket kan erstattes med en endret versjon."}},"ja":{"stringUnit":{"state":"needs_review","value":"動的リンクのため、ライブラリを改変版に置き換えることができます。"}},"de":{"stringUnit":{"state":"needs_review","value":"Dynamisch gelinkt, daher kann die Bibliothek durch eine veränderte Version ersetzt werden."}},"it":{"stringUnit":{"state":"needs_review","value":"Collegata dinamicamente, quindi la libreria può essere sostituita da una versione modificata."}},"ko":{"stringUnit":{"state":"needs_review","value":"동적으로 링크되어 있으므로 라이브러리를 수정된 버전으로 대체할 수 있습니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Динамически скомпонована, поэтому библиотеку можно заменить измененной версией."}},"en":{"stringUnit":{"state":"needs_review","value":"Dynamically linked, so the library can be replaced by a modified version."}},"da":{"stringUnit":{"state":"needs_review","value":"Dynamisk linket, så biblioteket kan erstattes af en ændret version."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Vinculada dinamicamente, então a biblioteca pode ser substituída por uma versão modificada."}},"fr":{"stringUnit":{"state":"needs_review","value":"Liée dynamiquement, la bibliothèque peut donc être remplacée par une version modifiée."}},"es":{"stringUnit":{"state":"needs_review","value":"Enlazada dinámicamente, por lo que la biblioteca puede reemplazarse por una versión modificada."}},"nl":{"stringUnit":{"state":"needs_review","value":"Dynamisch gekoppeld, zodat de bibliotheek door een aangepaste versie kan worden vervangen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Łączona dynamicznie, więc bibliotekę można zastąpić zmodyfikowaną wersją."}}}},"hint_dynamically_linked_so_relinking_with":{"localizations":{"nl":{"stringUnit":{"state":"needs_review","value":"Dynamisch gekoppeld, zodat opnieuw koppelen met een aangepaste FFmpeg mogelijk is."}},"ja":{"stringUnit":{"state":"needs_review","value":"動的リンクのため、改変したFFmpegと再リンクできます。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Łączona dynamicznie, więc możliwe jest ponowne połączenie ze zmodyfikowanym FFmpeg."}},"ru":{"stringUnit":{"state":"needs_review","value":"Динамически скомпонована, поэтому возможна перекомпоновка с измененной FFmpeg."}},"ko":{"stringUnit":{"state":"needs_review","value":"동적으로 링크되어 있으므로 수정된 FFmpeg로 다시 링크할 수 있습니다."}},"es":{"stringUnit":{"state":"needs_review","value":"Enlazada dinámicamente, por lo que es posible volver a enlazarla con un FFmpeg modificado."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Vinculado dinamicamente, então é possível revincular com um FFmpeg modificado."}},"de":{"stringUnit":{"state":"needs_review","value":"Dynamisch gelinkt, daher ist ein Neulinken mit einem veränderten FFmpeg möglich."}},"nb":{"stringUnit":{"state":"needs_review","value":"Dynamisk lenket, slik at det er mulig å lenke på nytt med en endret FFmpeg."}},"da":{"stringUnit":{"state":"needs_review","value":"Dynamisk linket, så det er muligt at linke igen med en ændret FFmpeg."}},"en":{"stringUnit":{"state":"needs_review","value":"Dynamically linked, so relinking with a modified FFmpeg is possible."}},"fr":{"stringUnit":{"state":"needs_review","value":"Liée dynamiquement, une nouvelle liaison avec un FFmpeg modifié est donc possible."}},"it":{"stringUnit":{"state":"needs_review","value":"Collegata dinamicamente, quindi è possibile ricollegarla con un FFmpeg modificato."}},"sv":{"stringUnit":{"state":"needs_review","value":"Dynamiskt länkat, så det går att länka om med en modifierad FFmpeg."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"动态链接，因此可以与修改后的 FFmpeg 重新链接。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"採用動態連結，因此可與修改後的 FFmpeg 重新連結。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Dinamik olarak bağlıdır, bu nedenle değiştirilmiş bir FFmpeg ile yeniden bağlama mümkündür."}}}},"hint_each_job_downloads_its_configured":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Her iş, ayarlanan sayıda en yeni öğeyi indirir. Zaten indirilmiş öğeler atlanır."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"每個工作會下載其設定數量的最新項目。已下載的項目會略過。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"每个任务会下载其所设数量的最新项目。已下载的项目将被跳过。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Varje jobb laddar ner sitt inställda antal av de senaste objekten. Redan nedladdade objekt hoppas över."}},"nl":{"stringUnit