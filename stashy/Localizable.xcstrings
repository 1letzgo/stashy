 galerías, canales) y su orden."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg, hvilke rækker Hjem viser – scener, kunstnere, studier, gallerier, kanaler – og deres rækkefølge."}}}},"hint_choose_whose_profile_picture_this":{"localizations":{"en":{"stringUnit":{"state":"translated","value":"Choose whose profile picture this image becomes."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha de quem esta imagem será a foto de perfil."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите, чьим изображением профиля станет это изображение."}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle, wessen Profilbild dieses Bild wird."}},"ko":{"stringUnit":{"state":"needs_review","value":"이 이미지를 누구의 프로필 사진으로 사용할지 선택하세요."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige de quién será esta imagen como foto de perfil."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli di chi diventa l'immagine del profilo."}},"sv":{"stringUnit":{"state":"needs_review","value":"Välj vems profilbild den här bilden blir."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg, hvis profilbillede dette billede skal være."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez de qui cette image devient la photo de profil."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies van wie deze afbeelding de profielfoto wordt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz, czyim zdjęciem profilowym stanie się ten obraz."}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg hvem som får dette bildet som profilbilde."}},"ja":{"stringUnit":{"state":"needs_review","value":"この画像を誰のプロフィール写真にするか選択してください。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu resmin kimin profil resmi olacağını seç."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇要將此圖片設為誰的個人圖片。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择将此图片用作谁的头像。"}}}},"hint_chooses_saved_filter_or_preset":{"localizations"