Unit":{"state":"needs_review","value":"stashy yukarıdaki bileşenleri kullanır. Bunların lisansları stashy'nin kendi koşullarına ek olarak geçerlidir."}},"sv":{"stringUnit":{"state":"needs_review","value":"stashy använder komponenterna ovan. Deras licenser gäller utöver stashys egna villkor."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"stashy 使用上述元件。除了 stashy 本身的條款外，這些元件的授權條款也適用。"}}}},"hint_subscribe_or_buy_lifetime_to":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"訂閱或購買終身版以解鎖進階功能。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Prenumerera eller köp Livstid för att låsa upp premiumfunktioner."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"订阅或购买终身版以解锁高级功能。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Premium özelliklerin kilidini açmak için abone ol veya Ömür Boyu satın al."}},"pl":{"stringUnit":{"state":"needs_review","value":"Subskrybuj lub kup wersję dożywotnią, aby odblokować funkcje premium."}},"en":{"stringUnit":{"state":"needs_review","value":"Subscribe or buy Lifetime to unlock premium features."}},"ko":{"stringUnit":{"state":"needs_review","value":"프리미엄 기능을 잠금 해제하려면 구독하거나 평생 이용권을 구입하세요."}},"ja":{"stringUnit":{"state":"needs_review","value":"プレミアム機能をロック解除するには、サブスクリプションに登録するか買い切り版を購入してください。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Neem een abonnement of koop Levenslang om premiumfuncties te ontgrendelen."}},"nb":{"stringUnit":{"state":"needs_review","value":"Abonner eller kjøp livstid for å låse opp premiumfunksjoner."}},"es":{"stringUnit":{"state":"needs_review","value":"Suscríbete o compra la versión de por vida para desbloquear las funciones premium."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Assine ou compre o vitalício para desbloquear recursos premium."}},"fr":{"stringUnit":{"state":"needs_review","value":"Abonnez-vous ou achetez l'accès à vie pour débloquer les fonctions premium."}},"it":{"stringUnit":{"state":"needs_review","value":"Abbonati o acquista Lifetime per sbloccare le funzioni premium."}},"da":{"stringUnit":{"state":"needs_review","value":"Abonner, eller køb livstid for at låse premiumfunktioner op."}},"ru":{"stringUnit":{"state":"needs_review","value":"Оформите подписку или купите доступ навсегда, чтобы открыть премиум-функции."}},"de":{"stringUnit":{"state":"needs_review","value":"Abonniere oder kaufe Lifetime, um Premium-Funktionen freizuschalten."}}}},"hint_subscriptions_renew_automatically_unless_canceled":{"localizations":{"ko":{"stringUnit":{"state":"needs_review","value":"현재 기간이 끝나기 최소 24시간 전에 취소하지 않으면 구독이 자동으로 갱신됩니다. App Store 계정 설정에서 관리하거나 취소하세요."}},"ja":{"stringUnit":{"state":"needs_review","value":"サブスクリプションは、現在の期間終了の24時間以上前に解約しない限り自動更新されます。App Storeのアカウント設定で管理または解約できます。"}},"da":{"stringUnit":{"state":"needs_review","value":"Abonnementer fornyes automatisk, medmindre de opsiges mindst 24 timer før udløbet af den aktuelle periode. Administrer eller opsig i dine App Store-kontoindstillinger."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les abonnements se renouvellent automatiquement sauf résiliation au moins 24 heures avant la fin de la période en cours. Gérez-les ou résiliez-les dans les réglages de votre compte App Store."}},"en":{"stringUnit":{"state":"needs_review","value":"Subscriptions renew automatically unless canceled at least 24 hours before the end of the current period. Manage or cancel in your App Store account settings."}},"it":{"stringUnit":{"state":"needs_review","value":"Gli abbonamenti si rinnovano automaticamente se non vengono annullati almeno 24 ore prima della fine del periodo in corso. Gestiscili o annullali nelle impostazioni del tuo account App Store."}},"nl":{"stringUnit":{"state":"needs_review","value":"Abonnementen worden automatisch verlengd, tenzij je ze minstens 24 uur voor het einde van de huidige periode opzegt. Beheer of zeg op in de instellingen van je App Store-account."}},"nb":{"stringUnit":{"state":"needs_review","value":"Abonnementer fornyes automatisk med mindre de avsluttes minst 24 timer før slutten av gjeldende periode. Administrer eller avslutt i innstillingene for App Store-kontoen din."}},"es":{"stringUnit":{"state":"needs_review","value":"Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes del final del periodo actual. Gestiónalas o cancélalas en los ajustes de tu cuenta del App Store."}},"pl":{"stringUnit":{"state":"needs_review","value":"Subskrypcje odnawiają się automatycznie, chyba że zostaną anulowane co najmniej 24 godziny przed końcem bieżącego okresu. Zarządzaj nimi lub anuluj w ustawieniach konta App Store."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"As assinaturas são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele nos ajustes da sua conta da App Store."}},"ru":{"stringUnit":{"state":"needs_review","value":"Подписка продлевается автоматически, если не отменить ее как минимум за 24 часа до конца текущего периода. Управлять подпиской или отменить ее можно в настройках учетной записи App Store."}},"de":{"stringUnit":{"state":"needs_review","value":"Abos verlängern sich automatisch, wenn sie nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums gekündigt werden. Verwalten oder kündigen in deinen App-Store-Accounteinstellungen."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"除非在目前期間結束前至少 24 小時取消，否則訂閱會自動續訂。請在你的 App Store 帳號設定中管理或取消。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Abonelikler, geçerli dönemin bitiminden en az 24 saat önce iptal edilmezse otomatik olarak yenilenir. App Store hesap ayarlarından yönet veya iptal et."}},"sv":{"stringUnit":{"state":"needs_review","value":"Prenumerationer förnyas automatiskt om de inte avslutas minst 24 timmar före den aktuella periodens slut. Hantera eller avsluta i inställningarna för ditt App Store-konto."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"除非在当前周期结束前至少 24 小时取消，否则订阅将自动续订。可在 App Store 帐户设置中管理或取消。"}}}},"hint_subscriptions_renew_automatically_unless_canceled_before":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"除非在当前周期结束前取消，否则订阅将自动续订。可在 Google Play 帐户设置中管理或取消。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"除非在目前期間結束前取消，否則訂閱會自動續訂。請在你的 Google Play 帳戶設定中管理或取消。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Abonelikler, geçerli dönemin bitiminden önce iptal edilmezse otomatik olarak yenilenir. Google Play hesap ayarlarından yönet veya iptal et."}},"it":{"stringUnit":{"state":"needs_review","value":"Gli abbonamenti si rinnovano automaticamente se non vengono annullati prima della fine del periodo in corso. Gestiscili o annullali nelle impostazioni del tuo account Google Play."}},"ko":{"stringUnit":{"state":"needs_review","value":"현재 기간이 끝나기 전에 취소하지 않으면 구독이 자동으로 갱신됩니다. Google Play 계정 설정에서 관리하거나 취소하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Abonnementer fornyes automatisk med mindre de avsluttes før slutten av gjeldende periode. Administrer eller avslutt i innstillingene for Google Play-kontoen din."}},"sv":{"stringUnit":{"state":"needs_review","value":"Prenumerationer förnyas automatiskt om de inte avslutas före den aktuella periodens slut. Hantera eller avsluta i inställningarna för ditt Google Play-konto."}},"ru":{"stringUnit":{"state":"needs_review","value":"Подписка продлевается автоматически, если не отменить ее до конца текущего периода. Управлять подпиской или отменить ее можно в настройках аккаунта Google Play."}},"es":{"stringUnit":{"state":"needs_review","value":"Las suscripciones se renuevan automáticamente salvo que se cancelen antes del final del periodo actual. Gestiónalas o cancélalas en los ajustes de tu cuenta de Google Play."}},"ja":{"stringUnit":{"state":"needs_review","value":"サブスクリプションは、現在の期間終了前に解約しない限り自動更新されます。Google Playのアカウント設定で管理または解約できます。"}},"de":{"stringUnit":{"state":"needs_review","value":"Abos verlängern sich automatisch, wenn sie nicht vor Ende des aktuellen Zeitraums gekündigt werden. Verwalten oder kündigen in deinen Google-Play-Kontoeinstellungen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Abonnementen worden automatisch verlengd, tenzij je ze voor het einde van de huidige periode opzegt. Beheer of zeg op in de instellingen van je Google Play-account."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"As assinaturas são renovadas automaticamente, a menos que sejam canceladas antes do fim do período atual. Gerencie ou cancele nos ajustes da sua conta do Google Play."}},"pl":{"stringUnit":{"state":"needs_review","value":"Subskrypcje odnawiają się automatycznie, chyba że zostaną anulowane przed końcem bieżącego okresu. Zarządzaj nimi lub anuluj w ustawieniach konta Google Play."}},"en":{"stringUnit":{"state":"needs_review","value":"Subscriptions renew automatically unless canceled before the end of the current period. Manage or cancel in your Google Play account settings."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les abonnements se renouvellent automatiquement sauf résiliation avant la fin de la période en cours. Gérez-les ou résiliez-les dans les réglages de votre compte Google Play."}},"da":{"stringUnit":{"state":"needs_review","value":"Abonnementer fornyes automatisk, medmindre de opsiges før udløbet af den aktuelle periode. Administrer eller opsig i dine Google Play-kontoindstillinger."}}}},"hint_subtitles_start_on_preferred_language":{"localizations":{"nl":{"stringUnit":{"state":"needs_review","value":"De ondertiteling start in de voorkeurstaal zodra de sporen van een scène bekend zijn. De weergave geldt voor elke speler op deze Apple TV."}},"it":{"stringUnit":{"state":"needs_review","value":"I sottotitoli partono nella lingua preferita appena le tracce di una scena sono note. L'aspetto vale per ogni player su questa Apple TV."}},"pl":{"stringUnit":{"state":"needs_review","value":"Napisy zaczynają się w preferowanym języku, gdy tylko ścieżki sceny są znane. Wygląd dotyczy każdego odtwarzacza na tym Apple TV."}},"de":{"stringUnit":{"state":"needs_review","value":"Untertitel starten in der bevorzugten Sprache, sobald die Spuren einer Szene bekannt sind. Das Aussehen gilt für jeden Player auf diesem Apple TV."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상의 트랙이 확인되는 즉시 선호하는 언어로 자막이 시작됩니다. 모양은 이 Apple TV의 모든 플레이어에 적용됩니다."}},"da":{"stringUnit":{"state":"needs_review","value":"Undertekster starter på det foretrukne sprog, så snart en scenes spor er kendt. Udseendet gælder for alle afspillere på dette Apple TV."}},"ru":{"stringUnit":{"state":"needs_review","value":"Субтитры включаются на предпочитаемом языке, как только становятся известны дорожки сцены. Оформление применяется ко всем плеерам на этом Apple TV."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"As legendas começam no idioma preferido assim que as faixas de uma cena são conhecidas. A aparência vale para todos os players desta Apple TV."}},"es":{"stringUnit":{"state":"needs_review","value":"Los subtítulos empiezan en el idioma preferido en cuanto se conocen las pistas de la escena. El aspecto se aplica a todos los reproductores de este Apple TV."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les sous-titres démarrent dans la langue préférée dès que les pistes d'une scène sont connues. L'apparence s'applique à tous les lecteurs de cette Apple TV."}},"en":{"stringUnit":{"state":"needs_review","value":"Subtitles start on the preferred language as soon as a scene's tracks are known. The look applies to every player on this Apple TV."}},"nb":{"stringUnit":{"state":"needs_review","value":"Undertekster starter på det foretrukne språket så snart sporene til en scene er kjent. Utseendet gjelder alle spillere på denne Apple TV-en."}},"ja":{"stringUnit":{"state":"needs_review","value":"シーンのトラックが判明すると、字幕は優先言語で始まります。表示スタイルはこのApple TVのすべてのプレーヤーに適用されます。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Undertexter startar på önskat språk så snart en scens spår är kända. Utseendet gäller alla spelare på den här Apple TV:n."}},"tr":{"stringUnit":{"state":"needs_review","value":"Bir sahnenin izleri bilinir bilinmez altyazılar tercih edilen dilde başlar. Görünüm bu Apple TV'deki tüm oynatıcılara uygulanır."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"一旦得知短片的字幕軌，就會以偏好語言開始顯示字幕。外觀設定會套用至此 Apple TV 上的所有播放器。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"一旦得知短片的字幕轨道，字幕就会以首选语言开始显示。外观设置适用于此 Apple TV 上的所有播放器。"}}}},"hint_subtitles_start_on_preferred_language_as":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"一旦得知短片的字幕轨道，字幕就会以首选语言开始显示。外观设置适用于此电视上的所有播放器。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bir sahnenin izleri bilinir bilinmez altyazılar tercih edilen dilde başlar. Görünüm bu TV'deki tüm oynatıcılara uygulanır."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"一旦得知短片的字幕軌，就會以偏好語言開始顯示字幕。外觀設定會套用至此電視上的所有播放器。"}},"nl":{"stringUnit":{"state":"needs_review","value":"De ondertiteling start in de voorkeurstaal zodra de sporen van een scène bekend zijn. De weergave geldt voor elke speler op deze tv."}},"it":{"stringUnit":{"state":"needs_review","value":"I sottotitoli partono nella lingua preferita appena le tracce di una scena sono note. L'aspetto vale per ogni player su questa TV."}},"ru":{"stringUnit":{"state":"needs_review","value":"Субтитры включаются на предпочитаемом языке, как только становятся известны дорожки сцены. Оформление применяется ко всем плеерам на этом телевизоре."}},"es":{"stringUnit":{"state":"needs_review","value":"Los subtítulos empiezan en el idioma preferido en cuanto se conocen las pistas de la escena. El aspecto se aplica a todos los reproductores de este televisor."}},"pl":{"stringUnit":{"state":"needs_review","value":"Napisy zaczynają się w preferowanym języku, gdy tylko ścieżki sceny są znane. Wygląd dotyczy każdego odtwarzacza na tym telewizorze."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"As legendas começam no idioma preferido assim que as faixas de uma cena são conhecidas. A aparência vale para todos os players desta TV."}},"de":{"stringUnit":{"state":"needs_review","value":"Untertitel starten in der bevorzugten Sprache, sobald die Spuren einer Szene bekannt sind. Das Aussehen gilt für jeden Player auf diesem TV."}},"da":{"stringUnit":{"state":"needs_review","value":"Undertekster starter på det foretrukne sprog, så snart en scenes spor er kendt. Udseendet gælder for alle afspillere på dette tv."}},"en":{"stringUnit":{"state":"needs_review","value":"Subtitles start on the preferred language as soon as a scene's tracks are known. The look applies to every player on this TV."}},"sv":{"stringUnit":{"state":"needs_review","value":"Undertexter startar på önskat språk så snart en scens spår är kända. Utseendet gäller alla spelare på den här TV:n."}},"nb":{"stringUnit":{"state":"needs_review","value":"Undertekster starter på det foretrukne språket så snart sporene til en scene er kjent. Utseendet gjelder alle spillere på denne TV-en."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상의 트랙이 확인되는 즉시 선호하는 언어로 자막이 시작됩니다. 모양은 이 TV의 모든 플레이어에 적용됩니다."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les sous-titres démarrent dans la langue préférée dès que les pistes d'une scène sont connues. L'apparence s'applique à tous les lecteurs de ce téléviseur."}},"ja":{"stringUnit":{"state":"needs_review","value":"シーンのトラックが判明すると、字幕は優先言語で始まります。表示スタイルはこのテレビのすべてのプレーヤーに適用されます。"}}}},"hint_suggests_tags_based_on_how":{"localizations":{"fr":{"stringUnit":{"state":"needs_review","value":"Suggère des étiquettes selon la façon dont votre bibliothèque est déjà étiquetée, affiche sur la page d'une scène les scènes avec les mêmes performeurs, studio ou étiquettes, et ajoute les rangées Pour vous et Favoris oubliés sur l'accueil : des scènes choisies d'après vos lectures, vos compteurs O et vos notes, et des favoris que vous n'avez pas lus depuis un moment. Aucun service externe n'intervient."}},"en":{"stringUnit":{"state":"needs_review","value":"Suggests tags based on how your library is already tagged, shows scenes with the same performers, studio or tags on the scene page, and adds For You and Forgotten Favorites rows on Home: scenes picked from what you played, your O Counts and ratings, and favorites you have not played for a while. No outside service is involved."}},"es":{"stringUnit":{"state":"needs_review","value":"Sugiere etiquetas según cómo está etiquetada ya tu biblioteca, muestra en la página de la escena escenas con los mismos intérpretes, estudio o etiquetas, y añade a Inicio las filas Para ti y Favoritos olvidados: escenas elegidas a partir de lo que has reproducido, tus contadores O y valoraciones, y favoritos que no has reproducido desde hace tiempo. No interviene ningún servicio externo."}},"sv":{"stringUnit":{"state":"needs_review","value":"Föreslår taggar utifrån hur ditt bibliotek redan är taggat, visar scener med samma stjärnor, studio eller taggar på scensidan och lägger till raderna För dig och Glömda favoriter på Hem: scener utvalda utifrån vad du har spelat, dina O-räknare och betyg samt favoriter du inte har spelat på ett tag. Ingen extern tjänst används."}},"de":{"stringUnit":{"state":"needs_review","value":"Schlägt Tags vor, je nachdem, wie deine Bibliothek schon getaggt ist, zeigt auf der Szenenseite Szenen mit denselben Darstellern, demselben Studio oder denselben Tags und fügt auf Start die Zeilen Für dich und Vergessene Favoriten hinzu: Szenen, ausgewählt aus dem, was du gespielt hast, deinen O-Zählern und Bewertungen, und Favoriten, die du länger nicht gespielt hast. Kein externer Dienst ist beteiligt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Proponuje tagi na podstawie tego, jak biblioteka jest już otagowana, pokazuje na stronie sceny sceny z tymi samymi aktorami, studiem lub tagami oraz dodaje na ekranie Start wiersze Dla Ciebie i Zapomniane ulubione: sceny wybrane na podstawie tego, co odtwarzałeś, Twoich liczników O i ocen, oraz ulubione, których dawno nie odtwarzałeś. Żadna zewnętrzna usługa nie jest używana."}},"it":{"stringUnit":{"state":"needs_review","value":"Suggerisce tag in base a come è già taggata la tua libreria, mostra nella pagina della scena scene con gli stessi performer, studio o tag e aggiunge alla Home le righe Per te e Preferiti dimenticati: scene scelte in base a ciò che hai riprodotto, ai tuoi contatori O e alle valutazioni, e preferiti che non riproduci da un po'. Non viene usato alcun servizio esterno."}},"nb":{"stringUnit":{"state":"needs_review","value":"Foreslår tagger basert på hvordan biblioteket ditt allerede er tagget, viser scener med de samme utøverne, studioet eller taggene på scenesiden, og legger til radene For deg og Glemte favoritter på Hjem: scener valgt ut fra det du har spilt, O-tellerne og vurderingene dine, og favoritter du ikke har spilt på en stund. Ingen eksterne tjenester er involvert."}},"ko":{"stringUnit":{"state":"needs_review","value":"라이브러리에 이미 지정된 태그를 바탕으로 태그를 제안하고, 영상 페이지에 같은 배우, 스튜디오 또는 태그가 있는 영상을 표시하며, 홈에 맞춤 추천 및 잊힌 즐겨찾기 행을 추가합니다. 재생한 영상, O 카운트 및 별점을 바탕으로 선택한 영상과 한동안 재생하지 않은 즐겨찾기입니다. 외부 서비스는 사용하지 않습니다."}},"da":{"stringUnit":{"state":"needs_review","value":"Foreslår tags ud fra, hvordan dit bibliotek allerede er tagget, viser scener med de samme kunstnere, studie eller tags på scenesiden og tilføjer rækkerne Til dig og Glemte favoritter på Hjem: scener udvalgt ud fra det, du har afspillet, dine O-tællere og bedømmelser, og favoritter, du ikke har afspillet i et stykke tid. Ingen ekstern tjeneste er involveret."}},"ja":{"stringUnit":{"state":"needs_review","value":"ライブラリの既存のタグ付けをもとにタグを提案し、シーンのページに同じ出演者、スタジオ、タグのシーンを表示し、ホームに「おすすめ」と「忘れられたお気に入り」の行を追加します：再生履歴、Oカウント、評価から選んだシーンと、しばらく再生していないお気に入りです。外部サービスは使用しません。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sugere etiquetas com base em como sua biblioteca já está etiquetada, mostra cenas com os mesmos artistas, estúdio ou etiquetas na página da cena e adiciona as linhas Para você e Favoritos esquecidos ao Início: cenas escolhidas a partir do que você reproduziu, suas contagens O e avaliações, e favoritos que você não reproduz há algum tempo. Nenhum serviço externo é usado."}},"nl":{"stringUnit":{"state":"needs_review","value":"Stelt labels voor op basis van hoe je bibliotheek al is gelabeld, toont op de scènepagina scènes met dezelfde performers, studio of labels en voegt de rijen 'Voor jou' en 'Vergeten favorieten' toe aan Home: scènes gekozen uit wat je hebt afgespeeld, je O-tellers en beoordelingen, en favorieten die je een tijd niet hebt afgespeeld. Er is geen externe dienst bij betrokken."}},"ru":{"stringUnit":{"state":"needs_review","value":"Предлагает теги на основе того, как уже размечена ваша библиотека, показывает на странице сцены сцены с теми же исполнителями, студией или тегами и добавляет на главную ряды «Для вас» и «Забытое избранное»: сцены, подобранные по вашим воспроизведениям, O и рейтингам, и избранное, которое вы давно не смотрели. Внешние сервисы не используются."}},"tr":{"stringUnit":{"state":"needs_review","value":"Kütüphanenin mevcut etiketlenmesine göre etiket önerir, sahne sayfasında aynı oyuncuları, stüdyoyu veya etiketleri içeren sahneleri gösterir ve Ana Sayfa'ya Sana Özel ve Unutulan Favoriler satırlarını ekler: oynattıklarından, O Sayılarından ve puanlarından seçilen sahneler ve bir süredir oynatmadığın favoriler. Hiçbir dış hizmet kullanılmaz."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"根据你的资料库已有的标签方式建议标签，在短片页面显示具有相同演员、工作室或标签的短片，并在主页添加“为你推荐”和“被遗忘的最爱”行：根据你的播放内容、O 计数和评分挑选的短片，以及你有一段时间没有播放的最爱。不涉及任何外部服务。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"依據你資料庫現有的標籤方式建議標籤，在短片頁面顯示具有相同演員、工作室或標籤的短片，並在首頁加入「為你推薦」和「被遺忘的最愛」列：依據你的播放紀錄、O 計數和評分挑選的短片，以及你一段時間沒播放的最愛。不涉及任何外部服務。"}}}},"hint_support_stashy_tips_do_not":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"支持 stashy。打赏不会解锁 stashy+。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"支持 stashy。小費不會解鎖 stashy+。"}},"tr":{"stringUnit":{"state":"needs_review","value":"stashy'yi destekle. Bahşişler stashy+'nın kilidini açmaz."}},"ja":{"stringUnit":{"state":"needs_review","value":"stashyを応援しましょう。チップではstashy+はロック解除されません。"}},"it":{"stringUnit":{"state":"needs_review","value":"Sostieni stashy. Le mance non sbloccano stashy+."}},"nl":{"stringUnit":{"state":"needs_review","value":"Steun stashy. Fooien ontgrendelen stashy+ niet."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Apoie o stashy. Gorjetas não desbloqueiam o stashy+."}},"es":{"stringUnit":{"state":"needs_review","value":"Apoya a stashy. Las propinas no desbloquean stashy+."}},"ko":{"stringUnit":{"state":"needs_review","value":"stashy를 후원하세요. 팁으로는 stashy+가 잠금 해제되지 않습니다."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wesprzyj stashy. Napiwki nie odblokowują stashy+."}},"en":{"stringUnit":{"state":"needs_review","value":"Support stashy. Tips do not unlock stashy+."}},"sv":{"stringUnit":{"state":"needs_review","value":"Stöd stashy. Dricks låser inte upp stashy+."}},"ru":{"stringUnit":{"state":"needs_review","value":"Поддержите stashy. Чаевые не открывают stashy+."}},"da":{"stringUnit":{"state":"needs_review","value":"Støt stashy. Drikkepenge låser ikke stashy+ op."}},"de":{"stringUnit":{"state":"needs_review","value":"Unterstütze stashy. Trinkgelder schalten stashy+ nicht frei."}},"fr":{"stringUnit":{"state":"needs_review","value":"Soutenez stashy. Les pourboires ne débloquent pas stashy+."}},"nb":{"stringUnit":{"state":"needs_review","value":"Støtt stashy. Tips låser ikke opp stashy+."}}}},"hint_tag_is_added_to_arg":{"localizations":{"da":{"stringUnit":{"state":"needs_review","value":"Tagget føjes til %@ af %@. Elementer, der allerede har det, forbliver uændrede."}},"es":{"stringUnit":{"state":"needs_review","value":"La etiqueta se añade a %@ de %@. Los elementos que ya la tienen no cambian."}},"nl":{"stringUnit":{"state":"needs_review","value":"Het label wordt toegevoegd aan %@ van %@. Items die het al hebben, blijven ongewijzigd."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Tag wird %@ von %@ hinzugefügt. Elemente, die ihn schon haben, bleiben unverändert."}},"en":{"stringUnit":{"state":"needs_review","value":"The tag is added to %@ of %@. Items that already have it stay unchanged."}},"fr":{"stringUnit":{"state":"needs_review","value":"L'étiquette est ajoutée à %@ sur %@. Les éléments qui l'ont déjà restent inchangés."}},"ja":{"stringUnit":{"state":"needs_review","value":"タグは%2$@件中%1$@件に追加されます。すでにタグがある項目は変更されません。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Taggen legges til i %@ av %@. Elementer som allerede har den, forblir uendret."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"A etiqueta será adicionada a %@ de %@. Itens que já a têm ficam inalterados."}},"pl":{"stringUnit":{"state":"needs_review","value":"Tag zostanie dodany do %@ z %@. Elementy, które już go mają, pozostaną bez zmian."}},"ru":{"stringUnit":{"state":"needs_review","value":"Тег будет добавлен к %@ из %@. Объекты, у которых он уже есть, не изменятся."}},"sv":{"stringUnit":{"state":"needs_review","value":"Taggen läggs till på %@ av %@. Objekt som redan har den lämnas oförändrade."}},"ko":{"stringUnit":{"state":"needs_review","value":"태그가 %2$@개 중 %1$@개에 추가됩니다. 이미 태그가 있는 항목은 변경되지 않습니다."}},"it":{"stringUnit":{"state":"needs_review","value":"Il tag viene aggiunto a %@ di %@. Gli elementi che lo hanno già restano invariati."}},"tr":{"stringUnit":{"state":"needs_review","value":"Etiket şunlara eklenir: %@ (%@). Etiketi zaten olan öğeler değişmez."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"标签将添加到 %2$@ 中的 %1$@。已有此标签的项目保持不变。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"標籤已加入 %2$@ 個中的 %1$@ 個項目。已有此標籤的項目保持不變。"}}}},"hint_teleprompter_requires_ios_26_or":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"提詞機需要 iOS 26 或以上版本。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"提词器需要 iOS 26 或更高版本。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Teleprompter için iOS 26 veya daha yenisi gerekir."}},"es":{"stringUnit":{"state":"needs_review","value":"El teleprompter requiere iOS 26 o posterior."}},"de":{"stringUnit":{"state":"needs_review","value":"Teleprompter benötigt iOS 26 oder neuer."}},"it":{"stringUnit":{"state":"needs_review","value":"Il teleprompter richiede iOS 26 o versioni successive."}},"da":{"stringUnit":{"state":"needs_review","value":"Teleprompter kræver iOS 26 eller nyere."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le téléprompteur nécessite iOS 26 ou une version ultérieure."}},"nb":{"stringUnit":{"state":"needs_review","value":"Teleprompter krever iOS 26 eller nyere."}},"sv":{"stringUnit":{"state":"needs_review","value":"Teleprompter kräver iOS 26 eller senare."}},"ko":{"stringUnit":{"state":"needs_review","value":"텔레프롬프터를 사용하려면 iOS 26 이상이 필요합니다."}},"en":{"stringUnit":{"state":"needs_review","value":"Teleprompter requires iOS 26 or newer."}},"ru":{"stringUnit":{"state":"needs_review","value":"Для телесуфлера требуется iOS 26 или новее."}},"ja":{"stringUnit":{"state":"needs_review","value":"テレプロンプターにはiOS 26以降が必要です。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Teleprompter wymaga systemu iOS 26 lub nowszego."}},"nl":{"stringUnit":{"state":"needs_review","value":"Teleprompter vereist iOS 26 of nieuwer."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O teleprompter requer iOS 26 ou posterior."}}}},"hint_teleprompter_requires_ios_26_plus":{"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Teleprompter benötigt iOS 26+ und unterstützte Hardware"}},"ko":{"stringUnit":{"state":"needs_review","value":"텔레프롬프터를 사용하려면 iOS 26 이상과 지원되는 하드웨어가 필요합니다"}},"nb":{"stringUnit":{"state":"needs_review","value":"Teleprompter krever iOS 26+ og støttet maskinvare"}},"ja":{"stringUnit":{"state":"needs_review","value":"テレプロンプターにはiOS 26以降と対応ハードウェアが必要です"}},"sv":{"stringUnit":{"state":"needs_review","value":"Teleprompter kräver iOS 26+ och hårdvara som stöds"}},"fr":{"stringUnit":{"state":"needs_review","value":"Le téléprompteur nécessite iOS 26+ et un matériel compatible"}},"pl":{"stringUnit":{"state":"needs_review","value":"Teleprompter wymaga iOS 26+ i obsługiwanego sprzętu"}},"en":{"stringUnit":{"state":"needs_review","value":"Teleprompter requires iOS 26+ and supported hardware"}},"da":{"stringUnit":{"state":"needs_review","value":"Teleprompter kræver iOS 26+ og understøttet hardware"}},"es":{"stringUnit":{"state":"needs_review","value":"El teleprompter requiere iOS 26+ y hardware compatible"}},"ru":{"stringUnit":{"state":"needs_review","value":"Для телесуфлера требуется iOS 26+ и поддерживаемое оборудование"}},"nl":{"stringUnit":{"state":"needs_review","value":"Teleprompter vereist iOS 26+ en ondersteunde hardware"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O teleprompter requer iOS 26+ e hardware compatível"}},"it":{"stringUnit":{"state":"needs_review","value":"Il teleprompter richiede iOS 26+ e hardware supportato"}},"tr":{"stringUnit":{"state":"needs_review","value":"Teleprompter için iOS 26+ ve desteklenen donanım gerekir"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"提词器需要 iOS 26+ 及受支持的硬件"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"提詞機需要 iOS 26 以上版本及支援的硬體"}}}},"hint_terms_follow_stashs_own_interface":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"用語遵循 Stash 本身的介面，並以其社群翻譯（Weblate）作為各語言的參考。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Terimler Stash'in kendi arayüzünü izler; her dil için topluluk çevirileri (Weblate) referans alınır."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"术语遵循 Stash 自身界面，其社区翻译（Weblate）作为各语言的参考。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Termerna följer Stashs eget gränssnitt, och dess communityöversättningar (Weblate) fungerar som referens för varje språk."}},"es":{"stringUnit":{"state":"needs_review","value":"Los términos siguen la propia interfaz de Stash, y sus traducciones de la comunidad (Weblate) sirven de referencia para cada idioma."}},"it":{"stringUnit":{"state":"needs_review","value":"I termini seguono l'interfaccia di Stash, e le sue traduzioni della community (Weblate) fanno da riferimento per ogni lingua."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les termes suivent l'interface de Stash, et ses traductions communautaires (Weblate) servent de référence pour chaque langue."}},"de":{"stringUnit":{"state":"needs_review","value":"Die Begriffe folgen Stashs eigener Oberfläche, und deren Community-Übersetzungen (Weblate) dienen als Referenz für jede Sprache."}},"pl":{"stringUnit":{"state":"needs_review","value":"Terminy są zgodne z interfejsem Stash, a jego tłumaczenia społeczności (Weblate) służą jako wzorzec dla każdego języka."}},"en":{"stringUnit":{"state":"needs_review","value":"Terms follow Stash's own interface, and its community translations (Weblate) serve as the reference for each language."}},"nb":{"stringUnit":{"state":"needs_review","value":"Begrepene følger Stashs eget grensesnitt, og fellesskapsoversettelsene (Weblate) brukes som referanse for hvert språk."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Os termos seguem a própria interface do Stash, e suas traduções da comunidade (Weblate) servem de referência para cada idioma."}},"ja":{"stringUnit":{"state":"needs_review","value":"用語はStash自体のインターフェイスに準拠し、各言語ではそのコミュニティ翻訳（Weblate）を参考にしています。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Термины следуют интерфейсу Stash, а его переводы от сообщества (Weblate) служат образцом для каждого языка."}},"nl":{"stringUnit":{"state":"needs_review","value":"De termen volgen de interface van Stash zelf, en de communityvertalingen daarvan (Weblate) dienen als referentie voor elke taal."}},"ko":{"stringUnit":{"state":"needs_review","value":"용어는 Stash 자체 인터페이스를 따르며, 각 언어의 커뮤니티 번역(Weblate)을 참고합니다."}},"da":{"stringUnit":{"state":"needs_review","value":"Begreberne følger Stashs egen brugerflade, og dens fællesskabsoversættelser (Weblate) fungerer som reference for hvert sprog."}}}},"hint_thank_you_for_your_support":{"localizations":{"da":{"stringUnit":{"state":"needs_review","value":"Tak for din støtte! ❤️"}},"nb":{"stringUnit":{"state":"needs_review","value":"Takk for støtten! ❤️"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Obrigado pelo seu apoio! ❤️"}},"nl":{"stringUnit":{"state":"needs_review","value":"Bedankt voor je steun! ❤️"}},"it":{"stringUnit":{"state":"needs_review","value":"Grazie per il tuo supporto! ❤️"}},"ko":{"stringUnit":{"state":"needs_review","value":"후원해 주셔서 감사합니다! ❤️"}},"ja":{"stringUnit":{"state":"needs_review","value":"ご支援ありがとうございます！❤️"}},"en":{"stringUnit":{"state":"needs_review","value":"Thank you for your support! ❤️"}},"ru":{"stringUnit":{"state":"needs_review","value":"Спасибо за поддержку! ❤️"}},"de":{"stringUnit":{"state":"needs_review","value":"Danke für deine Unterstützung! ❤️"}},"es":{"stringUnit":{"state":"needs_review","value":"¡Gracias por tu apoyo! ❤️"}},"fr":{"stringUnit":{"state":"needs_review","value":"Merci pour votre soutien ! ❤️"}},"pl":{"stringUnit":{"state":"needs_review","value":"Dziękujemy za wsparcie! ❤️"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"感謝你的支持！❤️"}},"sv":{"stringUnit":{"state":"needs_review","value":"Tack för ditt stöd! ❤️"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"感谢你的支持！❤️"}},"tr":{"stringUnit":{"state":"needs_review","value":"Desteğin için teşekkürler! ❤️"}}}},"hint_these_images_will_be_permanently":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"這些圖片將被永久刪除。此動作無法還原。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Bilderna raderas permanent. Det går inte att ångra."}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu resimler kalıcı olarak silinecek. Bu işlem geri alınamaz."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"这些图片将被永久删除。此操作无法撤销。"}},"pl":{"stringUnit":{"state":"needs_revi