:{"stringUnit":{"state":"needs_review","value":"Serveurs et réglages exportés depuis stashy sur un autre appareil (iPhone, iPad, Mac ou Android)."}},"pl":{"stringUnit":{"state":"needs_review","value":"Serwery i ustawienia wyeksportowane ze stashy na innym urządzeniu (iPhone, iPad, Mac lub Android)."}},"nb":{"stringUnit":{"state":"needs_review","value":"Servere og innstillinger eksportert fra stashy på en annen enhet (iPhone, iPad, Mac eller Android)."}},"it":{"stringUnit":{"state":"needs_review","value":"Server e impostazioni esportati da stashy su un altro dispositivo (iPhone, iPad, Mac o Android)."}},"es":{"stringUnit":{"state":"needs_review","value":"Servidores y ajustes exportados desde stashy en otro dispositivo (iPhone, iPad, Mac o Android)."}},"da":{"stringUnit":{"state":"needs_review","value":"Servere og indstillinger eksporteret fra stashy på en anden enhed (iPhone, iPad, Mac eller Android)."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Servidores e ajustes exportados do stashy em outro dispositivo (iPhone, iPad, Mac ou Android)."}},"de":{"stringUnit":{"state":"needs_review","value":"Server und Einstellungen, exportiert aus stashy auf einem anderen Gerät (iPhone, iPad, Mac oder Android)."}},"ja":{"stringUnit":{"state":"needs_review","value":"別のデバイス（iPhone、iPad、Mac、Android）のstashyから書き出したサーバーと設定。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Servers en instellingen geëxporteerd uit stashy op een ander apparaat (iPhone, iPad, Mac of Android)."}},"ko":{"stringUnit":{"state":"needs_review","value":"다른 기기(iPhone, iPad, Mac 또는 Android)의 stashy에서 내보낸 서버 및 설정입니다."}},"en":{"stringUnit":{"state":"needs_review","value":"Servers and settings exported from stashy on another device (iPhone, iPad, Mac or Android)."}}}},"hint_servers_api_keys_and_settings":{"localizations":{"ru":{"stringUnit":{"state":"needs_review","value":"Серверы, ключи API и настройки в любом случае остаются на этом устройстве."}},"de":{"stringUnit":{"state":"needs_review","value":"Server, API-Schlüssel und Einstellungen bleiben in jedem Fall auf diesem Gerät."}},"da":{"stringUnit":{"state":"needs_review","value":"Servere, API-nøgler og indstillinger bliver under alle omstændigheder på denne enhed."}},"it":{"stringUnit":{"state":"needs_review","value":"Server, chiavi API e impostazioni restano comunque su questo dispositivo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les serveurs, clés API et réglages restent sur cet appareil dans tous les cas."}},"pl":{"stringUnit":{"state":"needs_review","value":"Serwery, klucze API i ustawienia i tak pozostają na tym urządzeniu."}},"nb":{"stringUnit":{"state":"needs_review","value":"Servere, API-nøkler og innstillinger blir uansett værende på denne enheten."}},"ko":{"stringUnit":{"state":"needs_review","value":"어떤 경우든 서버, API 키 및 설정은 이 기기에 남아 있습니다."}},"nl":{"stringUnit":{"state":"needs_review","value":"Servers, API-sleutels en instellingen blijven hoe dan ook op dit apparaat."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Servidores, chaves de API e ajustes ficam neste dispositivo de qualquer forma."}},"ja":{"stringUnit":{"state":"needs_review","value":"どちらの場合も、サーバー、APIキー、設定はこのデバイスに残ります。"}},"es":{"stringUnit":{"state":"needs_review","value":"Los servidores, las claves de API y los ajustes se quedan en este dispositivo en cualquier caso."}},"en":{"stringUnit":{"state":"needs_review","value":"Servers, API keys and settings stay on this device either way."}},"sv":{"stringUnit":{"state":"needs_review","value":"Servrar, API-nycklar och inställningar stannar på den här enheten i båda fallen."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"無論如何，伺服器、API 金鑰和設定都會保留在此裝置上。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sunucular, API anahtarları ve ayarlar her durumda bu aygıtta kalır."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"无论如何，服务器、API 密钥和设置都会保留在此设备上。"}}}},"hint_servers_settings_default_filters_dashboard":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Sunucular, ayarlar, varsayılan filtreler, Dashboard ve sekmeler tek bir JSON dosyası olarak — iPhone, iPad, Mac ve Android'de içe aktarılabilir."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"伺服器、設定、預設篩選條件、Dashboard 和標籤頁會匯出為一個 JSON 檔案 — 可在 iPhone、iPad、Mac 和 Android 上匯入。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"将服务器、设置、默认过滤器、Dashboard 和标签页存为一个 JSON 文件 — 可在 iPhone、iPad、Mac 和 Android 上导入。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Servrar, inställningar, standardfilter, Dashboard och flikar som en JSON-fil – kan importeras på iPhone, iPad, Mac och Android."}},"fr":{"stringUnit":{"state":"needs_review","value":"Serveurs, réglages, filtres par défaut, Dashboard et onglets dans un seul fichier JSON — importable sur iPhone, iPad, Mac et Android."}},"da":{"stringUnit":{"state":"needs_review","value":"Servere, indstillinger, standardfiltre, Dashboard og faner som én JSON-fil – kan importeres på iPhone, iPad, Mac og Android."}},"en":{"stringUnit":{"state":"needs_review","value":"Servers, settings, default filters, dashboard and tabs as one JSON file — imports on iPhone, iPad, Mac and Android."}},"nb":{"stringUnit":{"state":"needs_review","value":"Servere, innstillinger, standardfiltre, Dashboard og faner som én JSON-fil – kan importeres på iPhone, iPad, Mac og Android."}},"pl":{"stringUnit":{"state":"needs_review","value":"Serwery, ustawienia, domyślne filtry, Dashboard i karty w jednym pliku JSON — do importu na iPhonie, iPadzie, Macu i Androidzie."}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバー、設定、デフォルトフィルター、Dashboard、タブを1つのJSONファイルにまとめます。iPhone、iPad、Mac、Androidで読み込めます。"}},"it":{"stringUnit":{"state":"needs_review","value":"Server, impostazioni, filtri predefiniti, dashboard e tab in un unico file JSON: si importa su iPhone, iPad, Mac e Android."}},"ko":{"stringUnit":{"state":"needs_review","value":"서버, 설정, 기본 필터, Dashboard 및 탭을 하나의 JSON 파일로 저장합니다. iPhone, iPad, Mac 및 Android에서 가져올 수 있습니다."}},"es":{"stringUnit":{"state":"needs_review","value":"Servidores, ajustes, filtros predeterminados, Dashboard y pestañas en un solo archivo JSON; se importa en iPhone, iPad, Mac y Android."}},"de":{"stringUnit":{"state":"needs_review","value":"Server, Einstellungen, Standardfilter, Dashboard und Tabs als eine JSON-Datei – importierbar auf iPhone, iPad, Mac und Android."}},"nl":{"stringUnit":{"state":"needs_review","value":"Servers, instellingen, standaardfilters, dashboard en tabs als één JSON-bestand – te importeren op iPhone, iPad, Mac en Android."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Servidores, ajustes, filtros padrão, Dashboard e abas em um único arquivo JSON — importável no iPhone, iPad, Mac e Android."}},"ru":{"stringUnit":{"state":"needs_review","value":"Серверы, настройки, фильтры по умолчанию, Dashboard и вкладки в одном файле JSON — импортируется на iPhone, iPad, Mac и Android."}}}},"hint_settings_already_in_icloud_replace":{"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Einstellungen, die schon in iCloud liegen, ersetzen die auf diesem Gerät. API-Schlüssel sind über den iCloud-Schlüsselbund Ende-zu-Ende-verschlüsselt; er muss für ihre Synchronisierung aktiv sein."}},"pl":{"stringUnit":{"state":"needs_review","value":"Ustawienia już zapisane w iCloud zastąpią te na tym urządzeniu. Klucze API są szyfrowane end-to-end przez pęk kluczy iCloud, który musi być włączony, aby były synchronizowane."}},"da":{"stringUnit":{"state":"needs_review","value":"Indstillinger, der allerede er i iCloud, erstatter dem på denne enhed. API-nøgler er end-to-end-krypteret via iCloud-nøglering, som skal være slået til, for at de synkroniseres."}},"ru":{"stringUnit":{"state":"needs_review","value":"Настройки, уже сохраненные в iCloud, заменят настройки на этом устройстве. Ключи API защищены сквозным шифрованием через Связку ключей iCloud — она должна быть включена для их синхронизации."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Os ajustes que já estão no iCloud substituem os deste dispositivo. As chaves de API são criptografadas de ponta a ponta pelas Chaves do iCloud, que precisam estar ativadas para sincronizá-las."}},"es":{"stringUnit":{"state":"needs_review","value":"Los ajustes que ya están en iCloud reemplazan los de este dispositivo. Las claves de API se cifran de extremo a extremo con el llavero de iCloud, que debe estar activado para que se sincronicen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Instellingen die al in iCloud staan, vervangen die op dit apparaat. API-sleutels worden end-to-end versleuteld via iCloud-sleutelhanger, die aan moet staan om ze te synchroniseren."}},"nb":{"stringUnit":{"state":"needs_review","value":"Innstillinger som allerede ligger i iCloud, erstatter dem på denne enheten. API-nøkler er ende-til-ende-kryptert via iCloud-nøkkelring, som må være på for at de skal synkroniseres."}},"ja":{"stringUnit":{"state":"needs_review","value":"iCloudにすでにある設定が、このデバイスの設定を置き換えます。APIキーはiCloudキーチェーンでエンドツーエンド暗号化されます。同期するにはiCloudキーチェーンをオンにする必要があります。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Les réglages déjà présents dans iCloud remplacent ceux de cet appareil. Les clés API sont chiffrées de bout en bout via le trousseau iCloud, qui doit être activé pour les synchroniser."}},"it":{"stringUnit":{"state":"needs_review","value":"Le impostazioni già presenti in iCloud sostituiscono quelle di questo dispositivo. Le chiavi API sono crittografate end-to-end tramite il portachiavi iCloud, che deve essere attivo per sincronizzarle."}},"en":{"stringUnit":{"state":"needs_review","value":"Settings already in iCloud replace the ones on this device. API keys are end-to-end encrypted through iCloud Keychain, which must be on for them to sync."}},"ko":{"stringUnit":{"state":"needs_review","value":"iCloud에 이미 있는 설정이 이 기기의 설정을 대체합니다. API 키는 iCloud 키체인을 통해 종단 간 암호화되며, 동기화하려면 iCloud 키체인이 켜져 있어야 합니다."}},"sv":{"stringUnit":{"state":"needs_review","value":"Inställningar som redan finns i iCloud ersätter dem på den här enheten. API-nycklar krypteras från ände till ände via iCloud-nyckelring, som måste vara på för att de ska synkas."}},"tr":{"stringUnit":{"state":"needs_review","value":"iCloud'da zaten bulunan ayarlar bu aygıttakilerin yerini alır. API anahtarları iCloud Anahtar Zinciri ile uçtan uca şifrelenir; eşzamanlanmaları için bu özelliğin açık olması gerekir."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"iCloud 中已有的設定會取代此裝置上的設定。API 金鑰透過 iCloud 鑰匙圈進行端對端加密，必須開啟 iCloud 鑰匙圈才能同步。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"iCloud 中已有的设置将替换此设备上的设置。API 密钥通过 iCloud 钥匙串进行端到端加密，必须打开 iCloud 钥匙串才能同步它们。"}}}},"hint_show_edit_buttons_on_scene":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在短片詳細資訊卡片（演員、工作室、群組、圖庫、標籤、標題、描述）以及演員／工作室／標籤／群組／圖庫詳細資訊上顯示編輯按鈕。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在短片详细信息卡片（演员、工作室、集合、图库、标签、标题、描述）以及演员 / 工作室 / 标签 / 集合 / 图库详细信息页面上显示编辑按钮。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Visa redigeringsknappar på scenens detaljkort (stjärnor, studio, grupper, gallerier, taggar, titel, beskrivning) och på detaljsidor för stjärna/studio/tagg/grupp/galleri."}},"tr":{"stringUnit":{"state":"needs_review","value":"Sahne ayrıntı kartlarında (oyuncular, stüdyo, gruplar, galeriler, etiketler, başlık, açıklama) ve oyuncu / stüdyo / etiket / grup / galeri ayrıntılarında düzenleme düğmelerini göster."}},"fr":{"stringUnit":{"state":"needs_review","value":"Afficher les boutons de modification sur les cartes de détail des scènes (performeurs, studio, groupes, galeries, étiquettes, titre, description) et sur les pages de performeur / studio / étiquette / groupe / galerie."}},"da":{"stringUnit":{"state":"needs_review","value":"Vis redigeringsknapper på scenens detaljekort (kunstnere, studie, grupper, gallerier, tags, titel, beskrivelse) og på detaljesider for kunstner/studie/tag/gruppe/galleri."}},"ja":{"stringUnit":{"state":"needs_review","value":"シーン詳細のカード（出演者、スタジオ、グループ、ギャラリー、タグ、タイトル、説明）と、出演者 / スタジオ / タグ / グループ / ギャラリーの詳細に編集ボタンを表示します。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuj przyciski edycji na kartach szczegółów sceny (aktorzy, studio, grupy, galerie, tagi, tytuł, opis) oraz na stronach aktora / studia / tagu / grupy / galerii."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra i pulsanti di modifica nelle schede di dettaglio della scena (performer, studio, gruppi, gallerie, tag, titolo, descrizione) e nei dettagli di performer / studio / tag / gruppo / galleria."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostrar botões de edição nos cartões de detalhes da cena (artistas, estúdio, grupos, galerias, etiquetas, título, descrição) e nos detalhes de artista / estúdio / etiqueta / grupo / galeria."}},"en":{"stringUnit":{"state":"needs_review","value":"Show edit buttons on scene detail cards (performers, studio, groups, galleries, tags, title, description) and on performer / studio / tag / group / gallery detail."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toon wijzigknoppen op de kaarten van scènedetails (performers, studio, groepen, galerijen, labels, titel, beschrijving) en op de details van performers, studio's, labels, groepen en galerijen."}},"de":{"stringUnit":{"state":"needs_review","value":"Bearbeiten-Buttons auf den Karten der Szenendetails (Darsteller, Studio, Gruppen, Galerien, Tags, Titel, Beschreibung) und in den Details von Darstellern / Studios / Tags / Gruppen / Galerien anzeigen."}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra botones de edición en las tarjetas de detalle de la escena (intérpretes, estudio, grupos, galerías, etiquetas, título, descripción) y en el detalle de intérpretes, estudios, etiquetas, grupos y galerías."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상 세부사항 카드(배우, 스튜디오, 그룹, 갤러리, 태그, 제목, 설명)와 배우 / 스튜디오 / 태그 / 그룹 / 갤러리 세부사항에 편집 버튼을 표시합니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывать кнопки изменения на карточках сцены (исполнители, студия, группы, галереи, теги, название, описание) и на страницах исполнителя, студии, тега, группы и галереи."}},"nb":{"stringUnit":{"state":"needs_review","value":"Vis redigeringsknapper på kortene på scenesiden (utøvere, studio, grupper, gallerier, tagger, tittel, beskrivelse) og på detaljsidene for utøver / studio / tagg / gruppe / galleri."}}}},"hint_shows_all_arg_matching_search":{"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Zeigt alle %@, die zur Suche passen"}},"nl":{"stringUnit":{"state":"needs_review","value":"Toont alle %@ die bij de zoekopdracht passen"}},"nb":{"stringUnit":{"state":"needs_review","value":"Viser alle %@ som samsvarer med søket"}},"fr":{"stringUnit":{"state":"needs_review","value":"Affiche tous les résultats (%@) correspondant à la recherche"}},"ja":{"stringUnit":{"state":"needs_review","value":"検索に一致するすべての%@を表示します"}},"da":{"stringUnit":{"state":"needs_review","value":"Viser alle %@, der matcher søgningen"}},"ko":{"stringUnit":{"state":"needs_review","value":"검색과 일치하는 모든 %@ 보기"}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra tutti i risultati (%@) corrispondenti alla ricerca"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostra todos os %@ que correspondem à busca"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuje wszystkie %@ pasujące do wyszukiwania"}},"en":{"stringUnit":{"state":"needs_review","value":"Shows all %@ matching the search"}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra todos los %@ que coinciden con la búsqueda"}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывает все %@, соответствующие поиску"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"显示所有与搜索匹配的%@"}},"tr":{"stringUnit":{"state":"needs_review","value":"Aramayla eşleşen tüm %@ öğelerini gösterir"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"顯示所有符合搜尋的%@"}},"sv":{"stringUnit":{"state":"needs_review","value":"Visar alla %@ som matchar sökningen"}}}},"hint_shows_o_counts_of_your":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在“工具”中以月历形式显示你的短片和图片的 O 计数。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Araçlar'da sahnelerinin ve resimlerinin O Sayılarını aylık takvim olarak gösterir."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在「工具」中以月曆顯示你的短片和圖片的 O 計數。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Visar O-räknarna för dina scener och bilder som en månadskalender i Verktyg."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra le O delle tue scene e immagini come calendario mensile in Strumenti."}},"da":{"stringUnit":{"state":"needs_review","value":"Viser O-tællerne for dine scener og billeder som en månedskalender i Værktøjer."}},"fr":{"stringUnit":{"state":"needs_review","value":"Affiche les compteurs O de vos scènes et images sous forme de calendrier mensuel dans Outils."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostra as contagens O das suas cenas e imagens como um calendário mensal em Ferramentas."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toont de O-tellers van je scènes en afbeeldingen als maandkalender in Tools."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывает O ваших сцен и изображений в виде месячного календаря в «Инструментах»."}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra en Herramientas los contadores O de tus escenas e imágenes en un calendario mensual."}},"de":{"stringUnit":{"state":"needs_review","value":"Zeigt die O-Zähler deiner Szenen und Bilder als Monatskalender in Werkzeuge."}},"ja":{"stringUnit":{"state":"needs_review","value":"シーンと画像のOカウントを月間カレンダーとしてツールに表示します。"}},"en":{"stringUnit":{"state":"needs_review","value":"Shows the O Counts of your scenes and images as a month calendar in Tools."}},"ko":{"stringUnit":{"state":"needs_review","value":"도구에서 영상과 이미지의 O 카운트를 월별 달력으로 보여줍니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Viser O-tellerne for scenene og bildene dine som en månedskalender i Verktøy."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuje w Narzędziach liczniki O Twoich scen i obrazów jako kalendarz miesięczny."}}}},"hint_shows_similar_scenes_on_scene":{"localizations":{"da":{"stringUnit":{"state":"needs_review","value":"Viser lignende scener på scenesiden. Når en scene slutter, tilbydes en lignende som Næste."}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra escenas similares en la página de la escena. Cuando termina una escena, se ofrece una similar como siguiente."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostra cenas semelhantes na página da cena. Quando uma cena termina, uma semelhante é oferecida em A Seguir."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывает похожие сцены на странице сцены. Когда сцена заканчивается, похожая предлагается как следующая."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra scene simili nella pagina della scena. Quando una scena finisce, ne viene proposta una simile come prossima."}},"nb":{"stringUnit":{"state":"needs_review","value":"Viser lignende scener på scenesiden. Når en scene slutter, tilbys en lignende som neste."}},"ja":{"stringUnit":{"state":"needs_review","value":"シーンのページに類似シーンを表示します。シーンが終わると、類似シーンが「次に再生」として提示されます。"}},"en":{"stringUnit":{"state":"needs_review","value":"Shows similar scenes on the scene page. When a scene ends, a similar one is offered as Up Next."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toont vergelijkbare scènes op de scènepagina. Als een scène afloopt, wordt een vergelijkbare aangeboden als volgende."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuje podobne sceny na stronie sceny. Gdy scena się skończy, podobna jest proponowana jako następna."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상 페이지에 유사한 영상을 표시합니다. 영상이 끝나면 유사한 영상을 다음 항목으로 제안합니다."}},"de":{"stringUnit":{"state":"needs_review","value":"Zeigt ähnliche Szenen auf der Szenenseite. Endet eine Szene, wird eine ähnliche als Nächstes angeboten."}},"fr":{"stringUnit":{"state":"needs_review","value":"Affiche des scènes similaires sur la page d'une scène. À la fin d'une scène, une scène similaire est proposée en lecture suivante."}},"sv":{"stringUnit":{"state":"needs_review","value":"Visar liknande scener på scensidan. När en scen slutar erbjuds en liknande som Nästa."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在短片页面显示相似短片。短片结束时，会提供一个相似短片作为“接下来播放”。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sahne sayfasında benzer sahneleri gösterir. Bir sahne bittiğinde benzer bir sahne Sıradaki olarak önerilir."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在短片頁面顯示相似短片。短片結束時，會提供一部相似短片作為「下一部」。"}}}},"hint_shows_unrated_scenes_or_images":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Araçlar'da puanlanmamış sahneleri veya resimleri birer birer gösterir, böylece onlara yıldız verebilirsin."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在「工具」中逐一顯示未評分的短片或圖片，讓你以星等評分。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在“工具”中逐个显示未评分的短片或图片，方便你用星级为其评分。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostra cenas ou imagens sem avaliação, uma de cada vez, em Ferramentas, para você avaliá-las com estrelas."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывает в «Инструментах» неоцененные сцены или изображения по одному, чтобы вы оценили их звездами."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra scene o immagini non valutate una alla volta in Strumenti, così puoi valutarle con le stelle."}},"en":{"stringUnit":{"state":"needs_review","value":"Shows unrated scenes or images one at a time in Tools, so you can rate them with stars."}},"sv":{"stringUnit":{"state":"needs_review","value":"Visar obetygsatta scener eller bilder en i taget i Verktyg så att du kan betygsätta dem med stjärnor."}},"da":{"stringUnit":{"state":"needs_review","value":"Viser ubedømte scener eller billeder ét ad gangen i Værktøjer, så du kan bedømme dem med stjerner."}},"fr":{"stringUnit":{"state":"needs_review","value":"Affiche une à une les scènes ou images sans note dans Outils, pour que vous les notiez avec des étoiles."}},"nb":{"stringUnit":{"state":"needs_review","value":"Viser ikke-vurderte scener eller bilder ett om gangen i Verktøy, slik at du kan gi dem stjerner."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toont onbeoordeelde scènes of afbeeldingen een voor een in Tools, zodat je ze met sterren kunt beoordelen."}},"ja":{"stringUnit":{"state":"needs_review","value":"未評価のシーンや画像をツールで1つずつ表示し、星で評価できます。"}},"de":{"stringUnit":{"state":"needs_review","value":"Zeigt unbewertete Szenen oder Bilder einzeln in Werkzeuge, damit du sie mit Sternen bewerten kannst."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuje w Narzędziach nieocenione sceny lub obrazy pojedynczo, aby można było ocenić je gwiazdkami."}},"ko":{"stringUnit":{"state":"needs_review","value":"도구에서 별점이 없는 영상이나 이미지를 하나씩 보여주므로 별점을 매길 수 있습니다."}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra en Herramientas escenas o imágenes sin valorar, una a una, para que las valores con estrellas."}}}},"hint_shows_unrated_scenes_or_images_one":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Visar obetygsatta scener eller bilder en i taget under Upptäck så att du kan betygsätta dem med stjärnor."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuje w sekcji Odkrywaj nieocenione sceny lub obrazy pojedynczo, aby można było ocenić je gwiazdkami."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostra cenas ou imagens sem avaliação, uma de cada vez, em Descobrir, para você avaliá-las com estrelas."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toont onbeoordeelde scènes of afbeeldingen een voor een onder Ontdek, zodat je ze met sterren kunt beoordelen."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra scene o immagini non valutate una alla volta in Scopri, così puoi valutarle con le stelle."}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra en Descubrir escenas o imágenes sin valorar, una a una, para que las valores con estrellas."}},"da":{"stringUnit":{"state":"needs_review","value":"Viser ubedømte scener eller billeder ét ad gangen under Opdag, så du kan bedømme dem med stjerner."}},"ko":{"stringUnit":{"state":"needs_review","value":"둘러보기에서 별점이 없는 영상이나 이미지를 하나씩 보여주므로 별점을 매길 수 있습니다."}},"de":{"stringUnit":{"state":"needs_review","value":"Zeigt unbewertete Szenen oder Bilder einzeln unter Entdecken, damit du sie mit Sternen bewerten kannst."}},"fr":{"stringUnit":{"state":"needs_review","value":"Affiche une à une les scènes ou images sans note dans Découvrir, pour que vous les notiez avec des étoiles."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывает в разделе «Открытия» неоцененные сцены или изображения по одному, чтобы вы оценили их звездами."}},"en":{"stringUnit":{"state":"needs_review","value":"Shows unrated scenes or images one at a time under Discover, so you can rate them with stars."}},"ja":{"stringUnit":{"state":"needs_review","value":"未評価のシーンや画像を「見つける」で1つずつ表示し、星で評価できます。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Viser ikke-vurderte scener eller bilder ett om gangen under Utforsk, slik at du kan gi dem stjerner."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在「探索」中逐一顯示未評分的短片或圖片，讓你以星等評分。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Keşfet altında puanlanmamış sahneleri veya resimleri birer birer gösterir, böylece onlara yıldız verebilirsin."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在“发现”中逐个显示未评分的短片或图片，方便你用星级为其评分。"}}}},"hint_shows_your_library_at_glance":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Visar en snabböversikt över ditt bibliotek i Verktyg: uppspelning, antal i katalogen och lagring."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在“工具”中一览你的资料库：播放、目录数量和存储空间。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在「工具」中一覽你的資料庫：播放、目錄數量和儲存空間。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Araçlar'da kütüphaneni bir bakışta gösterir: oynatma, katalog sayıları ve depolama."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mostra sua biblioteca num relance em Ferramentas: reprodução, contagens do catálogo e armazenamento."}},"en":{"stringUnit":{"state":"needs_review","value":"Shows your library at a glance in Tools: playback, catalog counts and storage."}},"ja":{"stringUnit":{"state":"needs_review","value":"ライブラリの概要をツールに表示します：再生、カタログ件数、ストレージ。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Affiche votre bibliothèque en un coup d'œil dans Outils : lecture, nombres du catalogue et stockage."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pokazuje w Narzędziach szybki przegląd biblioteki: odtwarzanie, liczby w katalogu i miejsce na dysku."}},"da":{"stringUnit":{"state":"needs_review","value":"Viser dit bibliotek på et øjeblik i Værktøjer: afspilning, katalogtal og lagerplads."}},"es":{"stringUnit":{"state":"needs_review","value":"Muestra tu biblioteca de un vistazo en Herramientas: reproducción, recuentos del catálogo y almacenamiento."}},"nb":{"stringUnit":{"state":"needs_review","value":"Viser biblioteket ditt med et blikk i Verktøy: avspilling, antall i katalogene og lagring."}},"ru":{"stringUnit":{"state":"needs_review","value":"Показывает в «Инструментах» сводку библиотеки: воспроизведение, количество объектов и хранилище."}},"ko":{"stringUnit":{"state":"needs_review","value":"도구에서 라이브러리를 한눈에 보여줍니다: 재생, 카탈로그 개수 및 저장 공간."}},"de":{"stringUnit":{"state":"needs_review","value":"Zeigt deine Bibliothek auf einen Blick in Werkzeuge: Wiedergabe, Katalogzahlen und Speicher."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toont je bibliotheek in één oogopslag in Tools: afspelen, catalogusaantallen en opslag."}},"it":{"stringUnit":{"state":"needs_review","value":"Mostra la tua libreria a colpo d'occhio in Strumenti: riproduzione, numeri del catalogo e spazio."}}}},"hint_sign_in_to_icloud_on":{"localizations":{"nb":{"stringUnit":{"state":"needs_review","value":"Logg på iCloud på denne enheten for å synkronisere."}},"de":{"stringUnit":{"state":"needs_review","value":"Melde dich auf diesem Gerät bei iCloud an, um zu synchronisieren."}},"nl":{"stringUnit":{"state":"needs_review","value":"Log in bij iCloud op dit apparaat om te synchroniseren."}},"sv":{"stringUnit":{"state":"needs_review","value":"Logga in på iCloud på den här enheten för att synka."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zaloguj się do iCloud na tym urządzeniu, aby synchronizować."}},"ko":{"stringUnit":{"state":"needs_review","value":"동기화하려면 이 기기에서 iCloud에 로그인하세요."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Inicie sessão no iCloud neste dispositivo para sincronizar."}},"ja":{"stringUnit":{"state":"needs_review","value":"同期するには、このデバイスでiCloudにサインインしてください。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Connectez-vous à iCloud sur cet appareil pour synchroniser."}},"es":{"stringUnit":{"state":"needs_review","value":"Inicia sesión en iCloud en este dispositivo para sincronizar."}},"en":{"stringUnit":{"state":"needs_review","value":"Sign in to iCloud on this device to sync."}},"ru":{"stringUnit":{"state":"needs_review","value":"Для синхронизации войдите в iCloud на этом устройстве."}},"da":{"stringUnit":{"state":"needs_review","value":"Log ind på iCloud på denne enhed for at synkronisere."}},"it":{"stringUnit":{"state":"needs_review","value":"Accedi a iCloud su questo dispositivo per sincronizzare."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"请在此设备上登录 iCloud 以进行同步。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Eşzamanlamak için bu aygıtta iCloud'a giriş yap."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"請在此裝置上登入 iCloud 以進行同步。"}}}},"hint_slides_tab_bar_away_while":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Bir listede aşağı kaydırırken sekme çubuğunu gizler, yukarı kaydırınca geri getirir. Feeds'te (Pics hariç) üst çubuk da onunla gizlenir."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"向下捲動列表時隱藏標籤列，向上捲動時再顯示。在 Feeds 中（Pics 除外），頂部列也會一起隱藏。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Döljer flikfältet när du rullar nedåt i en lista och visar det igen när du rullar uppåt. I Feeds (utom Pics) döljs även det övre fältet."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"向下滚动列表时隐藏标签栏，向上滚动时重新显示。在 Feeds（Pics 除外）中，顶部栏也会随之隐藏。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Скрывает панель вкладок при прокрутке списка вниз и возвращает при прокрутке вверх. В Feeds (кроме Pics) вместе с ней скрывается верхняя панель."}},"es":{"stringUnit":{"state":"needs_review","value":"Oculta la barra de pestañas al desplazarte hacia abajo en una lista y la muestra de nuevo al desplazarte hacia arriba. En Feeds (salvo Pics), la barra superior se oculta con ella."}},"nl":{"stringUnit":{"state":"needs_review","value":"Schuift de tabbalk weg als je in een lijst omlaag scrolt en brengt hem terug als je omhoog scrolt. In Feeds (behalve Pics) verdwijnt de bovenste balk mee."}},"en":{"stringUnit":{"state":"needs_review","value":"Slides the tab bar away while you scroll down a list and brings it back when you scroll up. In Feeds (except Pics) the top bar hides with it."}},"fr":{"stringUnit":{"state":"needs_review","value":"Masque la barre d'onglets lorsque vous faites défiler une liste vers le bas et la ramène lorsque vous remontez. Dans Feeds (sauf Pics), la barre du haut se masque aussi."}},"da":{"stringUnit":{"state":"needs_review","value":"Skjuler fanelinjen, mens du ruller ned i en liste, og viser den igen, når du ruller op. I Feeds (undtagen Pics) skjules den øverste bjælke sammen med den."}},"de":{"stringUnit":{"state":"needs_review","value":"Schiebt die Tab-Leiste weg, während du in einer Liste nach unten scrollst, und holt sie beim Hochscrollen zurück. In Feeds (außer Pics) blendet sich die obere Leiste mit aus."}},"it":{"stringUnit":{"state":"needs_review","value":"Fa scorrere via la barra dei tab mentre scorri giù in un elenco e la riporta quando scorri su. In Feeds (tranne Pics) si nasconde anche la barra superiore."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Esconde a barra de abas enquanto você rola uma lista para baixo e a traz de volta ao rolar para cima. Em Feeds (exceto Pics), a barra superior se oculta junto."}},"nb":{"stringUnit":{"state":"needs_review","value":"Skyver fanelinjen bort når du ruller ned i en liste, og henter den tilbake når du ruller opp. I Feeds (unntatt Pics) skjules også topplinjen."}},"ko":{"stringUnit":{"state":"needs_review","value":"목록을 아래로 스크롤하면 탭 막대가 사라지고 위로 스크롤하면 다시 나타납니다. Feeds(Pics 제외)에서는 상단 막대도 함께 가려집니다."}},"pl":{"stringUnit":{"state":"needs_review","value":"Chowa pasek kart podczas przewijania listy w dół i przywraca go przy przewijaniu w górę. W Feeds (oprócz Pics) górny pasek chowa się razem z nim."}},"ja":{"stringUnit":{"state":"needs_review","value":"リストを下にスクロールするとタブバーを隠し、上にスクロールすると再表示します。Feeds（Picsを除く）では上部バーも一緒に隠れます。"}}}},"hint_sort_order_each_section_opens":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"各セクションを開いたときの並べ替え順です。"}},"en":{"stringUnit":{"state":"needs_review","value":"The sort order each section opens with."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"A ordenação com que cada seção abre."}},"de":{"stringUnit":{"state":"needs_review","value":"Die Sortierung, mit der jeder Bereich öffnet."}},"nl":{"stringUnit":{"state":"needs_review","value":"De sortering waarmee elk onderdeel opent."}},"pl":{"stringUnit":{"state":"needs_review","value":"Kolejność sortowania, z jaką otwiera się każda sekcja."}},"da":{"stringUnit":{"state":"needs_review","value":"Den sortering, hver sektion åbner med."}},"fr":{"stringUnit":{"state":"needs_review","value":"L'ordre de tri à l'ouverture de chaque section."}},"ko":{"stringUnit":{"state":"needs_review","value":"각 섹션이 열릴 때의 정렬 순서입니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Порядок сортировки при открытии каждого раздела."}},"it":{"stringUnit":{"state":"needs_review","value":"L'ordinamento con cui si apre ogni sezione."}},"nb":{"stringUnit":{"state":"needs_review","value":"Sorteringsrekkefølgen hver del åpnes med."}},"es":{"stringUnit":{"state":"needs_review","value":"El orden con el que se abre cada sección."}},"sv":{"stringUnit":{"state":"needs_review","value":"Sorteringen som varje sektion öppnas med."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"每個區段打開時使用的排序方式。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Her bölümün açıldığı sıralama düzeni."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"每个版块打开时使用的排序方式。"}}}},"hint_speech_model_download_failed_http":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"語音模型下載失敗（HTTP %@）"}},"tr":{"stringUnit":{"state":"needs_review","value":"Konuşma modeli indirilemedi (HTTP %@)"}},"sv":{"stringUnit":{"state":"needs_review","value":"Kunde inte ladda ner talmodellen (HTTP %@)"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"语音模型下载失败（HTTP %@）"}},"ko":{"stringUnit":{"state":"needs_review","value":"음성 모델 다운로드 실패(HTTP %@)"}},"da":{"stringUnit":{"state":"needs_review","value":"Download af talemodel mislykkedes (HTTP %@)"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Falha ao baixar o modelo de fala (HTTP %@)"}},"ja":{"stringUnit":{"state":"needs_review","value":"音声モデルのダウンロードに失敗しました（HTTP %@）"}},"fr":{"stringUnit":{"state":"needs_review","value":"Échec du téléchargement du modèle vocal (HTTP %@)"}},"nb":{"stringUnit":{"state":"needs_review","value":"Nedlasting av talemodell mislyktes (HTTP %@)"}},"ru":{"stringUnit":{"state":"needs_review","value":"Не удалось загрузить речевую модель (HTTP %@)"}},"de":{"stringUnit":{"state":"needs_review","value":"Laden des S