gUnit":{"state":"needs_review","value":"Wir prüfen, ob dein Server erreichbar ist"}},"en":{"stringUnit":{"state":"needs_review","value":"We're checking if your server is reachable"}},"sv":{"stringUnit":{"state":"needs_review","value":"Vi kontrollerar om din server kan nås"}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバーに接続できるか確認しています"}},"nb":{"stringUnit":{"state":"needs_review","value":"Vi sjekker om serveren din kan nås"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"我们正在检查你的服务器是否可访问"}},"pl":{"stringUnit":{"state":"needs_review","value":"Sprawdzamy, czy serwer jest osiągalny"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Estamos verificando se seu servidor está acessível"}},"da":{"stringUnit":{"state":"needs_review","value":"Vi tjekker, om din server kan nås"}},"nl":{"stringUnit":{"state":"needs_review","value":"We controleren of je server bereikbaar is"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"正在檢查是否能連上你的伺服器"}},"ar":{"stringUnit":{"state":"needs_review","value":"نتحقق مما إذا كان الخادم متاحًا"}},"fr":{"stringUnit":{"state":"needs_review","value":"Nous vérifions si votre serveur est joignable"}}}},"hint_with_api_keys_file_gives":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"包含 API 金鑰時，此檔案可完整存取你的伺服器。請妥善保管。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Com chaves de API, o arquivo dá acesso total aos seus servidores. Mantenha-o privado."}},"ar":{"stringUnit":{"state":"needs_review","value":"مع مفاتيح API يمنح الملف وصولًا كاملًا إلى خوادمك. احتفظ به خاصًا."}},"da":{"stringUnit":{"state":"needs_review","value":"Med API-nøgler giver filen fuld adgang til dine servere. Hold den privat."}},"ja":{"stringUnit":{"state":"needs_review","value":"APIキーを含むファイルは、サーバーへのフルアクセスを与えます。他人と共有しないでください。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Med API-nycklar ger filen full åtkomst till dina servrar. Håll den privat."}},"de":{"stringUnit":{"state":"needs_review","value":"Mit API-Schlüsseln gibt die Datei vollen Zugriff auf deine Server. Halte sie privat."}},"nl":{"stringUnit":{"state":"needs_review","value":"Met API-sleutels geeft het bestand volledige toegang tot je servers. Houd het privé."}},"pl":{"stringUnit":{"state":"needs_review","value":"Z kluczami API plik daje pełny dostęp do Twoich serwerów. Nie udostępniaj go."}},"en":{"stringUnit":{"state":"needs_review","value":"With API keys the file gives full access to your servers. Keep it private."}},"fr":{"stringUnit":{"state":"needs_review","value":"Avec les clés API, le fichier donne un accès complet à vos serveurs. Gardez-le privé."}},"nb":{"stringUnit":{"state":"needs_review","value":"Med API-nøkler gir filen full tilgang til serverne dine. Hold den privat."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"包含 API 密钥时，此文件可完全访问你的服务器。请妥善保管。"}}}},"hint_you_bought_stashy_before_it":{"localizations":{"da":{"stringUnit":{"state":"needs_review","value":"Du købte stashy, før appen gik over til abonnementer, så stashy+ er din for livet. Siden da er appen vokset enormt. Hvis du vil støtte udviklingen, er drikkepenge en venlig gestus – helt valgfrit."}},"ja":{"stringUnit":{"state":"needs_review","value":"サブスクリプション制に移行する前にstashyを購入されたため、stashy+はずっとご利用いただけます。それ以降、アプリは大きく成長しました。開発を応援していただける場合は、チップをいただけると嬉しいです（まったくの任意です）。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Du kjøpte stashy før appen gikk over til abonnement, så stashy+ er ditt for alltid. Siden den gang har appen vokst enormt. Hvis du vil støtte utviklingen, er et tips en hyggelig gest – helt valgfritt."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Você comprou o stashy antes de ele passar para assinaturas, então o stashy+ é seu para sempre. Desde então, o app cresceu muito. Se quiser apoiar o desenvolvimento, uma gorjeta é um gesto gentil, totalmente opcional."}},"de":{"stringUnit":{"state":"needs_review","value":"Du hast stashy vor der Umstellung auf Abos gekauft, daher bleibt stashy+ für immer deins. Seitdem ist die App enorm gewachsen. Wenn du die Entwicklung unterstützen möchtest, ist ein Trinkgeld eine nette Geste – ganz freiwillig."}},"ar":{"stringUnit":{"state":"needs_review","value":"لقد اشتريت stashy قبل انتقاله إلى الاشتراكات، لذا يبقى stashy+ لك مدى الحياة. منذ ذلك الحين نما التطبيق كثيرًا. إذا رغبت في دعم تطويره، فالإكرامية لفتة لطيفة واختيارية تمامًا."}},"sv":{"stringUnit":{"state":"needs_review","value":"Du köpte stashy innan appen gick över till prenumerationer, så stashy+ är ditt för alltid. Sedan dess har appen vuxit enormt. Om du vill stödja utvecklingen är dricks en vänlig gest, helt frivillig."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je hebt stashy gekocht voordat het overstapte op abonnementen, dus stashy+ blijft levenslang van jou. Sindsdien is de app enorm gegroeid. Wil je de ontwikkeling steunen, dan is een fooi een vriendelijk gebaar, geheel vrijblijvend."}},"fr":{"stringUnit":{"state":"needs_review","value":"Vous avez acheté stashy avant le passage aux abonnements, stashy+ vous reste donc acquis à vie. Depuis, l'app s'est énormément enrichie. Si vous souhaitez soutenir son développement, un pourboire est un geste apprécié, entièrement facultatif."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你在 stashy 改為訂閱制之前就已購買，因此 stashy+ 將終身屬於你。自那時起，App 已大幅成長。如果你想支持它的開發，給點小費是一份心意，完全自由選擇。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你在 stashy 改为订阅制之前就已购买，因此 stashy+ 永久归你所有。此后 App 已大幅成长。如果你愿意支持它的开发，打赏是一份心意，完全自愿。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Kupiłeś stashy, zanim przeszło na subskrypcje, więc stashy+ jest Twoje dożywotnio. Od tego czasu aplikacja bardzo się rozrosła. Jeśli chcesz wesprzeć jej rozwój, napiwek będzie miłym gestem — całkowicie opcjonalnym."}},"en":{"stringUnit":{"state":"needs_review","value":"You bought stashy before it moved to subscriptions, so stashy+ stays yours for life. Since then the app has grown massively. If you'd like to support its development, a tip is a kind gesture, entirely optional."}}}},"hint_your_api_key_is_invalid":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的 API 金鑰無效或已過期。請檢查你的伺服器設定。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Votre clé API est invalide ou a expiré. Vérifiez la configuration de votre serveur."}},"nb":{"stringUnit":{"state":"needs_review","value":"API-nøkkelen din er ugyldig eller utløpt. Sjekk serverkonfigurasjonen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua chave de API é inválida ou expirou. Verifique a configuração do servidor."}},"da":{"stringUnit":{"state":"needs_review","value":"Din API-nøgle er ugyldig eller udløbet. Tjek din serverkonfiguration."}},"ar":{"stringUnit":{"state":"needs_review","value":"مفتاح API غير صالح أو منتهي الصلاحية. يُرجى التحقق من تكوين الخادم."}},"en":{"stringUnit":{"state":"needs_review","value":"Your API key is invalid or expired. Please check your server configuration."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的 API 密钥无效或已过期。请检查服务器配置。"}},"de":{"stringUnit":{"state":"needs_review","value":"Dein API-Schlüssel ist ungültig oder abgelaufen. Prüfe deine Serverkonfiguration."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je API-sleutel is ongeldig of verlopen. Controleer de configuratie van je server."}},"ja":{"stringUnit":{"state":"needs_review","value":"APIキーが無効か、期限切れです。サーバー設定を確認してください。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Twój klucz API jest nieprawidłowy lub wygasł. Sprawdź konfigurację serwera."}},"sv":{"stringUnit":{"state":"needs_review","value":"Din API-nyckel är ogiltig eller har gått ut. Kontrollera serverkonfigurationen."}}}},"hint_your_license_key_expired_on":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Din licensnyckel gick ut %@."}},"da":{"stringUnit":{"state":"needs_review","value":"Din licensnøgle udløb den %@."}},"nb":{"stringUnit":{"state":"needs_review","value":"Lisensnøkkelen din utløp %@."}},"pt-BR":{"stringUnit":{"state":"n