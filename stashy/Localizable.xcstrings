ene mai riprodotte e scene che non hai riprodotto in questo periodo, con lo stesso peso."}},"pl":{"stringUnit":{"state":"needs_review","value":"Nieodtwarzane sceny i sceny nieodtwarzane w tym okresie, z tą samą wagą."}}}},"hint_update_profile_picture_for_selected":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"選択した出演者のプロフィール画像を更新します。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Atualizar a foto de perfil do artista selecionado."}},"ko":{"stringUnit":{"state":"needs_review","value":"선택한 배우의 프로필 사진을 업데이트합니다."}},"nl":{"stringUnit":{"state":"needs_review","value":"Werk de profielfoto van de geselecteerde performer bij."}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiorna l'immagine del profilo del performer selezionato."}},"en":{"stringUnit":{"state":"needs_review","value":"Update the profile picture for the selected performer."}},"da":{"stringUnit":{"state":"needs_review","value":"Opdater profilbilledet for den valgte kunstner."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zaktualizuj zdjęcie profilowe wybranego aktora."}},"fr":{"stringUnit":{"state":"needs_review","value":"Mettre à jour la photo de profil du performeur sélectionné."}},"de":{"stringUnit":{"state":"needs_review","value":"Profilbild des gewählten Darstellers aktualisieren."}},"ru":{"stringUnit":{"state":"needs_review","value":"Обновить изображение профиля выбранного исполнителя."}},"nb":{"stringUnit":{"state":"needs_review","value":"Oppdater profilbildet for den valgte utøveren."}},"es":{"stringUnit":{"state":"needs_review","value":"Actualiza la foto de perfil del intérprete seleccionado."}},"sv":{"stringUnit":{"state":"needs_review","value":"Uppdatera profilbilden för den valda stjärnan."}},"tr":{"stringUnit":{"state":"needs_review","value":"Seçili oyuncunun profil resmini güncelle."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"更新所選演員的個人圖片。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"更新所选演员的头像。"}}}},"hint_used_instead_