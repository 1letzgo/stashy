iew","value":"O Stash rejeitou o proxy reverso à sua frente. Adicione o IP do proxy a trusted_proxies na configuração do Stash."}},"ar":{"stringUnit":{"state":"needs_review","value":"رفض Stash الوكيل العكسي الموجود أمامه. أضف عنوان IP للوكيل إلى trusted_proxies في تكوين Stash."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"Stash 拒绝了其前面的反向代理。请将代理的 IP 添加到 Stash 配置中的 trusted_proxies。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Stash önündeki ters proxy'yi reddetti. Proxy'nin IP'sini Stash yapılandırmasındaki trusted_proxies'e ekle."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"Stash 拒絕了位於其前方的反向代理伺服器。請將代理伺服器的 IP 加入 Stash 設定中的 trusted_proxies。"}}}},"hint_stashy_arg_is_latest_version":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"stashy %@ 是最新版本。"}},"tr":{"stringUnit":{"state":"needs_review","value":"stashy %@ en son sürüm."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"stashy %@ 是最新版本。"}},"nl":{"stringUnit":{"state":"needs_review","value":"stashy %@ is de nieuwste versie."}},"en":{"stringUnit":{"state":"needs_review","value":"stashy %@ is the latest version."}},"sv":{"stringUnit":{"state":"needs_review","value":"stashy %@ är den senaste versionen."}},"da":{"stringUnit":{"state":"needs_review","value":"stashy %@ er den nyeste version."}},"ar":{"stringUnit":{"state":"needs_review","value":"stashy %@ هو أحدث إصدار."}},"pl":{"stringUnit":{"state":"needs_review","value":"stashy %@ to najnowsza wersja."}},"it":{"stringUnit":{"state":"needs_review","value":"stashy %@ è la versione più recente."}},"nb":{"stringUnit":{"state":"needs_review","value":"stashy %@ er den nyeste versjonen."}},"ko":{"stringUnit":{"state":"needs_review","value":"stashy %@은(는) 최신 버전입니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"stashy %@ — последняя версия."}},"de":{"stringUnit":{"state":"needs_review","value":"stashy %@ ist die neueste Version."}},"ja":{"stringUnit":{"state":"needs_review","value":"stashy %@ は最新バージョンです。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O stashy %@ é a versão mais recente."}},"es":{"stringUnit":{"state":"needs_review","value":"stashy %@ es la versión más reciente."}},"fr":{"stringUnit":{"state":"needs_review","value":"stashy %@ est la dernière version."}}}},"hint_stashy_connects_to_intiface_desktop":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Stashy ansluter till Intiface Desktop eller Intiface Central via WebSockets. Se till att ”Enable Remote Network Access” är på i Intifaces inställningar."}},"ar":{"stringUnit":{"state":"needs_review","value":"يتصل stashy بـ Intiface Desktop أو Intiface Central عبر WebSockets. تأكد من تفعيل 'Enable Remote Network Access' في إعدادات Intiface."}},"da":{"stringUnit":{"state":"needs_review","value":"Stashy forbinder til Intiface Desktop eller Intiface Central via WebSockets. Sørg for, at 'Enable Remote Network Access' er slået til i Intiface-indstillingerne."}},"de":{"stringUnit":{"state":"needs_review","value":"stashy verbindet sich per WebSockets mit Intiface Desktop oder Intiface Central. Stelle sicher, dass „Enable Remote Network Access“ in den Intiface-Einstellungen aktiv ist."}},"en":{"stringUnit":{"state":"needs_review","value":"Stashy connects to Intiface Desktop or Intiface Central via WebSockets. Ensure 'Enable Remote Network Access' is turned on in Intiface settings."}},"es":{"stringUnit":{"state":"needs_review","value":"stashy se conecta a Intiface Desktop o Intiface Central mediante WebSockets. Asegúrate de que «Enable Remote Network Access» esté activado en los ajustes de Intiface."}},"fr":{"stringUnit":{"state":"needs_review","value":"stashy se connecte à Intiface Desktop ou Intiface Central via WebSockets. Vérifiez que « Enable Remote Network Access » est activé dans les réglages d'Intiface."}},"it":{"stringUnit":{"state":"needs_review","value":"stashy si connette a Intiface Desktop o Intiface Central tramite WebSocket. Assicurati che 'Enable Remote Network Access' sia attivo nelle impostazioni di Intiface."}},"ja":{"stringUnit":{"state":"needs_review","value":"stashyはWebSocketでIntiface DesktopまたはIntiface Centralに接続します。Intifaceの設定で「Enable Remote Network Access」がオンになっていることを確認してください。"}},"ko":{"stringUnit":{"state":"needs_review","value":"Stashy는 WebSocket을 통해 Intiface Desktop 또는 Intiface Central에 연결합니다. Intiface 설정에서 'Enable Remote Network Access'가 켜져 있는지 확인하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Stashy kobler til Intiface Desktop eller Intiface Central via WebSockets. Sørg for at «Enable Remote Network Access» er slått på i Intiface-innstillingene."}},"nl":{"stringUnit":{"state":"needs_review","value":"stashy maakt via WebSockets verbinding met Intiface Desktop of Intiface Central. Zorg dat 'Enable Remote Network Access' is ingeschakeld in de instellingen van Intiface."}},"pl":{"stringUnit":{"state":"needs_review","value":"stashy łączy się z Intiface Desktop lub Intiface Central przez WebSockets. Upewnij się, że w ustawieniach Intiface włączono „Enable Remote Network Access”."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O stashy se conecta ao Intiface Desktop ou Intiface Central via WebSockets. Verifique se 'Enable Remote Network Access' está ativado nos ajustes do Intiface."}},"ru":{"stringUnit":{"state":"needs_review","value":"stashy подключается к Intiface Desktop или Intiface Central через WebSockets. Убедитесь, что в настройках Intiface включен параметр «Enable Remote Network Access»."}},"tr":{"stringUnit":{"state":"needs_review","value":"Stashy, Intiface Desktop veya Intiface Central'a WebSocket üzerinden bağlanır. Intiface ayarlarında 'Enable Remote Network Access' seçeneğinin açık olduğundan emin ol."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"stashy 透過 WebSockets 連接 Intiface Desktop 或 Intiface Central。請確定已在 Intiface 設定中開啟「Enable Remote Network Access」。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"Stashy 通过 WebSockets 连接到 Intiface Desktop 或 Intiface Central。请确保在 Intiface 设置中打开了“Enable Remote Network Access”。"}}}},"hint_stashy_now_automatically_uploads_local":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Stashy laddar nu automatiskt upp lokala funscripts till Handy Cloud. Den publika URL:en behövs bara för avancerade upplägg."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"Stashy 现在会自动将本地 funscript 上传到 Handy Cloud。只有高级配置才需要公开 URL。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"stashy 現在會自動將本機 funscript 上傳至 Handy Cloud。只有進階設定才需要 Public URL。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Stashy artık yerel funscript'leri otomatik olarak Handy Cloud'a yükler. Genel URL yalnızca gelişmiş kurulumlar için gerekir."}},"ko":{"stringUnit":{"state":"needs_review","value":"이제 Stashy가 로컬 funscript를 Handy Cloud에 자동으로 업로드합니다. 공개 URL은 고급 설정에만 필요합니다."}},"pl":{"stringUnit":{"state":"needs_review","value":"stashy automatycznie wysyła lokalne funscripty do Handy Cloud. Publiczny URL jest potrzebny tylko w zaawansowanych konfiguracjach."}},"es":{"stringUnit":{"state":"needs_review","value":"stashy ahora sube automáticamente los funscripts locales a Handy Cloud. La URL pública solo es necesaria en configuraciones avanzadas."}},"de":{"stringUnit":{"state":"needs_review","value":"stashy lädt lokale Funscripts jetzt automatisch in die Handy Cloud hoch. Die öffentliche URL ist nur für fortgeschrittene Setups nötig."}},"ar":{"stringUnit":{"state":"needs_review","value":"يرفع stashy الآن ملفات funscript المحلية تلقائيًا إلى Handy Cloud. الرابط العام مطلوب فقط للإعدادات المتقدمة."}},"nl":{"stringUnit":{"state":"needs_review","value":"stashy uploadt lokale funscripts nu automatisch naar Handy Cloud. De openbare URL is alleen nodig voor geavanceerde configuraties."}},"en":{"stringUnit":{"state":"needs_review","value":"Stashy now automatically uploads local funscripts to Handy Cloud. The Public URL is only needed for advanced setups."}},"ja":{"stringUnit":{"state":"needs_review","value":