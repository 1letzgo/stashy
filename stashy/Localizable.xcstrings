Unit":{"state":"needs_review","value":"Bewaart sortering, filters en live criteria als nieuw afbeeldingsfilter op je Stash-server."}},"it":{"stringUnit":{"state":"needs_review","value":"Salva ordinamento, filtri e criteri attivi come nuovo filtro immagini sul tuo server Stash."}},"ja":{"stringUnit":{"state":"needs_review","value":"並べ替え、フィルター、ライブ条件を新しい画像フィルターとしてStashサーバーに保存します。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"将排序、过滤器和实时条件存储为你的 Stash 服务器上的新图片过滤器。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Sparar sortering, filter och livevillkor som ett nytt bildfilter på din Stash-server."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"將排序、篩選和即時條件儲存為你 Stash 伺服器上的新圖片篩選條件。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sıralamayı, filtreleri ve canlı ölçütleri Stash sunucunda yeni bir resim filtresi olarak kaydeder."}}}},"hint_scene_and_its_files_are":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Sahne ve dosyaları sunucudan kaldırılır. Bu işlem geri alınamaz."}},"sv":{"stringUnit":{"state":"needs_review","value":"Scenen och dess filer tas bort från servern. Det går inte att ångra."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"短片及其文件将从服务器上移除。此操作无法撤销。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"短片及其檔案將從伺服器移除。此動作無法還原。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"A cena e seus arquivos serão removidos do servidor. Não é possível desfazer."}},"it":{"stringUnit":{"state":"needs_review","value":"La scena e i suoi file vengono rimossi dal server. Questa azione non può essere annullata."}},"nb":{"stringUnit":{"state":"needs_review","value":"Scenen og filene fjernes fra serveren. Dette kan ikke angres."}},"ru":{"stringUnit":{"state":"needs_review","value":"Сцена и ее файлы будут удалены с сервера. Это действие нельзя отменить."}},"pl":{"stringUnit":{"state":"needs_review","value":"Scena i jej pliki zostaną usunięte z serwera. Tej operacji nie można cofnąć."}},"en":{"str