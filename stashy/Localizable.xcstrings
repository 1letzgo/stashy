 de API é inválida ou expirou. Verifique a configuração do servidor."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"需要认证\n你的 API 密钥无效或已过期。请检查服务器配置。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kimlik Doğrulama Gerekli\nAPI anahtarın geçersiz veya süresi dolmuş. Sunucu yapılandırmanı denetle."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"需要驗證\n你的 API 金鑰無效或已過期。請檢查你的伺服器設定。"}}}},"hint_backup_is_in_servers_backup":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Yedek, sunucunun yedekleme klasöründe."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"备份位于服务器的备份文件夹中。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"備份位於伺服器的備份資料夾中。"}},"fr":{"stringUnit":{"state":"needs_review","value":"La sauvegarde se trouve dans le dossier de sauvegarde du serveur."}},"sv":{"stringUnit":{"state":"needs_review","value":"Säkerhetskopian finns i serverns mapp för säkerhetskopior."}},"ru":{"stringUnit":{"state":"needs_review","value":"Резервная копия находится в папке резервных копий сервера."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O backup está na pasta de backup do servidor."}},"nb":{"stringUnit":{"state":"needs_review","value":"Sikkerhetskopien ligger i serverens sikkerhetskopimappe."}},"pl":{"stringUnit":{"state":"needs_review","value":"Kopia zapasowa znajduje się w folderze kopii zapasowych serwera."}},"it":{"stringUnit":{"state":"needs_review","value":"Il backup si trova nella cartella di backup del server."}},"da":{"stringUnit":{"state":"needs_review","value":"Sikkerhedskopien ligger i serverens backupmappe."}},"en":{"stringUnit":{"state":"translated","value":"The backup is in the server's backup folder."}},"nl":{"stringUnit":{"state":"needs_review","value":"De reservekopie staat in de back-upmap van de server."}},"de":{"stringUnit":{"state":"needs_review","value":"Das Backup liegt im Backup-Ordner des Servers."}},"es":{"stringUnit":{"state":"needs_review","value":"La copia de seguridad est