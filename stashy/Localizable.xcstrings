s_review","value":"无法启动视频播放器：%@"}}}},"hint_watch_few_scenes_and_stashy":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"觀看幾部短片後，stashy 會在這裡推薦類似的內容。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"观看几个短片，stashy 就会在这里推荐更多类似的内容。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Birkaç sahne izle, stashy burada onlara benzer sahneler önersin."}},"sv":{"stringUnit":{"state":"needs_review","value":"Titta på några scener så föreslår stashy fler liknande här."}},"nl":{"stringUnit":{"state":"needs_review","value":"Bekijk een paar scènes en stashy stelt hier vergelijkbare voor."}},"de":{"stringUnit":{"state":"needs_review","value":"Schau ein paar Szenen, dann schlägt stashy hier ähnliche vor."}},"it":{"stringUnit":{"state":"needs_review","value":"Guarda qualche scena e stashy te ne suggerirà altre simili qui."}},"pl":{"stringUnit":{"state":"needs_review","value":"Obejrzyj kilka scen, a stashy zaproponuje tutaj więcej podobnych."}},"en":{"stringUnit":{"state":"needs_review","value":"Watch a few scenes and stashy will suggest more like them here."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Assista a algumas cenas e o stashy sugerirá outras parecidas aqui."}},"nb":{"stringUnit":{"state":"needs_review","value":"Se noen scener, så foreslår stashy flere lignende her."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상을 몇 개 시청하면 stashy가 비슷한 영상을 여기에 제안합니다."}},"da":{"stringUnit":{"state":"needs_review","value":"Se et par scener, så foreslår stashy flere lignende her."}},"ru":{"stringUnit":{"state":"needs_review","value":"Посмотрите несколько сцен, и stashy предложит здесь похожие."}},"ja":{"stringUnit":{"state":"needs_review","value":"いくつかシーンを視聴すると、stashyが似たシーンをここに提案します。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Regardez quelques scènes et stashy vous en suggérera d'autres du même genre ici."}},"es":{"stringUnit":{"state":"needs_review","value":"Mira algunas escenas y stashy te sugerirá aquí otras parecidas."}}}},"hint_were_checking_if_your_server":{"localizations":{"nl":{"stringUnit":{"state":"needs_review","value":"We controleren of je server bereikbaar is"}},"ru":{"stringUnit":{"state":"needs_review","value":"Проверяем доступность вашего сервера"}},"pl":{"stringUnit":{"state":"needs_review","value":"Sprawdzamy, czy serwer jest osiągalny"}},"en":{"stringUnit":{"state":"needs_review","value":"We're checking if your server is reachable"}},"da":{"stringUnit":{"state":"needs_review","value":"Vi tjekker, om din server kan nås"}},"es":{"stringUnit":{"state":"needs_review","value":"Estamos comprobando si se puede acceder a tu servidor"}},"it":{"stringUnit":{"state":"needs_review","value":"Stiamo verificando se il tuo server è raggiungibile"}},"ko":{"stringUnit":{"state":"needs_review","value":"서버에 연결할 수 있는지 확인하는 중입니다"}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバーに接続できるか確認しています"}},"nb":{"stringUnit":{"state":"needs_review","value":"Vi sjekker om serveren din kan nås"}},"de":{"stringUnit":{"state":"needs_review","value":"Wir prüfen, ob dein Server erreichbar ist"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Estamos verificando se seu servidor está acessível"}},"fr":{"stringUnit":{"state":"needs_review","value":"Nous vérifions si votre serveur est joignable"}},"sv":{"stringUnit":{"state":"needs_review","value":"Vi kontrollerar om din server kan nås"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sunucuna ulaşılıp ulaşılamadığını denetliyoruz"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"正在檢查是否能連上你的伺服器"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"我们正在检查你的服务器是否可访问"}}}},"hint_with_api_keys_file_gives":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"包含 API 密钥时，此文件可完全访问你的服务器。请妥善保管。"}},"tr":{"stringUnit":{"state":"needs_review","value":"API anahtarlarıyla birlikte dosya sunucularına tam erişim verir. Gizli tut."}},"sv":{"stringUnit":{"state":"needs_review","value":"Med API-nycklar ger filen full åtkomst till dina servrar. Håll den privat."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"包含 API 金鑰時，此檔案可完整存取你的伺服器。請妥善保管。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Z kluczami API plik daje pełny dostęp do Twoich serwerów. Nie udostępniaj go."}},"it":{"stringUnit":{"state":"needs_review","value":"Con le chiavi API il file dà accesso completo ai tuoi server. Tienilo privato."}},"nl":{"stringUnit":{"state":"needs_review","value":"Met API-sleutels geeft het bestand volledige toegang tot je servers. Houd het privé."}},"da":{"stringUnit":{"state":"needs_review","value":"Med API-nøgler giver filen fuld adgang til dine servere. Hold den privat."}},"de":{"stringUnit":{"state":"needs_review","value":"Mit API-Schlüsseln gibt die Datei vollen Zugriff auf deine Server. Halte sie privat."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Com chaves de API, o arquivo dá acesso total aos seus servidores. Mantenha-o privado."}},"ru":{"stringUnit":{"state":"needs_review","value":"С ключами API файл дает полный доступ к вашим серверам. Не передавайте его другим."}},"es":{"stringUnit":{"state":"needs_review","value":"Con las claves de API, el archivo da acceso completo a tus servidores. Mantenlo en privado."}},"ko":{"stringUnit":{"state":"needs_review","value":"API 키가 포함된 파일은 서버에 대한 전체 접근 권한을 부여합니다. 비공개로 보관하세요."}},"nb":{"stringUnit":{"state":"needs_review","value":"Med API-nøkler gir filen full tilgang til serverne dine. Hold den privat."}},"fr":{"stringUnit":{"state":"needs_review","value":"Avec les clés API, le fichier donne un accès complet à vos serveurs. Gardez-le privé."}},"en":{"stringUnit":{"state":"needs_review","value":"With API keys the file gives full access to your servers. Keep it private."}},"ja":{"stringUnit":{"state":"needs_review","value":"APIキーを含むファイルは、サーバーへのフルアクセスを与えます。他人と共有しないでください。"}}}},"hint_you_bought_stashy_before_it":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"サブスクリプション制に移行する前にstashyを購入されたため、stashy+はずっとご利用いただけます。それ以降、アプリは大きく成長しました。開発を応援していただける場合は、チップをいただけると嬉しいです（まったくの任意です）。"}},"ko":{"stringUnit":{"state":"needs_review","value":"구독제로 전환되기 전에 stashy를 구입하셨기 때문에 stashy+를 평생 사용할 수 있습니다. 그 이후로 앱이 크게 성장했습니다. 개발을 후원하고 싶다면 팁을 보내 주시면 감사하겠습니다. 전적으로 선택 사항입니다."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je hebt stashy gekocht voordat het overstapte op abonnementen, dus stashy+ blijft levenslang van jou. Sindsdien is de app enorm gegroeid. Wil je de ontwikkeling steunen, dan is een fooi een vriendelijk gebaar, geheel vrijblijvend."}},"nb":{"stringUnit":{"state":"needs_review","value":"Du kjøpte stashy før appen gikk over til abonnement, så stashy+ er ditt for alltid. Siden den gang har appen vokst enormt. Hvis du vil støtte utviklingen, er et tips en hyggelig gest – helt valgfritt."}},"de":{"stringUnit":{"state":"needs_review","value":"Du hast stashy vor der Umstellung auf Abos gekauft, daher bleibt stashy+ für immer deins. Seitdem ist die App enorm gewachsen. Wenn du die Entwicklung unterstützen möchtest, ist ein Trinkgeld eine nette Geste – ganz freiwillig."}},"it":{"stringUnit":{"state":"needs_review","value":"Hai acquistato stashy prima del passaggio agli abbonamenti, quindi stashy+ resta tuo per sempre. Da allora l'app è cresciuta enormemente. Se vuoi sostenerne lo sviluppo, una mancia è un bel gesto, del tutto facoltativo."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Você comprou o stashy antes de ele passar para assinaturas, então o stashy+ é seu para sempre. Desde então, o app cresceu muito. Se quiser apoiar o desenvolvimento, uma gorjeta é um gesto gentil, totalmente opcional."}},"es":{"stringUnit":{"state":"needs_review","value":"Compraste stashy antes de que pasara a suscripciones, así que stashy+ es tuyo de por vida. Desde entonces la app ha crecido muchísimo. Si quieres apoyar su desarrollo, una propina es un bonito gesto, totalmente opcional."}},"fr":{"stringUnit":{"state":"needs_review","value":"Vous avez acheté stashy avant le passage aux abonnements, stashy+ vous reste donc acquis à vie. Depuis, l'app s'est énormément enrichie. Si vous souhaitez soutenir son développement, un pourboire est un geste apprécié, entièrement facultatif."}},"pl":{"stringUnit":{"state":"needs_review","value":"Kupiłeś stashy, zanim przeszło na subskrypcje, więc stashy+ jest Twoje dożywotnio. Od tego czasu aplikacja bardzo się rozrosła. Jeśli chcesz wesprzeć jej rozwój, napiwek będzie miłym gestem — całkowicie opcjonalnym."}},"da":{"stringUnit":{"state":"needs_review","value":"Du købte stashy, før appen gik over til abonnementer, så stashy+ er din for livet. Siden da er appen vokset enormt. Hvis du vil støtte udviklingen, er drikkepenge en venlig gestus – helt valgfrit."}},"ru":{"stringUnit":{"state":"needs_review","value":"Вы купили stashy до перехода на подписки, поэтому stashy+ остается вашим навсегда. С тех пор приложение сильно выросло. Если хотите поддержать разработку, чаевые будут приятным, но совершенно необязательным жестом."}},"en":{"stringUnit":{"state":"needs_review","value":"You bought stashy before it moved to subscriptions, so stashy+ stays yours for life. Since then the app has grown massively. If you'd like to support its development, a tip is a kind gesture, entirely optional."}},"sv":{"stringUnit":{"state":"needs_review","value":"Du köpte stashy innan appen gick över till prenumerationer, så stashy+ är ditt för alltid. Sedan dess har appen vuxit enormt. Om du vill stödja utvecklingen är dricks en vänlig gest, helt frivillig."}},"tr":{"stringUnit":{"state":"needs_review","value":"stashy'yi aboneliğe geçmeden önce satın aldın, bu yüzden stashy+ ömür boyu senin. O zamandan beri uygulama çok büyüdü. Gelişimini desteklemek istersen bir bahşiş güzel bir jest olur, tamamen isteğe bağlı."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你在 stashy 改為訂閱制之前就已購買，因此 stashy+ 將終身屬於你。自那時起，App 已大幅成長。如果你想支持它的開發，給點小費是一份心意，完全自由選擇。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你在 stashy 改为订阅制之前就已购买，因此 stashy+ 永久归你所有。此后 App 已大幅成长。如果你愿意支持它的开发，打赏是一份心意，完全自愿。"}}}},"hint_your_api_key_is_invalid":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的 API 密钥无效或已过期。请检查服务器配置。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Din API-nyckel är ogiltig eller har gått ut. Kontrollera serverkonfigurationen."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的 API 金鑰無效或已過期。請檢查你的伺服器設定。"}},"tr":{"stringUnit":{"state":"needs_review","value":"API anahtarın geçersiz veya süresi dolmuş. Sunucu yapılandırmanı denetle."}},"ja":{"stringUnit":{"state":"needs_review","value":"APIキーが無効か、期限切れです。サーバー設定を確認してください。"}},"nb":{"stringUnit":{"state":"needs_review","value":"API-nøkkelen din er ugyldig eller utløpt. Sjekk serverkonfigurasjonen."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je API-sleutel is ongeldig of verlopen. Controleer de configuratie van je server."}},"de":{"stringUnit":{"state":"needs_review","value":"Dein API-Schlüssel ist ungültig oder abgelaufen. Prüfe deine Serverkonfiguration."}},"pl":{"stringUnit":{"state":"needs_review","value":"Twój klucz API jest nieprawidłowy lub wygasł. Sprawdź konfigurację serwera."}},"en":{"stringUnit":{"state":"needs_review","value":"Your API key is invalid or expired. Please check your server configuration."}},"it":{"stringUnit":{"state":"needs_review","value":"La tua chiave API non è valida o è scaduta. Controlla la configurazione del server."}},"da":{"stringUnit":{"state":"needs_review","value":"Din API-nøgle er ugyldig eller udløbet. Tjek din serverkonfiguration."}},"fr":{"stringUnit":{"state":"needs_review","value":"Votre clé API est invalide ou a expiré. Vérifiez la configuration de votre serveur."}},"ru":{"stringUnit":{"state":"needs_review","value":"Ваш ключ API недействителен или истек. Проверьте конфигурацию сервера."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua chave de API é inválida ou expirou. Verifique a configuração do servidor."}},"ko":{"stringUnit":{"state":"needs_review","value":"API 키가 유효하지 않거나 만료되었습니다. 서버 구성을 확인하세요."}},"es":{"stringUnit":{"state":"needs_review","value":"Tu clave de API no es válida o ha caducado. Comprueba la configuración del servidor."}}}},"hint_your_license_key_expired_on":{"localizations":{"ru":{"stringUnit":{"state":"needs_review","value":"Срок действия вашего лицензионного ключа истек %@."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je licentiesleutel is verlopen op %@."}},"es":{"stringUnit":{"state":"needs_review","value":"Tu clave de licencia caducó el %@."}},"ko":{"stringUnit":{"state":"needs_review","value":"라이선스 키가 %@에 만료되었습니다."}},"nb":{"stringUnit":{"state":"needs_review","value":"Lisensnøkkelen din utløp %@."}},"da":{"stringUnit":{"state":"needs_review","value":"Din licensnøgle udløb den %@."}},"de":{"stringUnit":{"state":"needs_review","value":"Dein Lizenzschlüssel ist am %@ abgelaufen."}},"ja":{"stringUnit":{"state":"needs_review","value":"ライセンスキーは%@に期限切れになりました。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua chave de licença expirou em %@."}},"it":{"stringUnit":{"state":"needs_review","value":"La tua chiave di licenza è scaduta il %@."}},"pl":{"stringUnit":{"state":"needs_review","value":"Twój klucz licencyjny wygasł %@."}},"en":{"stringUnit":{"state":"needs_review","value":"Your license key expired on %@."}},"fr":{"stringUnit":{"state":"needs_review","value":"Votre clé de licence a expiré le %@."}},"sv":{"stringUnit":{"state":"needs_review","value":"Din licensnyckel gick ut %@."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的许可证密钥已于 %@ 过期。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的授權碼已於 %@ 到期。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Lisans anahtarının süresi %@ tarihinde doldu."}}}},"hint_your_server_configuration_is_missing":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的服务器配置缺少部分信息。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sunucu yapılandırmanda bazı bilgiler eksik."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的伺服器設定缺少部分資訊。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Din serverkonfiguration saknar vissa uppgifter."}},"nb":{"stringUnit":{"state":"needs_review","value":"Serverkonfigurasjonen din mangler noen detaljer."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Faltam alguns dados na configuração do servidor."}},"it":{"stringUnit":{"state":"needs_review","value":"Nella configurazione del server mancano alcuni dati."}},"es":{"stringUnit":{"state":"needs_review","value":"A la configuración de tu servidor le faltan algunos datos."}},"en":{"stringUnit":{"state":"needs_review","value":"Your server configuration is missing some details."}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバー設定に一部の情報が不足しています。"}},"pl":{"stringUnit":{"state":"needs_review","value":"W konfiguracji serwera brakuje niektórych danych."}},"fr":{"stringUnit":{"state":"needs_review","value":"Il manque des détails dans la configuration de votre serveur."}},"da":{"stringUnit":{"state":"needs_review","value":"Din serverkonfiguration mangler nogle oplysninger."}},"ru":{"stringUnit":{"state":"needs_review","value":"В конфигурации сервера не хватает некоторых данных."}},"ko":{"stringUnit":{"state":"needs_review","value":"서버 구성에 일부 세부사항이 누락되었습니다."}},"de":{"stringUnit":{"state":"needs_review","value":"In deiner Serverkonfiguration fehlen einige Angaben."}},"nl":{"stringUnit":{"state":"needs_review","value":"In je serverconfiguratie ontbreken enkele gegevens."}}}},"hint_your_subscription_is_active_buying":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"サブスクリプションは有効です。買い切り版を購入すると、解約後もstashy+をずっと利用できます。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Votre abonnement est actif. L'achat à vie conserve stashy+ pour toujours, même après résiliation."}},"nb":{"stringUnit":{"state":"needs_review","value":"Abonnementet ditt er aktivt. Kjøper du livstid, beholder du stashy+ for alltid, også etter at du avslutter abonnementet."}},"pl":{"stringUnit":{"state":"needs_review","value":"Twoja subskrypcja jest aktywna. Zakup dożywotni zachowuje stashy+ na zawsze, nawet po anulowaniu."}},"da":{"stringUnit":{"state":"needs_review","value":"Dit abonnement er aktivt. Køber du livstid, beholder du stashy+ for altid, også efter opsigelse."}},"ru":{"stringUnit":{"state":"needs_review","value":"Ваша подписка активна. Покупка навсегда сохранит stashy+ даже после отмены подписки."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Sua assinatura está ativa. Comprar o vitalício mantém o stashy+ para sempre, mesmo após cancelar."}},"de":{"stringUnit":{"state":"needs_review","value":"Dein Abo ist aktiv. Mit Lifetime behältst du stashy+ für immer, auch nach einer Kündigung."}},"nl":{"stringUnit":{"state":"needs_review","value":"Je abonnement is actief. Met Levenslang houd je stashy+ voor altijd, ook na opzeggen."}},"ko":{"stringUnit":{"state":"needs_review","value":"구독이 활성 상태입니다. 평생 이용권을 구입하면 구독을 취소한 후에도 stashy+를 계속 사용할 수 있습니다."}},"en":{"stringUnit":{"state":"needs_review","value":"Your subscription is active. Buying Lifetime keeps stashy+ forever, even after cancelling."}},"it":{"stringUnit":{"state":"needs_review","value":"Il tuo abbonamento è attivo. Acquistando Lifetime mantieni stashy+ per sempre, anche dopo aver annullato."}},"es":{"stringUnit":{"state":"needs_review","value":"Tu suscripción está activa. Si compras la versión de por vida, conservarás stashy+ para siempre, incluso tras cancelar."}},"tr":{"stringUnit":{"state":"needs_review","value":"Aboneliğin etkin. Ömür Boyu satın alırsan stashy+ iptal ettikten sonra bile sonsuza dek senin olur."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"你的訂閱目前有效。購買終身版可永久保有 stashy+，即使取消訂閱也一樣。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"你的订阅有效。购买终身版可永久保留 stashy+，即使取消订阅后也是如此。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Din prenumeration är aktiv. Köper du Livstid behåller du stashy+ för alltid, även efter att du avslutat prenumerationen."}}}},"hip_body":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Höft/kropp"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"臀部／身體"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kalça / Gövde"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"臀部 / 身体"}},"fr":{"stringUnit":{"state":"needs_review","value":"Hanches / corps"}},"pl":{"stringUnit":{"state":"needs_review","value":"Biodra / ciało"}},"ru":{"stringUnit":{"state":"needs_review","value":"Бедра / тело"}},"nl":{"stringUnit":{"state":"needs_review","value":"Heup / lichaam"}},"en":{"stringUnit":{"state":"needs_review","value":"Hip / Body"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Quadril / corpo"}},"de":{"stringUnit":{"state":"needs_review","value":"Hüfte / Körper"}},"ko":{"stringUnit":{"state":"needs_review","value":"엉덩이 / 몸"}},"da":{"stringUnit":{"state":"needs_review","value":"Hofte/krop"}},"nb":{"stringUnit":{"state":"needs_review","value":"Hofte / kropp"}},"ja":{"stringUnit":{"state":"needs_review","value":"ヒップ / 体"}},"es":{"stringUnit":{"state":"needs_review","value":"Cadera / cuerpo"}},"it":{"stringUnit":{"state":"needs_review","value":"Fianchi / corpo"}}}},"hold_next":{"localizations":{"fr":{"stringUnit":{"state":"needs_review","value":"Maintenir ▼ Suivant"}},"it":{"stringUnit":{"state":"needs_review","value":"Tieni premuto ▼ Successivo"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Segure ▼ Próximo"}},"nl":{"stringUnit":{"state":"needs_review","value":"Houd ▼ vast: volgende"}},"es":{"stringUnit":{"state":"needs_review","value":"Mantén ▼ Siguiente"}},"en":{"stringUnit":{"state":"needs_review","value":"Hold ▼ Next"}},"da":{"stringUnit":{"state":"needs_review","value":"Hold ▼ Næste"}},"ko":{"stringUnit":{"state":"needs_review","value":"▼ 길게 눌러 다음"}},"ru":{"stringUnit":{"state":"needs_review","value":"Удерживайте ▼ — далее"}},"pl":{"stringUnit":{"state":"needs_review","value":"Przytrzymaj ▼ Następne"}},"de"