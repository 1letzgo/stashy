":{"stringUnit":{"state":"needs_review","value":"画像はサーバーから削除されます。この操作は取り消せません。"}},"en":{"stringUnit":{"state":"translated","value":"The image is removed from the server. This cannot be undone."}},"fr":{"stringUnit":{"state":"needs_review","value":"L'image est supprimée du serveur. Cette action est irréversible."}},"de":{"stringUnit":{"state":"needs_review","value":"Das Bild wird vom Server entfernt. Das kann nicht rückgängig gemacht werden."}},"es":{"stringUnit":{"state":"needs_review","value":"La imagen se elimina del servidor. Esta acción no se puede deshacer."}},"pl":{"stringUnit":{"state":"needs_review","value":"Obraz zostanie usunięty z serwera. Tej operacji nie można cofnąć."}},"da":{"stringUnit":{"state":"needs_review","value":"Billedet fjernes fra serveren. Det kan ikke fortrydes."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"圖片將從伺服器移除。此動作無法還原。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"图片将从服务器上移除。此操作无法撤销。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Resim sunucudan kaldırılır. Bu işlem geri alınamaz."}},"sv":{"stringUnit":{"state":"needs_review","value":"Bilden tas bort från servern. Det går inte att ångra."}}}},"hint_images_will_be_reloaded_from":{"localizations":{"zh-Hans":{"stringUnit":{"state":"needs_review","value":"将从服务器重新载入图片。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Resimler sunucudan yeniden yüklenecek."}},"sv":{"stringUnit":{"state":"needs_review","value":"Bilderna läses in igen från servern."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"圖片將從伺服器重新載入。"}},"da":{"stringUnit":{"state":"needs_review","value":"Billederne indlæses igen fra serveren."}},"pl":{"stringUnit":{"state":"needs_review","value":"Obrazy zostaną ponownie wczytane z serwera."}},"ru":{"stringUnit":{"state":"needs_review","value":"Изображения будут заново загружены с сервера."}},"it":{"stringUnit":{"state":"needs_review","value":"Le immagini verranno ricaricate dal server."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les images seront rechargées depuis le serveur."}},"nl":{"stringUnit":{"state":"needs_review","value":"Afbeeldingen worden opnieuw van de server geladen."}},"ja":{"stringUnit":{"state":"needs_review","value":"画像はサーバーから再読み込みされます。"}},"en":{"stringUnit":{"state":"translated","value":"Images will be reloaded from the server."}},"ko":{"stringUnit":{"state":"needs_review","value":"이미지를 서버에서 다시 불러옵니다."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"As imagens serão recarregadas do servidor."}},"es":{"stringUnit":{"state":"needs_review","value":"Las imágenes se volverán a cargar desde el servidor."}},"nb":{"stringUnit":{"state":"needs_review","value":"Bildene lastes inn på nytt fra serveren."}},"de":{"stringUnit":{"state":"needs_review","value":"Bilder werden neu vom Server geladen."}}}},"hint_imported_arg_server_s_and":{"localizations":{"nl":{"stringUnit":{"state":"needs_review","value":"%@ server(s) en %@ instelling(en) geïmporteerd. Start stashy opnieuw om alle instellingen toe te passen."}},"fr":{"stringUnit":{"state":"needs_review","value":"%@ serveur(s) et %@ réglage(s) importés. Redémarrez stashy pour appliquer tous les réglages."}},"ru":{"stringUnit":{"state":"needs_review","value":"Импортировано серверов: %@, настроек: %@. Перезапустите stashy, чтобы применить все настройки."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"%@ servidor(es) e %@ ajuste(s) importados. Reinicie o stashy para aplicar todos os ajustes."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zaimportowano serwery (%@) i ustawienia (%@). Uruchom ponownie stashy, aby zastosować wszystkie ustawienia."}},"de":{"stringUnit":{"state":"needs_review","value":"%@ Server und %@ Einstellung(en) importiert. Starte stashy neu, damit alle Einstellungen gelten."}},"ja":{"stringUnit":{"state":"needs_review","value":"%@件のサーバーと%@件の設定を読み込みました。すべての設定を反映するにはstashyを再起動してください。"}},"it":{"stringUnit":{"state":"needs_review","value":"Importati %@ server e %@ impostazioni. Riavvia stashy per applicare tutte le impostazioni."}},"en":{"stringUnit":{"state":"translated","value":"Imported %1$@ server(s) and %2$@ setting(s). Restart stashy to apply every setting."}},"nb":{"stringUnit":{"state":"needs_review","value":"Importerte %@ server(e) og %@ innstilling(er). Start stashy på nytt for å ta i bruk alle innstillinger."}},"ko":{"stringUnit":{"state":"needs_review","value":"서버 %@개와 설정 %@개를 가져왔습니다. 모든 설정을 적용하려면 stashy를 다시 시작하세요."}},"da":{"stringUnit":{"state":"needs_review","value":"Importerede %@ server(e) og %@ indstilling(er). Genstart stashy for at anvende alle indstillinger."}},"es":{"stringUnit":{"state":"needs_review","value":"Se importaron %@ servidor(es) y %@ ajuste(s). Reinicia stashy para aplicar todos los ajustes."}},"sv":{"stringUnit":{"state":"needs_review","value":"Importerade %@ server(ar) och %@ inställning(ar). Starta om stashy för att tillämpa alla inställningar."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已导入 %@ 个服务器和 %@ 项设置。请重新启动 stashy 以应用所有设置。"}},"tr":{"stringUnit":{"state":"needs_review","value":"%@ sunucu ve %@ ayar içe aktarıldı. Tüm ayarları uygulamak için stashy'yi yeniden başlat."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已匯入 %@ 個伺服器和 %@ 項設定。請重新啟動 stashy 以套用所有設定。"}}}},"hint_included_because_you_bought_stashy":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"因你在 3.0 之前以原價購買了 stashy，故已包含。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Ingår eftersom du köpte stashy till fullpris före 3.0."}},"tr":{"stringUnit":{"state":"needs_review","value":"stashy'yi 3.0'dan önce tam fiyatla satın aldığın için dahil."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已包含，因为你在 3.0 之前以全价购买了 stashy。"}},"ja":{"stringUnit":{"state":"needs_review","value":"3.0より前にstashyを通常価格で購入したため含まれています。"}},"en":{"stringUnit":{"state":"translated","value":"Included because you bought stashy at full price before 3.0."}},"pl":{"stringUnit":{"state":"needs_review","value":"W zestawie, ponieważ kupiłeś stashy w pełnej cenie przed wersją 3.0."}},"it":{"stringUnit":{"state":"needs_review","value":"Incluso perché hai acquistato stashy a prezzo pieno prima della 3.0."}},"es":{"stringUnit":{"state":"needs_review","value":"Incluido porque compraste stashy a precio completo antes de la 3.0."}},"da":{"stringUnit":{"state":"needs_review","value":"Inkluderet, fordi du købte stashy til fuld pris før 3.0."}},"fr":{"stringUnit":{"state":"needs_review","value":"Inclus car vous avez acheté stashy au prix plein avant la version 3.0."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Incluído porque você comprou o stashy pelo preço cheio antes da 3.0."}},"ru":{"stringUnit":{"state":"needs_review","value":"Включено, так как вы купили stashy по полной цене до версии 3.0."}},"nb":{"stringUnit":{"state":"needs_review","value":"Inkludert fordi du kjøpte stashy til full pris før 3.0."}},"ko":{"stringUnit":{"state":"needs_review","value":"3.0 이전에 stashy를 정가로 구입했으므로 포함됩니다."}},"nl":{"stringUnit":{"state":"needs_review","value":"Inbegrepen omdat je stashy vóór 3.0 tegen de volle prijs hebt gekocht."}},"de":{"stringUnit":{"state":"needs_review","value":"Enthalten, weil du stashy vor 3.0 zum vollen Preis gekauft hast."}}}},"hint_keeps_scene_playing_in_small":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"シーンのページを離れても、小さなバーで再生を続けます。シーンのページでウォッチリストに追加すると順番に再生されます。Dashboardのウォッチリストボタンでリストを開けます。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Laat een scène doorspelen in een kleine balk als je de pagina verlaat. Zet scènes op je kijklijst via de scènepagina en ze worden na elkaar afgespeeld; de kijklijstknop op het Dashboard opent de lijst."}},"fr":{"stringUnit":{"state":"needs_review","value":"Poursuit la lecture d'une scène dans une petite barre quand vous quittez sa page. Ajoutez des scènes à votre liste à regarder depuis la page d'une scène et elles sont lues l'une après l'autre ; le bouton de liste à regarder du Dashboard ouvre la liste."}},"en":{"stringUnit":{"state":"translated","value":"Keeps a scene playing in a small bar when you leave its page. Add scenes to your watchlist on the scene page and they play one after another; the watchlist button on the Dashboard opens the list."}},"ru":{"stringUnit":{"state":"needs_review","value":"Сцена продолжает воспроизводиться в небольшой панели, когда вы покидаете ее страницу. Добавляйте сцены в «Смотреть позже» на странице сцены — они воспроизводятся одна за другой; кнопка «Смотреть позже» на Dashboard открывает список."}},"pl":{"stringUnit":{"state":"needs_review","value":"Odtwarza scenę dalej w małym pasku, gdy opuszczasz jej stronę. Dodawaj sceny do listy Do obejrzenia na stronie sceny, a będą odtwarzane jedna po drugiej; przycisk Do obejrzenia na Dashboardzie otwiera listę."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mantém uma cena em reprodução em uma barra pequena quando você sai da página dela. Adicione cenas à lista para assistir na página da cena e elas são reproduzidas uma após a outra; o botão da lista para assistir no Dashboard abre a lista."}},"da":{"stringUnit":{"state":"needs_review","value":"Fortsætter med at afspille en scene i en lille bjælke, når du forlader dens side. Føj scener til Se senere på scenesiden, så afspilles de efter hinanden; knappen Se senere på Dashboard åbner listen."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상 페이지를 떠나도 작은 막대에서 영상을 계속 재생합니다. 영상 페이지에서 시청 목록에 영상을 추가하면 차례로 재생됩니다. Dashboard의 시청 목록 버튼을 누르면 목록이 열립니다."}},"it":{"stringUnit":{"state":"needs_review","value":"Mantiene una scena in riproduzione in una piccola barra quando lasci la sua pagina. Aggiungi scene a Da guardare nella pagina della scena e verranno riprodotte una dopo l'altra; il pulsante Da guardare nella Dashboard apre l'elenco."}},"es":{"stringUnit":{"state":"needs_review","value":"Mantiene una escena en reproducción en una barra pequeña al salir de su página. Añade escenas a tu lista para ver en la página de la escena y se reproducirán una tras otra; el botón de la lista en el Dashboard abre la lista."}},"nb":{"stringUnit":{"state":"needs_review","value":"Lar en scene fortsette å spille i en liten linje når du forlater siden. Legg til scener i Se senere på scenesiden, så spilles de etter hverandre; Se senere-knappen på Dashboard åpner listen."}},"de":{"stringUnit":{"state":"needs_review","value":"Spielt eine Szene in einer kleinen Leiste weiter, wenn du ihre Seite verlässt. Füge Szenen auf der Szenenseite deiner Merkliste hinzu, dann laufen sie nacheinander; der Merkliste-Button im Dashboard öffnet die Liste."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"離開短片頁面時，短片會在小型列中繼續播放。在短片頁面將短片加入待看清單，它們會依序播放；Dashboard 上的待看清單按鈕可打開清單。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sayfasından ayrıldığında sahneyi küçük bir çubukta oynatmaya devam eder. Sahne sayfasında izleme listene sahne ekle, art arda oynatılırlar; Dashboard'daki izleme listesi düğmesi listeyi açar."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"离开短片页面时，短片会在一个小栏中继续播放。在短片页面将短片添加到稍后观看，它们会依次播放；Dashboard 上的稍后观看按钮可打开列表。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Låter en scen fortsätta spela i ett litet fält när du lämnar dess sida. Lägg till scener i bevakningslistan på scensidan så spelas de efter varandra; bevakningslisteknappen på Dashboard öppnar listan."}}}},"hint_keeps_servers_api_keys_and":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Håller servrar, API-nycklar och inställningar likadana på din iPhone, iPad och Mac. Slå på det per enhet. Den aktiva servern väljs fortfarande per enhet."}},"tr":{"stringUnit":{"state":"needs_review","value":"Sunucuları, API anahtarlarını ve ayarları iPhone, iPad ve Mac'inde aynı tutar. Her aygıtta ayrı aç. Etkin sunucu her aygıtın kendi seçimi olarak kalır."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"让你的 iPhone、iPad 和 Mac 上的服务器、API 密钥和设置保持一致。需在每台设备上分别打开。当前服务器由每台设备各自选择。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"讓 iPhone、iPad 和 Mac 上的伺服器、API 金鑰和設定保持一致。需在每部裝置上個別開啟。使用中的伺服器仍由各裝置自行選擇。"}},"en":{"stringUnit":{"state":"translated","value":"Keeps servers, API keys and settings the same on your iPhone, iPad and Mac. Turn it on per device. The active server stays each device's own choice."}},"ru":{"stringUnit":{"state":"needs_review","value":"Синхронизирует серверы, ключи API и настройки на iPhone, iPad и Mac. Включается на каждом устройстве отдельно. Активный сервер каждое устройство выбирает само."}},"pl":{"stringUnit":{"state":"needs_review","value":"Utrzymuje te same serwery, klucze API i ustawienia na iPhonie, iPadzie i Macu. Włącz na każdym urządzeniu osobno. Aktywny serwer pozostaje wyborem każdego urządzenia."}},"it":{"stringUnit":{"state":"needs_review","value":"Mantiene uguali server, chiavi API e impostazioni su iPhone, iPad e Mac. Attivala su ogni dispositivo. Il server attivo resta una scelta di ciascun dispositivo."}},"de":{"stringUnit":{"state":"needs_review","value":"Hält Server, API-Schlüssel und Einstellungen auf iPhone, iPad und Mac gleich. Schalte es pro Gerät ein. Der aktive Server bleibt die Wahl jedes Geräts."}},"ko":{"stringUnit":{"state":"needs_review","value":"iPhone, iPad 및 Mac에서 서버, API 키 및 설정을 동일하게 유지합니다. 기기별로 켜세요. 활성 서버는 각 기기에서 따로 선택합니다."}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバー、APIキー、設定をiPhone、iPad、Macで同じに保ちます。デバイスごとにオンにしてください。使用中のサーバーは各デバイスで個別に選択されます。"}},"da":{"stringUnit":{"state":"needs_review","value":"Holder servere, API-nøgler og indstillinger ens på din iPhone, iPad og Mac. Slå det til på hver enhed. Den aktive server vælges stadig på hver enkelt enhed."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Mantém servidores, chaves de API e ajustes iguais no seu iPhone, iPad e Mac. Ative por dispositivo. O servidor ativo continua sendo escolha de cada dispositivo."}},"nb":{"stringUnit":{"state":"needs_review","value":"Holder servere, API-nøkler og innstillinger like på iPhone, iPad og Mac. Slå det på for hver enhet. Den aktive serveren er hver enhets eget valg."}},"es":{"stringUnit":{"state":"needs_review","value":"Mantiene iguales los servidores, las claves de API y los ajustes en tu iPhone, iPad y Mac. Actívalo en cada dispositivo. Cada dispositivo elige su propio servidor activo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Garde les serveurs, clés API et réglages identiques sur votre iPhone, iPad et Mac. À activer sur chaque appareil. Le serveur actif reste le choix propre à chaque appareil."}},"nl":{"stringUnit":{"state":"needs_review","value":"Houdt servers, API-sleutels en instellingen gelijk op je iPhone, iPad en Mac. Schakel het per apparaat in. De actieve server blijft een keuze per apparaat."}}}},"hint_language_scenes_subtitles_start_with":{"localizations":{"da":{"stringUnit":{"state":"needs_review","value":"Det sprog, en scenes undertekster starter med. \"Enhver\" tager det første almindelige spor i filen."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O idioma com que as legendas de uma cena começam. \"Qualquer\" usa a primeira faixa comum do arquivo."}},"fr":{"stringUnit":{"state":"needs_review","value":"Langue des sous-titres au démarrage d'une scène. « Tous » prend la première piste ordinaire du fichier."}},"de":{"stringUnit":{"state":"needs_review","value":"Die Sprache, mit der die Untertitel einer Szene starten. „Beliebig“ nimmt die erste normale Spur der Datei."}},"ru":{"stringUnit":{"state":"needs_review","value":"Язык, с которого начинаются субтитры сцены. «Любой» — первая обычная дорожка в файле."}},"nb":{"stringUnit":{"state":"needs_review","value":"Språket en scenes undertekster starter med. «Hvilket som helst» tar det første vanlige sporet i filen."}},"es":{"stringUnit":{"state":"needs_review","value":"El idioma con el que empiezan los subtítulos de una escena. «Cualquiera» usa la primera pista normal del archivo."}},"nl":{"stringUnit":{"state":"needs_review","value":"De taal waarmee de ondertiteling van een scène begint. 'Elke' neemt het eerste gewone spoor in het bestand."}},"ko":{"stringUnit":{"state":"needs_review","value":"영상 자막의 시작 언어입니다. '모두'를 선택하면 파일의 첫 번째 일반 트랙을 사용합니다."}},"it":{"stringUnit":{"state":"needs_review","value":"La lingua con cui partono i sottotitoli di una scena. \"Qualsiasi\" prende la prima traccia normale del file."}},"en":{"stringUnit":{"state":"translated","value":"The language a scene's subtitles start with. \"Any\" takes the first ordinary track in the file."}},"ja":{"stringUnit":{"state":"needs_review","value":"シーンの字幕の初期言語です。「指定なし」ではファイル内の最初の通常トラックを使用します。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Język, od którego zaczynają się napisy sceny. „Dowolny” wybiera pierwszą zwykłą ścieżkę w pliku."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"短片字幕默认使用的语言。“任意”表示使用文件中的第一个普通字幕轨道。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Språket som en scens undertexter börjar med. ”Valfri” tar det första vanliga spåret i filen."}},"tr":{"stringUnit":{"state":"needs_review","value":"Bir sahnenin altyazılarının başlayacağı dil. “Herhangi”, dosyadaki ilk normal izi alır."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"短片字幕預設使用的語言。「任意」會採用檔案中的第一個一般字幕軌。"}}}},"hint_language_switch":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"stashy %@ diline geçip yeniden yüklenecek."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"stashy 將切換為%@並重新載入。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"stashy 将切换为%@并重新加载。"}},"sv":{"stringUnit":{"state":"needs_review","value":"stashy byter till %@ och laddas om."}},"da":{"stringUnit":{"state":"needs_review","value":"stashy skifter til %@ og genindlæses."}},"ja":{"stringUnit":{"state":"needs_review","value":"stashyを%@に切り替えて再読み込みします。"}},"es":{"stringUnit":{"state":"needs_review","value":"stashy cambiará a %@ y se volverá a cargar."}},"ko":{"stringUnit":{"state":"needs_review","value":"stashy가 %@(으)로 전환되고 다시 로드됩니다."}},"nl":{"stringUnit":{"state":"needs_review","value":"stashy schakelt over naar %@ en wordt opnieuw geladen."}},"en":{"stringUnit":{"state":"translated","value":"stashy switches to %@ and reloads."}},"nb":{"stringUnit":{"state":"needs_review","value":"stashy bytter til %@ og lastes inn på nytt."}},"ru":{"stringUnit":{"state":"needs_review","value":"stashy переключится на %@ и перезагрузится."}},"it":{"stringUnit":{"state":"needs_review","value":"stashy passerà a %@ e verrà ricaricata."}},"pl":{"stringUnit":{"state":"needs_review","value":"stashy przełączy się na język %@ i uruchomi się ponownie."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O stashy mudará para %@ e será recarregado."}},"de":{"stringUnit":{"state":"needs_review","value":"stashy wechselt zu %@ und wird neu geladen."}},"fr":{"stringUnit":{"state":"needs_review","value":"stashy passera en %@ et se rechargera."}}}},"hint_leaves_out_what_group_matches":{"localizations":{"ko":{"stringUnit":{"state":"needs_review","value":"그룹과 일치하는 항목을 제외합니다"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Deixa de fora o que o grupo corresponde"}},"es":{"stringUnit":{"state":"needs_review","value":"Excluye lo que coincide con el grupo"}},"ru":{"stringUnit":{"state":"needs_review","value":"Исключает то, что соответствует группе"}},"de":{"stringUnit":{"state":"needs_review","value":"Lässt weg, was die Gruppe erfüllt"}},"it":{"stringUnit":{"state":"needs_review","value":"Esclude ciò che corrisponde al gruppo"}},"ja":{"stringUnit":{"state":"needs_review","value":"グループに一致するものを除外"}},"nb":{"stringUnit":{"state":"needs_review","value":"Utelater det gruppen samsvarer med"}},"fr":{"stringUnit":{"state":"needs_review","value":"Exclut ce qui correspond au groupe"}},"nl":{"stringUnit":{"state":"needs_review","value":"Laat weg wat aan de groep voldoet"}},"pl":{"stringUnit":{"state":"needs_review","value":"Pomija to, co pasuje do grupy"}},"da":{"stringUnit":{"state":"needs_review","value":"Udelader det, gruppen matcher"}},"en":{"stringUnit":{"state":"translated","value":"Leaves out what the group matches"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"排除該群組符合的項目"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"排除该组匹配的内容"}},"tr":{"stringUnit":{"state":"needs_review","value":"Grubun eşleştiklerini dışarıda bırakır"}},"sv":{"stringUnit":{"state":"needs_review","value":"Utelämnar det som gruppen matchar"}}}},"hint_legend_run_performer_is_no":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"Legend 回合的演員已不在此參賽名單中。請重置回合。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Legend turundaki oyuncu artık bu havuzda değil. Turu sıfırla."}},"sv":{"stringUnit":{"state":"needs_review","value":"Legend-omgångens stjärna finns inte längre i urvalet. Återställ omgången."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"Legend 回合中的演员已不在此候选池中。请重置回合。"}},"en":{"stringUnit":{"state":"translated","value":"Legend run performer is no longer in this pool. Run reset."}},"ru":{"stringUnit":{"state":"needs_review","value":"Исполнителя из забега Legend больше нет в этом пуле. Сбросьте забег."}},"es":{"stringUnit":{"state":"needs_review","value":"El intérprete de la partida de Legend ya no está en este grupo. Reinicia la partida."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le performeur de la partie Legend ne fait plus partie de cette sélection. Réinitialisez la partie."}},"da":{"stringUnit":{"state":"needs_review","value":"Kunstneren i Legend-runden er ikke længere i denne pulje. Nulstil runden."}},"de":{"stringUnit":{"state":"needs_review","value":"Der Darsteller des Legend-Laufs ist nicht mehr in diesem Pool. Setze den Lauf zurück."}},"ko":{"stringUnit":{"state":"needs_review","value":"Legend 진행 중인 배우가 더 이상 이 풀에 없습니다. 진행을 재설정하세요."}},"nl":{"stringUnit":{"state":"needs_review","value":"De performer van de Legend-run zit niet meer in deze pool. Stel de run opnieuw in."}},"nb":{"stringUnit":{"state":"needs_review","value":"Utøveren i Legend-runden er ikke lenger i dette utvalget. Tilbakestill runden."}},"ja":{"stringUnit":{"state":"needs_review","value":"Legendランの出演者がこのプールに存在しません。ランをリセットしてください。"}},"it":{"stringUnit":{"state":"needs_review","value":"Il performer della partita Legend non è più in questo gruppo. Ripristina la partita."}},"pl":{"stringUnit":{"state":"needs_review","value":"Aktora z rundy Legend nie ma już w tej puli. Zresetuj rundę."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O artista da rodada Legend não está mais neste grupo de seleção. Redefina a rodada."}}}},"hint_lets_you_create_edit_rename":{"localizations":{"nb":{"stringUnit":{"state":"needs_review","value":"Lar deg opprette, redigere, gi nytt navn til og slette filtrene som er lagret på serveren, under Innstillinger › Server."}},"da":{"stringUnit":{"state":"needs_review","value":"Lader dig oprette, redigere, omdøbe og slette de filtre, der er gemt på din server, under Indstillinger › Server."}},"de":{"stringUnit":{"state":"needs_review","value":"Damit kannst du die auf deinem Server gespeicherten Filter erstellen, bearbeiten, umbenennen und löschen, unter Einstellungen › Server."}},"fr":{"stringUnit":{"state":"needs_review","value":"Permet de créer, modifier, renommer et supprimer les filtres enregistrés sur votre serveur, dans Réglages › Serveur."}},"pl":{"stringUnit":{"state":"needs_review","value":"Pozwala tworzyć, edytować, zmieniać nazwy i usuwać filtry zapisane na serwerze, w Ustawienia › Serwer."}},"es":{"stringUnit":{"state":"needs_review","value":"Te permite crear, editar, renombrar y eliminar los filtros guardados en tu servidor, en Ajustes › Servidor."}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバーに保存されたフィルターを作成、編集、名前変更、削除できます。設定 › サーバーから利用できます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"서버에 저장된 필터를 생성, 편집, 이름 변경 및 삭제할 수 있습니다. 설정 › 서버에 있습니다."}},"sv":{"stringUnit":{"state":"needs_review","value":"Låter dig skapa, redigera, byta namn på och radera filtren som sparats på servern, under Inställningar › Server."}},"ru":{"stringUnit":{"state":"needs_review","value":"Позволяет создавать, изменять, переименовывать и удалять фильтры, сохраненные на сервере, в меню «Настройки › Сервер»."}},"nl":{"stringUnit":{"state":"needs_review","value":"Hiermee kun je de filters die op je server zijn bewaard aanmaken, wijzigen, hernoemen en verwijderen, onder Instellingen › Server."}},"it":{"stringUnit":{"state":"needs_review","value":"Ti permette di creare, modificare, rinominare ed eliminare i filtri salvati sul server, in Impostazioni › Server."}},"en":{"stringUnit":{"state":"translated","value":"Lets you create, edit, rename and delete the filters saved on your server, under Settings › Server."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Permite criar, editar, renomear e apagar os filtros salvos no seu servidor, em Ajustes › Servidor."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"可在“设置 › 服务器”中创建、编辑、重命名和删除存储在服务器上的过滤器。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sunucunda kayıtlı filtreleri Ayarlar › Sunucu altında oluşturmanı, düzenlemeni, yeniden adlandırmanı ve silmeni sağlar."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"讓你在「設定 › 伺服器」中建立、編輯、重新命名和刪除伺服器上儲存的篩選條件。"}}}},"hint_lgpl_3_0_with_app":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"LGPL-3.0, med ett undantag för App Store/DRM"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"LGPL-3.0，附 App Store / DRM 例外条款"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"LGPL-3.0，附 App Store／DRM 例外條款"}},"tr":{"stringUnit":{"state":"needs_review","value":"LGPL-3.0, App Store / DRM istisnasıyla"}},"da":{"stringUnit":{"state":"needs_review","value":"LGPL-3.0, med en undtagelse for App Store/DRM"}},"fr":{"stringUnit":{"state":"needs_review","value":"LGPL-3.0, avec une exception App Store / DRM"}},"pl":{"stringUnit":{"state":"needs_review","value":"LGPL-3.0 z wyjątkiem App Store / DRM"}},"en":{"stringUnit":{"state":"translated","value":"LGPL-3.0, with an App Store / DRM exceptio