 enheten."}},"en":{"stringUnit":{"state":"translated","value":"Speech recognition is not available for this language on this device."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O reconhecimento de fala não está disponível para este idioma neste dispositivo."}},"it":{"stringUnit":{"state":"needs_review","value":"Il riconoscimento vocale non è disponibile per questa lingua su questo dispositivo."}},"fr":{"stringUnit":{"state":"needs_review","value":"La reconnaissance vocale n'est pas disponible pour cette langue sur cet appareil."}},"nl":{"stringUnit":{"state":"needs_review","value":"Spraakherkenning is op dit apparaat niet beschikbaar voor deze taal."}}}},"hint_speech_recognition_is_not_available_on":{"localizations":{"pl":{"stringUnit":{"state":"needs_review","value":"Rozpoznawanie mowy nie jest dostępne na tym urządzeniu."}},"de":{"stringUnit":{"state":"needs_review","value":"Spracherkennung ist auf diesem Gerät nicht verfügbar."}},"es":{"stringUnit":{"state":"needs_review","value":"El reconocimiento de voz no está disponible en este dispositivo."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O reconhecimento de fala não está disponível neste dispositivo."}},"nb":{"stringUnit":{"state":"needs_review","value":"Talegjenkjenning er ikke tilgjengelig på denne enheten."}},"it":{"stringUnit":{"state":"needs_review","value":"Il riconoscimento vocale non è disponibile su questo dispositivo."}},"fr":{"stringUnit":{"state":"needs_review","value":"La reconnaissance vocale n'est pas disponible sur cet appareil."}},"ko":{"stringUnit":{"state":"needs_review","value":"이 기기에서는 음성 인식을 사용할 수 없습니다."}},"en":{"stringUnit":{"state":"translated","value":"Speech recognition is not available on this device."}},"da":{"stringUnit":{"state":"needs_review","value":"Talegenkendelse er ikke tilgængelig på denne enhed."}},"ru":{"stringUnit":{"state":"needs_review","value":"Распознавание речи недоступно на этом устройстве."}},"nl":{"stringUnit":{"state":"needs_review","val