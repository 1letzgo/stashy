e":"Terminy są zgodne z interfejsem Stash, a jego tłumaczenia społeczności (Weblate) służą jako wzorzec dla każdego języka."}},"nl":{"stringUnit":{"state":"needs_review","value":"De termen volgen de interface van Stash zelf, en de communityvertalingen daarvan (Weblate) dienen als referentie voor elke taal."}},"nb":{"stringUnit":{"state":"needs_review","value":"Begrepene følger Stashs eget grensesnitt, og fellesskapsoversettelsene (Weblate) brukes som referanse for hvert språk."}},"en":{"stringUnit":{"state":"needs_review","value":"Terms follow Stash's own interface, and its community translations (Weblate) serve as the reference for each language."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Os termos seguem a própria interface do Stash, e suas traduções da comunidade (Weblate) servem de referência para cada idioma."}},"ko":{"stringUnit":{"state":"needs_review","value":"용어는 Stash 자체 인터페이스를 따르며, 각 언어의 커뮤니티 번역(Weblate)을 참고합니다."}},"ja":{"stringUnit":{"state":"needs_review","value":"用語はStash自体のインターフェイスに準拠し、各言語ではそのコミュニティ翻訳（Weblate）を参考にしています。"}},"da":{"stringUnit":{"state":"needs_review","value":"Begreberne følger Stashs egen brugerflade, og dens fællesskabsoversættelser (Weblate) fungerer som reference for hvert sprog."}},"es":{"stringUnit":{"state":"needs_review","value":"Los términos siguen la propia interfaz de Stash, y sus traducciones de la comunidad (Weblate) sirven de referencia para cada idioma."}},"ru":{"stringUnit":{"state":"needs_review","value":"Термины следуют интерфейсу Stash, а его переводы от сообщества (Weblate) служат образцом для каждого языка."}},"de":{"stringUnit":{"state":"needs_review","value":"Die Begriffe folgen Stashs eigener Oberfläche, und deren Community-Übersetzungen (Weblate) dienen als Referenz für jede Sprache."}},"it":{"stringUnit":{"state":"needs_review","value":"I termini seguono l'interfaccia di Stash, e le sue traduzioni della community (Weblate) fanno da riferimento per ogni lingua."}},"fr":{"stringUnit":{"state":"needs_review","value":"Les termes suivent l'interface de Stash, et ses traductions communautaires (Weblate) servent de référence pour chaque langue."}},"sv":{"stringUnit":{"state":"needs_review","value":"Termerna följer Stashs eget gränssnitt, och dess communityöversättningar (Weblate) fungerar som referens för varje språk."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"术语遵循 Stash 自身界面，其社区翻译（Weblate）作为各语言的参考。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Terimler Stash'in kendi arayüzünü izler; her dil için topluluk çevirileri (Weblate) referans alınır."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"用語遵循 Stash 本身的介面，並以其社群翻譯（Weblate）作為各語言的參考。"}}}},"hint_thank_you_for_your_support":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"感謝你的支持！❤️"}},"tr":{"stringUnit":{"state":"needs_review","value":"Desteğin için teşekkürler! ❤️"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"感谢你的支持！❤️"}},"sv":{"stringUnit":{"state":"needs_review","value":"Tack för ditt stöd! ❤️"}},"es":{"stringUnit":{"state":"needs_review","value":"¡Gracias por tu apoyo! ❤️"}},"ru":{"stringUnit":{"state":"needs_review","value":"Спасибо за поддержку! ❤️"}},"ar":{"stringUnit":{"state":"needs_review","value":"شكرًا لدعمك! ❤️"}},"nl":{"stringUnit":{"state":"needs_review","value":"Bedankt voor je steun! ❤️"}},"nb":{"stringUnit":{"state":"needs_review","value":"Takk for støtten! ❤️"}},"da":{"stringUnit":{"state":"needs_review","value":"Tak for din støtte! ❤️"}},"it":{"stringUnit":{"state":"needs_review","value":"Grazie per il tuo supporto! ❤️"}},"en":{"stringUnit":{"state":"needs_review","value":"Thank you for your support! ❤️"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Obrigado pelo seu apoio! ❤️"}},"ja":{"stringUnit":{"state":"needs_review","value":"ご支援ありがとうございます！❤️"}},"ko":{"stringUnit":{"state":"needs_review","value":"후원해 주셔서 감사합니다! ❤️"}},"de":{"stringUnit":{"state":"needs_review","value":"Danke für deine Unterstützung! ❤️"}},"