Unit":{"state":"needs_review","value":"Меняет цвет значка stashy на выбранный."}},"en":{"stringUnit":{"state":"needs_review","value":"Changes the stashy app icon to the color you pick."}},"fr":{"stringUnit":{"state":"needs_review","value":"Donne à l'icône de stashy la couleur choisie."}},"de":{"stringUnit":{"state":"needs_review","value":"Ändert das stashy-App-Icon in die gewählte Farbe."}},"ar":{"stringUnit":{"state":"needs_review","value":"يغيّر أيقونة تطبيق stashy إلى اللون الذي تختاره."}},"it":{"stringUnit":{"state":"needs_review","value":"Cambia l'icona dell'app stashy nel colore che scegli."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Altera o ícone do app stashy para a cor escolhida."}},"da":{"stringUnit":{"state":"needs_review","value":"Ændrer stashys appikon til den farve, du vælger."}},"nl":{"stringUnit":{"state":"needs_review","value":"Wijzigt het stashy-appsymbool naar de kleur die je kiest."}},"pl":{"stringUnit":{"state":"needs_review","value":"Zmienia ikonę aplikacji stashy na wybrany kolor."}},"ko":{"stringUnit":{"state":"needs_review","value":"stashy 앱 아이콘을 선택한 색상으로 변경합니다."}},"tr":{"stringUnit":{"state":"needs_review","value":"stashy uygulama simgesini seçtiğin renge değiştirir."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"将 stashy App 图标更改为你选择的颜色。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Ändrar stashys appsymbol till den färg du väljer."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"將 stashy App 圖像更改為你選擇的顏色。"}}}},"hint_choose_appearance_of_app":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Uygulamanın görünümünü seç."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择 App 的外观。"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇 App 的外觀。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Välj appens utseende."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez l'apparence de l'app."}},"ar":{"stringUnit":{"state":"needs_review","value":"اختر مظهر التطبيق."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli l'aspetto dell'app."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите оформление приложения."}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle die Darstellung der App."}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg utseendet til appen."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz wygląd aplikacji."}},"ja":{"stringUnit":{"state":"needs_review","value":"Appの外観を選択します。"}},"en":{"stringUnit":{"state":"needs_review","value":"Choose the appearance of the app."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies de weergave van de app."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha a aparência do app."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg appens udseende."}},"ko":{"stringUnit":{"state":"needs_review","value":"앱의 화면 모드를 선택하세요."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige la apariencia de la app."}}}},"hint_choose_rows_on_home_and":{"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"Wähle die Zeilen auf Start und ihre Reihenfolge. Wähle eine Zeile, um sie ein- oder auszublenden oder nach oben oder unten zu verschieben. Jeder Server hat seine eigene Einrichtung."}},"sv":{"stringUnit":{"state":"needs_review","value":"Välj raderna på Hem och deras ordning. Välj en rad för att visa eller dölja den eller flytta den upp eller ned. Varje server har sin egen uppsättning."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli le righe della Home e il loro ordine. Seleziona una riga per mostrarla o nasconderla, o per spostarla su o giù. Ogni server ha la sua configurazione."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz wiersze na ekranie Start i ich kolejność. Wybierz wiersz, aby go pokazać lub ukryć albo przesunąć w górę lub w dół. Każdy serwer ma własny układ."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg rækkerne på Hjem og deres rækkefølge. Vælg en række for at vise eller skjule den eller flytte den op eller ned. Hver server har sin egen opsætning."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige las filas de Inicio y su orden. Selecciona una fila para mostrarla u ocultarla, o para subirla o bajarla. Cada servidor guarda su propia configuración."}},"nb":{"stringUnit":{"state":"needs_review","value":"Velg radene på Hjem og rekkefølgen deres. Velg en rad for å vise eller skjule den, eller flytte den opp eller ned. Hver server har sitt eget oppsett."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha as linhas do Início e sua ordem. Selecione uma linha para mostrá-la ou ocultá-la, ou para movê-la para cima ou para baixo. Cada servidor mantém sua própria configuração."}},"ar":{"stringUnit":{"state":"needs_review","value":"اختر صفوف الرئيسية وترتيبها. حدّد صفًا لإظهاره أو إخفائه أو نقله لأعلى أو لأسفل. يحتفظ كل خادم بإعداده الخاص."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите ряды главной и их порядок. Выберите ряд, чтобы показать или скрыть его либо переместить вверх или вниз. Для каждого сервера настройка своя."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies de rijen op Home en hun volgorde. Selecteer een rij om hem te tonen of te verbergen, of om hem omhoog of omlaag te verplaatsen. Elke server heeft zijn eigen indeling."}},"ja":{"stringUnit":{"state":"needs_review","value":"ホームに表示する行とその順序を選択します。行を選択すると、表示・非表示の切り替えや上下への移動ができます。設定はサーバーごとに保存されます。"}},"en":{"stringUnit":{"state":"needs_review","value":"Choose the rows on Home and their order. Select a row to show or hide it, or to move it up or down. Each server keeps its own setup."}},"ko":{"stringUnit":{"state":"needs_review","value":"홈에 표시할 행과 순서를 선택하세요. 행을 선택하면 표시하거나 가리거나 위아래로 이동할 수 있습니다. 서버마다 설정이 따로 저장됩니다."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez les rangées de l'accueil et leur ordre. Sélectionnez une rangée pour l'afficher, la masquer ou la déplacer vers le haut ou le bas. Chaque serveur garde sa propre configuration."}},"tr":{"stringUnit":{"state":"needs_review","value":"Ana Sayfa'daki satırları ve sıralarını seç. Göstermek, gizlemek veya yukarı ya da aşağı taşımak için bir satır seç. Her sunucu kendi düzenini korur."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇首頁上的列及其順序。選取一列即可顯示或隱藏，或將其上移或下移。每個伺服器都會保留自己的設定。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择主页上的行及其顺序。选择一行可显示或隐藏它，或将其上移或下移。每个服务器都有各自的设置。"}}}},"hint_chooses_saved_filter_or_preset":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇已儲存的篩選條件或預設組合"}},"sv":{"stringUnit":{"state":"needs_review","value":"Väljer ett sparat filter eller en förinställning"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择已存过滤器或预设"}},"tr":{"stringUnit":{"state":"needs_review","value":"Kayıtlı bir filtre veya hazır ayar seçer"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolhe um filtro salvo ou predefinição"}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisit un filtre enregistré ou un préréglage"}},"it":{"stringUnit":{"state":"needs_review","value":"Sceglie un filtro salvato o un preset"}},"ar":{"stringUnit":{"state":"needs_review","value":"يختار فلترًا محفوظًا أو إعدادًا مسبقًا"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybiera zapisany filtr lub ustawienie wstępne"}},"es":{"stringUnit":{"state":"needs_review","value":"Elige un filtro guardado o un preajuste"}},"ja":{"stringUnit":{"state":"needs_review","value":"保存済みフィルターまたはプリセットを選択します"}},"en":{"stringUnit":{"state":"needs_review","value":"Chooses a saved filter or preset"}},"ko":{"stringUnit":{"state":"needs_review","value":"저장된 필터 또는 프리셋을 선택합니다"}},"da":{"stringUnit":{"state":"needs_review","value":"Vælger et gemt filter eller en forudindstilling"}},"de":{"stringUnit":{"state":"needs_review","value":"Wählt einen gespeicherten Filter oder ein Preset"}},"ru":{"stringUnit":{"state":"needs_review","value":"Выбор сохраненного фильтр