ingUnit":{"state":"needs_review","value":"Enregistrer le tri, le filtre et les critères actuels comme nouveau filtre enregistré Stash."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Salve a ordenação, o filtro e os critérios ao vivo atuais como um novo filtro salvo do Stash."}},"nb":{"stringUnit":{"state":"needs_review","value":"Lagre gjeldende sortering, filter og direktekriterier som et nytt lagret Stash-filter."}},"en":{"stringUnit":{"state":"needs_review","value":"Save the current sort, filter, and live criteria as a new Stash saved filter."}},"ja":{"stringUnit":{"state":"needs_review","value":"現在の並べ替え、フィルター、ライブ条件を新しいStashの保存済みフィルターとして保存します。"}},"es":{"stringUnit":{"state":"needs_review","value":"Guarda el orden, el filtro y los criterios en vivo actuales como un nuevo filtro guardado de Stash."}},"sv":{"stringUnit":{"state":"needs_review","value":"Spara aktuell sortering, filter och livevillkor som ett nytt sparat Stash-filter."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"將目前的排序、篩選和即時條件儲存為新的 Stash 已儲存篩選條件。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Geçerli sıralamayı, filtreyi ve canlı ölçütleri yeni bir Stash kayıtlı filtresi olarak kaydet."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"将当前的排序、过滤器和实时条件存储为新的 Stash 已存过滤器。"}}}},"hint_saved_filter_from_your_stash":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"來自你 Stash 伺服器的已儲存篩選條件，在打開區段時自動套用。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Stash sunucundan, bir bölüm açıldığında otomatik uygulanan kayıtlı bir filtre."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"来自你的 Stash 服务器的已存过滤器，在打开版块时自动应用。"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Um filtro salvo do seu servidor Stash, aplicado automaticamente quando uma seção é aberta."}},"ru":{"stringUnit":{"state":"needs_review","value":"Сохраненный фильтр с сервера Stash, который автоматически применяется при открытии раздела."}},"da":{"stringUnit":{"state":