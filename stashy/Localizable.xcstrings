:{"state":"needs_review","value":"也可以從卡片下方的 ··· 選單操作。"}}}},"hint_analyzes_playing_video_live_on":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在你的裝置上即時分析正在播放的影片，並讓已連接的硬體同步動作。會大量使用 CPU 和電池。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Analyserar videon som spelas direkt på enheten och rör din anslutna hårdvara i takt med den. Använder mycket CPU och batteri."}},"tr":{"stringUnit":{"state":"needs_review","value":"Oynatılan videoyu aygıtında canlı olarak analiz eder ve bağlı donanımını onunla eşzamanlı hareket ettirir. Çok fazla işlemci ve pil kullanır."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在设备上实时分析正在播放的视频，并让已连接的硬件与之同步运动。会消耗大量 CPU 和电量。"}},"ko":{"stringUnit":{"state":"needs_review","value":"재생 중인 비디오를 기기에서 실시간으로 분석하고 연결된 하드웨어를 비디오에 맞춰 움직입니다. CPU와 배터리를 많이 사용합니다."}},"nl":{"stringUnit":{"state":"needs_review","value":"Analyseert de spelende video live op je apparaat en beweegt je verbonden hardware synchroon mee. Gebruikt veel CPU en batterij."}},"it":{"stringUnit":{"state":"needs_review","value":"Analizza in tempo reale sul dispositivo il video in riproduzione e muove l'hardware connesso in sincronia. Usa molta CPU e batteria."}},"de":{"stringUnit":{"state":"needs_review","value":"Analysiert das laufende Video live auf deinem Gerät und bewegt deine verbundene Hardware synchron dazu. Braucht viel CPU und Akku."}},"nb":{"stringUnit":{"state":"needs_review","value":"Analyserer videoen som spilles direkte på enheten, og beveger den tilkoblede maskinvaren i takt med den. Bruker mye CPU og batteri."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Analisa o vídeo em reprodução ao vivo no seu dispositivo e move o hardware conectado em sincronia. Consome muita CPU e bateria."}},"en":{"stringUnit":{"state":"needs_review","value":"Analyzes the playing video live on your device and moves your connected hardware in sync with it. Uses a lot of CPU and battery."}},"fr":{"stringUnit":{"state":"needs_review","value":"Analyse en direct la vidéo en cours sur votre appareil et fait bouger votre matériel connecté en synchronisation. Consomme beaucoup de processeur et de batterie."}},"pl":{"stringUnit":{"state":"needs_review","value":"Analizuje odtwarzane wideo na żywo na urządzeniu i porusza podłączonym sprzętem synchronicznie z nim. Mocno obciąża procesor i baterię."}},"ja":{"stringUnit":{"state":"needs_review","value":"再生中の動画をデバイス上でリアルタイムに解析し、接続されたハードウェアを同期して動かします。CPUとバッテリーを多く消費します。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Анализирует воспроизводимое видео в реальном времени на устройстве и синхронно двигает подключенное оборудование. Сильно расходует ресурсы процессора и аккумулятор."}},"es":{"stringUnit":{"state":"needs_review","value":"Analiza en directo en tu dispositivo el video que se reproduce y mueve tu hardware conectado en sincronía. Consume mucha CPU y batería."}},"da":{"stringUnit":{"state":"needs_review","value":"Analyserer den afspillede video live på din enhed og bevæger din tilsluttede hardware i takt med den. Bruger meget CPU og batteri."}}}},"hint_api_key_configured":{"localizations":{"fr":{"stringUnit":{"state":"needs_review","value":"•••• configurée"}},"it":{"stringUnit":{"state":"needs_review","value":"•••• configurata"}},"ko":{"stringUnit":{"state":"needs_review","value":"•••• 설정됨"}},"ru":{"stringUnit":{"state":"needs_review","value":"•••• настроен"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"•••• configurada"}},"nb":{"stringUnit":{"state":"needs_review","value":"•••• konfigurert"}},"en":{"stringUnit":{"state":"needs_review","value":"•••• configured"}},"pl":{"stringUnit":{"state":"needs_review","value":"•••• skonfigurowano"}},"nl":{"stringUnit":{"state":"needs_review","value":"•••• ingesteld"}},"es":{"stringUnit":{"state":"needs_review","value":"•••• configurada"}},"ja":{"stringUnit":{"state":"needs_review","value":"•••• 設定済み"}},"de":{"stringUnit":{"state":"needs_review","value":"•••• konfiguriert"}},"da":{"stringUnit":{"state":"needs