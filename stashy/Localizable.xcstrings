iew","value":"앱 전체에서 포커스 강조 표시와 아이콘에 사용할 강조 색상을 선택하세요."}},"en":{"stringUnit":{"state":"needs_review","value":"Pick the accent color used for focus highlights and icons throughout the app."}}}},"hint_pick_app_theme_and_accent":{"localizations":{"nb":{"stringUnit":{"state":"needs_review","value":"Velg apptemaet og aksentfargen som brukes for fokusmarkering og ikoner i hele appen."}},"de":{"stringUnit":{"state":"needs_review","value":"Wähle das App-Design und die Akzentfarbe für Fokus-Hervorhebungen und Symbole in der ganzen App."}},"nl":{"stringUnit":{"state":"needs_review","value":"Kies het thema van de app en de accentkleur voor focusmarkeringen en symbolen in de hele app."}},"da":{"stringUnit":{"state":"needs_review","value":"Vælg apptemaet og den accentfarve, der bruges til fokusmarkeringer og ikoner i hele appen."}},"it":{"stringUnit":{"state":"needs_review","value":"Scegli il tema dell'app e il colore di accento usato per l'evidenziazione del focus e le icone in tutta l'app."}},"ja":{"stringUnit":{"state":"needs_review","value":"アプリのテーマと、アプリ全体のフォーカスのハイライトとアイコンに使うアクセントカラーを選択します。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierz motyw aplikacji i kolor akcentu używany do podświetleń fokusu i ikon w całej aplikacji."}},"es":{"stringUnit":{"state":"needs_review","value":"Elige el tema de la app y el color de acento que se usa para resaltar el foco y los iconos en toda la app."}},"fr":{"stringUnit":{"state":"needs_review","value":"Choisissez le thème de l'app et la couleur d'accentuation utilisée pour la mise en évidence et les icônes dans toute l'app."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Escolha o tema do app e a cor de destaque usada nos destaques de foco e ícones em todo o app."}},"en":{"stringUnit":{"state":"needs_review","value":"Pick the app theme and the accent color used for focus highlights and icons throughout the app."}},"ru":{"stringUnit":{"state":"needs_review","value":"Выберите тему приложения и цвет акцента для выделения фокуса и значков во всем приложении."}},"ko":{"stringUnit":{"state":"needs_review","value":"앱 테마와 앱 전체에서 포커스 강조 표시와 아이콘에 사용할 강조 색상을 선택하세요."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"選擇 App 主題，以及整個 App 中焦點醒目提示和圖像所使用的強調色。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"选择 App 主题以及用于整个 App 中焦点高亮和图标的强调色。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Välj apptema och accentfärgen för fokusmarkeringar och symboler i hela appen."}},"tr":{"stringUnit":{"state":"needs_review","value":"Uygulama temasını ve uygulama genelinde odak vurguları ve simgeler için kullanılan vurgu rengini seç."}}}},"hint_picked_on_this_device_from":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Utvalt på den här enheten utifrån dina uppspelningar, O-räknare och betyg."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"依據你的播放、O 計數和評分，在此裝置上挑選。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"根据你的播放、O 计数和评分在此设备上挑选。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Oynatmalarından, O Sayılarından ve puanlarından bu aygıtta seçildi."}},"ko":{"stringUnit":{"state":"needs_review","value":"재생, O 카운트 및 별점을 바탕으로 이 기기에서 선택했습니다."}},"en":{"stringUnit":{"state":"needs_review","value":"Picked on this device from your plays, O Counts and ratings."}},"it":{"stringUnit":{"state":"needs_review","value":"Scelte su questo dispositivo in base a riproduzioni, contatori O e valutazioni."}},"es":{"stringUnit":{"state":"needs_review","value":"Seleccionado en este dispositivo a partir de tus reproducciones, contadores O y valoraciones."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wybierane na tym urządzeniu na podstawie Twoich odtworzeń, liczników O i ocen."}},"da":{"stringUnit":{"state":"needs_review","value":"Udvalgt på denne enhed ud fra dine afspilninger, O-tællere og bedømmelser."}},"nl":{"stringUnit":{"state":"needs_review","value":"Op dit apparaat gekozen uit je weergaven, O-tellers en beoordelingen."}},"pt-BR":{"stringUni