ds_review","value":"Добавлено в очередь задач сервера."}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバーのジョブキューに追加しました。"}},"pl":{"stringUnit":{"state":"needs_review","value":"Dodano do kolejki zadań serwera."}},"en":{"stringUnit":{"state":"needs_review","value":"Added to the server's job queue."}},"nl":{"stringUnit":{"state":"needs_review","value":"Toegevoegd aan de takenwachtrij van de server."}},"nb":{"stringUnit":{"state":"needs_review","value":"Lagt til i serverens jobbkø."}},"de":{"stringUnit":{"state":"needs_review","value":"Zur Job-Warteschlange des Servers hinzugefügt."}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiunto alla coda di attività del server."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Adicionado à fila de tarefas do servidor."}},"es":{"stringUnit":{"state":"needs_review","value":"Añadido a la cola de tareas del servidor."}},"fr":{"stringUnit":{"state":"needs_review","value":"Ajouté à la file de tâches du serveur."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"已添加到服务器的任务队列。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Tillagt i serverns jobbkö."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"已加入伺服器的工作佇列。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Sunucunun iş kuyruğuna eklendi."}}}},"hint_add_scenes_with_plus_on":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"Oynatılan bir sahnede + ile veya sahne sayfasındaki izleme listesi düğmesiyle sahne ekle. Burada art arda oynatılırlar."}},"sv":{"stringUnit":{"state":"needs_review","value":"Lägg till scener med + på en scen som spelas eller med bevakningslisteknappen på en scensida. De spelas här efter varandra."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在播放中的短片上點 +，或在短片頁面上點待看清單按鈕即可加入短片。它們會在這裡依序播放。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在正在播放的短片上点按 +，或在短片页面点按稍后观看按钮来添加短片。它们会在这里依次播放。"}},"de":{"stringUnit":{"state":"needs_review","value":"Füge Szenen mit + bei einer laufenden Szene oder mit der Merkliste-Taste auf einer Szenenseite hinzu. Sie werden hier nacheinander abgespielt."}},"pl":{"stringUnit":{"state":"needs_review","value":"Dodawaj sceny przyciskiem + na odtwarzanej scenie lub przyciskiem Do obejrzenia na stronie sceny. Będą tu odtwarzane jedna po drugiej."}},"da":{"stringUnit":{"state":"needs_review","value":"Tilføj scener med + på en scene, der afspilles, eller med Se senere-knappen på en sceneside. De afspilles her efter hinanden."}},"fr":{"stringUnit":{"state":"needs_review","value":"Ajoutez des scènes avec + sur une scène en cours de lecture ou avec le bouton de liste à regarder sur la page d'une scène. Elles sont lues ici l'une après l'autre."}},"ja":{"stringUnit":{"state":"needs_review","value":"再生中のシーンの＋、またはシーンページのウォッチリストボタンでシーンを追加できます。ここで順番に再生されます。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Legg til scener med + på en scene som spilles, eller med Se senere-knappen på en sceneside. De spilles her etter hverandre."}},"ru":{"stringUnit":{"state":"needs_review","value":"Добавляйте сцены кнопкой + в воспроизводимой сцене или кнопкой «Смотреть позже» на странице сцены. Здесь они воспроизводятся одна за другой."}},"en":{"stringUnit":{"state":"needs_review","value":"Add scenes with + on a playing scene or the watchlist button on a scene page. They play here one after another."}},"ko":{"stringUnit":{"state":"needs_review","value":"재생 중인 영상의 +나 영상 페이지의 시청 목록 버튼으로 영상을 추가하세요. 추가한 영상이 여기에서 차례로 재생됩니다."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Adicione cenas com + em uma cena em reprodução ou com o botão da lista para assistir na página da cena. Elas são reproduzidas aqui uma após a outra."}},"nl":{"stringUnit":{"state":"needs_review","value":"Voeg scènes toe met + bij een spelende scène of met de kijklijstknop op een scènepagina. Ze worden hier na elkaar afgespeeld."}},"es":{"stringUnit":{"state":"needs_review","value":"Añade escenas con + en una escena en reproducción o con el botón de lista para ver en la página de una escena. Aquí se reproducen una tras otra."}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiungi scene con + su una scena in riproduzione o con il pulsante Da guardare nella pagina di una scena. Qui vengono riprodotte una dopo l'altra."}}}},"hint_adds_magazin_view_on_home":{"localizations":{"fr":{"stringUnit":{"state":"needs_review","value":"Ajoute à l'accueil une vue Magazin qui affiche vos galeries sous forme de couvertures. Elles s'ouvrent comme un magazine et se souviennent de la page où vous vous êtes arrêté."}},"nb":{"stringUnit":{"state":"needs_review","value":"Legger til en Magazin-visning på Hjem som viser galleriene dine som omslag. De åpnes som et blad og husker siden du stoppet på."}},"en":{"stringUnit":{"state":"needs_review","value":"Adds a Magazin view on Home that shows your galleries as covers. They open like a magazine and remember the page you stopped on."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Adiciona ao Início uma visualização Magazin que mostra suas galerias como capas. Elas abrem como uma revista e lembram a página onde você parou."}},"es":{"stringUnit":{"state":"needs_review","value":"Añade a Inicio una vista Magazin que muestra tus galerías como portadas. Se abren como una revista y recuerdan la página en la que te quedaste."}},"pl":{"stringUnit":{"state":"needs_review","value":"Dodaje na ekranie Start widok Magazin, który pokazuje galerie jako okładki. Otwierają się jak czasopismo i pamiętają stronę, na której skończyłeś."}},"ko":{"stringUnit":{"state":"needs_review","value":"갤러리를 표지로 보여주는 Magazin 보기를 홈에 추가합니다. 잡지처럼 열리고 마지막으로 읽은 페이지를 기억합니다."}},"ru":{"stringUnit":{"state":"needs_review","value":"Добавляет на главную вид Magazin, где галереи показаны обложками. Они открываются как журнал и запоминают страницу, на которой вы остановились."}},"de":{"stringUnit":{"state":"needs_review","value":"Fügt auf Start eine Magazin-Ansicht hinzu, die deine Galerien als Cover zeigt. Sie öffnen sich wie ein Magazin und merken sich die Seite, auf der du aufgehört hast."}},"ja":{"stringUnit":{"state":"needs_review","value":"ギャラリーを表紙として表示するMagazinビューをホームに追加します。雑誌のように開き、読み終えたページを記憶します。"}},"da":{"stringUnit":{"state":"needs_review","value":"Tilføjer en Magazin-visning på Hjem, der viser dine gallerier som covers. De åbnes som et magasin og husker den side, du stoppede på."}},"nl":{"stringUnit":{"state":"needs_review","value":"Voegt een Magazin-weergave toe op Home die je galerijen als omslagen toont. Ze openen als een tijdschrift en onthouden de pagina waar je bent gebleven."}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiunge alla Home una vista Magazin che mostra le tue gallerie come copertine. Si aprono come una rivista e ricordano la pagina a cui eri arrivato."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在首頁加入 Magazin 檢視，以封面顯示你的圖庫。它們會像雜誌一樣打開，並記住你上次停下的頁面。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Ana Sayfa'ya galerilerini kapak olarak gösteren bir Magazin görünümü ekler. Galeriler dergi gibi açılır ve kaldığın sayfayı hatırlar."}},"sv":{"stringUnit":{"state":"needs_review","value":"Lägger till en Magazin-vy på Hem som visar dina gallerier som omslag. De öppnas som en tidning och kommer ihåg sidan där du slutade."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"在主页添加 Magazin 视图，以封面形式显示你的图库。它们像杂志一样打开，并会记住你停留的页面。"}}}},"hint_add_stash_servers_and_switch":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Lägg till Stash-servrar och växla mellan dem. Håll ned Välj på en server för att redigera den eller ta bort en sparad server."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"添加 Stash 服务器并在它们之间切换。在服务器上按住选择键可编辑或移除已存的服务器。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Stash sunucuları ekle ve aralarında geçiş yap. Bir sunucuyu düzenlemek veya kayıtlı bir sunucuyu kaldırmak için üzerinde Seç'i basılı tut."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"新增 Stash 伺服器並在它們之間切換。在伺服器上按住「選擇」即可編輯或移除已儲存的伺服器。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Legg til Stash-servere og bytt mellom dem. Hold inne Velg på en server for å redigere den eller fjerne en lagret server."}},"ja":{"stringUnit":{"state":"needs_review","value":"Stashサーバーを追加して切り替えます。サーバー上で選択ボタンを長押しすると、編集や保存済みサーバーの削除ができます。"}},"es":{"stringUnit":{"state":"needs_review","value":"Añade servidores Stash y cambia entre ellos. Mantén pulsado Seleccionar sobre un servidor para editarlo o eliminar uno guardado."}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiungi server Stash e passa dall'uno all'altro. Tieni premuto Seleziona su un server per modificarlo o rimuoverne uno salvato."}},"pl":{"stringUnit":{"state":"needs_review","value":"Dodawaj serwery Stash i przełączaj się między nimi. Przytrzymaj Wybierz na serwerze, aby go edytować lub usunąć zapisany."}},"ru":{"stringUnit":{"state":"needs_review","value":"Добавляйте серверы Stash и переключайтесь между ними. Удерживайте «Выбор» на сервере, чтобы изменить или удалить его."}},"fr":{"stringUnit":{"state":"needs_review","value":"Ajoutez des serveurs Stash et passez de l'un à l'autre. Maintenez Sélectionner sur un serveur pour le modifier ou supprimer un serveur enregistré."}},"da":{"stringUnit":{"state":"needs_review","value":"Tilføj Stash-servere, og skift mellem dem. Hold Vælg nede på en server for at redigere den eller fjerne en gemt server."}},"nl":{"stringUnit":{"state":"needs_review","value":"Voeg Stash-servers toe en schakel ertussen. Houd Select ingedrukt op een server om hem te wijzigen of een bewaarde te verwijderen."}},"ko":{"stringUnit":{"state":"needs_review","value":"Stash 서버를 추가하고 서버 간에 전환합니다. 서버를 편집하거나 저장된 서버를 제거하려면 해당 서버에서 선택 버튼을 길게 누르세요."}},"de":{"stringUnit":{"state":"needs_review","value":"Füge Stash-Server hinzu und wechsle zwischen ihnen. Halte Auswählen auf einem Server gedrückt, um ihn zu bearbeiten oder einen gespeicherten zu entfernen."}},"en":{"stringUnit":{"state":"needs_review","value":"Add Stash servers and switch between them. Hold Select on a server to edit it or remove a saved one."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Adicione servidores Stash e alterne entre eles. Mantenha Selecionar pressionado em um servidor para editá-lo ou remover um salvo."}}}},"hint_add_stash_servers_switch_between":{"localizations":{"pt-BR":{"stringUnit":{"state":"needs_review","value":"Adicione servidores Stash, alterne entre eles e edite ou remova os salvos."}},"da":{"stringUnit":{"state":"needs_review","value":"Tilføj Stash-servere, skift mellem dem, og rediger eller fjern gemte servere."}},"de":{"stringUnit":{"state":"needs_review","value":"Füge Stash-Server hinzu, wechsle zwischen ihnen und bearbeite oder entferne gespeicherte."}},"ru":{"stringUnit":{"state":"needs_review","value":"Добавляйте серверы Stash, переключайтесь между ними, изменяйте или удаляйте сохраненные."}},"en":{"stringUnit":{"state":"needs_review","value":"Add Stash servers, switch between them, and edit or remove saved ones."}},"es":{"stringUnit":{"state":"needs_review","value":"Añade servidores Stash, cambia entre ellos y edita o elimina los guardados."}},"pl":{"stringUnit":{"state":"needs_review","value":"Dodawaj serwery Stash, przełączaj się między nimi oraz edytuj lub usuwaj zapisane."}},"nb":{"stringUnit":{"state":"needs_review","value":"Legg til Stash-servere, bytt mellom dem, og rediger eller fjern lagrede servere."}},"ja":{"stringUnit":{"state":"needs_review","value":"Stashサーバーを追加して切り替えたり、保存済みのサーバーを編集・削除したりできます。"}},"fr":{"stringUnit":{"state":"needs_review","value":"Ajoutez des serveurs Stash, passez de l'un à l'autre, et modifiez ou supprimez ceux enregistrés."}},"nl":{"stringUnit":{"state":"needs_review","value":"Voeg Stash-servers toe, schakel ertussen en wijzig of verwijder bewaarde servers."}},"ko":{"stringUnit":{"state":"needs_review","value":"Stash 서버를 추가하고 서버 간에 전환하며 저장된 서버를 편집하거나 제거합니다."}},"it":{"stringUnit":{"state":"needs_review","value":"Aggiungi server Stash, passa dall'uno all'altro e modifica o rimuovi quelli salvati."}},"tr":{"stringUnit":{"state":"needs_review","value":"Stash sunucuları ekle, aralarında geçiş yap, kayıtlı olanları düzenle veya kaldır."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"新增 Stash 伺服器、在它們之間切換，以及編輯或移除已儲存的伺服器。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"添加 Stash 服务器、在它们之间切换，并编辑或移除已存的服务器。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Lägg till Stash-servrar, växla mellan dem och redigera eller ta bort sparade servrar."}}}},"hint_ai_captions_are_part_of":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"AI 字幕是 stashy+ 的一部分"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"AI 字幕属于 stashy+"}},"sv":{"stringUnit":{"state":"needs_review","value":"AI-undertexter ingår i stashy+"}},"tr":{"stringUnit":{"state":"needs_review","value":"AI altyazılar stashy+'nın parçasıdır"}},"ru":{"stringUnit":{"state":"needs_review","value":"ИИ-субтитры входят в stashy+"}},"it":{"stringUnit":{"state":"needs_review","value":"I sottotitoli IA fanno parte di stashy+"}},"nb":{"stringUnit":{"state":"needs_review","value":"AI-teksting er en del av stashy+"}},"nl":{"stringUnit":{"state":"needs_review","value":"AI-bijschriften maken deel uit van stashy+"}},"es":{"stringUnit":{"state":"needs_review","value":"Los subtítulos con IA forman parte de stashy+"}},"ja":{"stringUnit":{"state":"needs_review","value":"AI字幕はstashy+の機能です"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Legendas por IA fazem parte do stashy+"}},"pl":{"stringUnit":{"state":"needs_review","value":"Napisy AI są częścią stashy+"}},"en":{"stringUnit":{"state":"needs_review","value":"AI captions are part of stashy+"}},"de":{"stringUnit":{"state":"needs_review","value":"KI-Untertitel sind Teil von stashy+"}},"da":{"stringUnit":{"state":"needs_review","value":"AI-undertekster er en del af stashy+"}},"fr":{"stringUnit":{"state":"needs_review","value":"Les sous-titres IA font partie de stashy+"}},"ko":{"stringUnit":{"state":"needs_review","value":"AI 캡션은 stashy+의 일부입니다"}}}},"hint_ai_captions_are_part_of_stashy":{"localizations":{"ja":{"stringUnit":{"state":"needs_review","value":"AI字幕はstashy+の機能です。設定でロックを解除してください"}},"ko":{"stringUnit":{"state":"needs_review","value":"AI 캡션은 stashy+의 일부입니다 — 설정에서 잠금 해제하세요"}},"en":{"stringUnit":{"state":"needs_review","value":"AI captions are part of stashy+ — unlock in Settings"}},"es":{"stringUnit":{"state":"needs_review","value":"Los subtítulos con IA forman parte de stashy+; desbloquéalo en Ajustes"}},"nl":{"stringUnit":{"state":"needs_review","value":"AI-bijschriften maken deel uit van stashy+ – ontgrendel in Instellingen"}},"nb":{"stringUnit":{"state":"needs_review","value":"AI-teksting er en del av stashy+ – lås opp i Innstillinger"}},"it":{"stringUnit":{"state":"needs_review","value":"I sottotitoli IA fanno parte di stashy+: sbloccali in Impostazioni"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Legendas por IA fazem parte do stashy+ — desbloqueie em Ajustes"}},"fr":{"stringUnit":{"state":"needs_review","value":"Les sous-titres IA font partie de stashy+ — débloquez-les dans les réglages"}},"ru":{"stringUnit":{"state":"needs_review","value":"ИИ-субтитры входят в stashy+ — разблокируйте в настройках"}},"de":{"stringUnit":{"state":"needs_review","value":"KI-Untertitel sind Teil von stashy+ – in den Einstellungen freischalten"}},"pl":{"stringUnit":{"state":"needs_review","value":"Napisy AI są częścią stashy+ — odblokuj w Ustawieniach"}},"da":{"stringUnit":{"state":"needs_review","value":"AI-undertekster er en del af stashy+ – lås op i Indstillinger"}},"sv":{"stringUnit":{"state":"needs_review","value":"AI-undertexter ingår i stashy+ – lås upp i Inställningar"}},"tr":{"stringUnit":{"state":"needs_review","value":"AI altyazılar stashy+'nın parçasıdır — Ayarlar'da kilidini aç"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"AI 字幕属于 stashy+ — 请在设置中解锁"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"AI 字幕是 stashy+ 的一部分 — 請在「設定」中解鎖"}}}},"hint_ai_motion_is_part_of":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"AI Motion 是 stashy+ 的一部分 — 請在「設定」中解鎖"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"AI Motion 属于 stashy+ — 请在设置中解锁"}},"tr":{"stringUnit":{"state":"needs_review","value":"AI Motion stashy+'nın parçasıdır — Ayarlar'da kilidini aç"}},"ja":{"stringUnit":{"state":"needs_review","value":"AI Motionはstashy+の機能です。設定でロックを解除してください"}},"da":{"stringUnit":{"state":"needs_review","value":"AI Motion er en del af stashy+ – lås op i Indstillinger"}},"ru":{"stringUnit":{"state":"needs_review","value":"AI Motion входит в stashy+ — разблокируйте в настройках"}},"fr":{"stringUnit":{"state":"needs_review","value":"AI Motion fait partie de stashy+ — débloquez-le dans les réglages"}},"nl":{"stringUnit":{"state":"needs_review","value":"AI Motion maakt deel uit van stashy+ – ontgrendel in Instellingen"}},"it":{"stringUnit":{"state":"needs_review","value":"AI Motion fa parte di stashy+: sbloccalo in Impostazioni"}},"en":{"stringUnit":{"state":"needs_review","value":"AI Motion is part of stashy+ — unlock in Settings"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O AI Motion faz parte do stashy+ — desbloqueie em Ajustes"}},"ko":{"stringUnit":{"state":"needs_review","value":"AI Motion은 stashy+의 일부입니다 — 설정에서 잠금 해제하세요"}},"pl":{"stringUnit":{"state":"needs_review","value":"AI Motion jest częścią stashy+ — odblokuj w Ustawieniach"}},"de":{"stringUnit":{"state":"needs_review","value":"AI Motion ist Teil von stashy+ – in den Einstellungen freischalten"}},"nb":{"stringUnit":{"state":"needs_review","value":"AI Motion er en del av stashy+ – lås opp i Innstillinger"}},"es":{"stringUnit":{"state":"needs_review","value":"AI Motion forma parte de stashy+; desbloquéalo en Ajustes"}},"sv":{"stringUnit":{"state":"needs_review","value":"AI Motion ingår i stashy+ – lås upp i Inställningar"}}}},"hint_ai_motion_uses_real_time":{"localizations":{"es":{"stringUnit":{"state":"needs_review","value":"AI Motion analiza el video en tiempo real en el dispositivo para sincronizar tus dispositivos. Este proceso usa mucho la CPU y puede aumentar el consumo de batería y calentar el dispositivo. Al activar esta función, aceptas que usas AI Motion y cualquier dispositivo de hardware controlado bajo tu propia responsabilidad. Cualquier daño o lesión derivado del uso del hardware conectado es exclusivamente responsabilidad tuya."}},"ja":{"stringUnit":{"state":"needs_review","value":"AI Motionは、デバイス上でのリアルタイム動画解析を使用してデバイスを同期します。この処理はCPU負荷が高く、バッテリー消費の増加やデバイスの発熱につながる場合があります。この機能を有効にすることで、AI Motionおよび制御されるハードウェアデバイスを自己責任で使用することに同意したものとみなされます。接続されたハードウェアの使用によって生じる損害や怪我については、すべてご自身の責任となります。"}},"en":{"stringUnit":{"state":"needs_review","value":"AI Motion uses real-time on-device video analysis to synchronize your devices. This process is CPU-intensive and can lead to increased battery drain and device heating. By enabling this feature, you acknowledge that you use AI Motion and any controlled hardware devices at your own risk. Any potential damage or injury resulting from the use of connected hardware is your sole responsibility."}},"fr":{"stringUnit":{"state":"needs_review","value":"AI Motion analyse la vidéo en temps réel sur l'appareil pour synchroniser vos appareils. Ce processus sollicite fortement le processeur et peut augmenter la consommation de batterie et l'échauffement de l'appareil. En activant cette fonction, vous reconnaissez utiliser AI Motion et tout appareil contrôlé à vos propres risques. Tout dommage ou blessure pouvant résulter de l'utilisation du matériel connecté relève de votre seule responsabilité."}},"da":{"stringUnit":{"state":"needs_review","value":"AI Motion bruger videoanalyse i realtid på enheden til at synkronisere dine enheder. Processen er CPU-krævende og kan øge batteriforbruget og få enheden til at blive varm. Ved at slå denne funktion til accepterer du, at du bruger AI Motion og alle styrede hardwareenheder på egen risiko. Enhver skade eller personskade som følge af brugen af tilsluttet hardware er alene dit ansvar."}},"nl":{"stringUnit":{"state":"needs_review","value":"AI Motion gebruikt realtime videoanalyse op het apparaat om je apparaten te synchroniseren. Dit proces belast de CPU zwaar en kan leiden tot hoger batterijverbruik en opwarming van het apparaat. Door deze functie in te schakelen, erken je dat je AI Motion en alle aangestuurde hardware op eigen risico gebruikt. Eventuele schade of letsel door het gebruik van verbonden hardware is uitsluitend je eigen verantwoordelijkheid."}},"ru":{"stringUnit":{"state":"needs_review","value":"AI Motion анализирует видео на устройстве в реальном времени, чтобы синхронизировать ваши устройства. Этот процесс сильно нагружает процессор и может ускорить разряд аккумулятора и нагрев устройства. Включая эту функцию, вы подтверждаете, что используете AI Motion и любые управляемые устройства на свой риск. Вы несете единоличную ответственность за любой ущерб или травмы, возникшие при использовании подключенного оборудования."}},"nb":{"stringUnit":{"state":"needs_review","value":"AI Motion bruker videoanalyse i sanntid på enheten for å synkronisere enhetene dine. Prosessen krever mye CPU og kan føre til økt batteriforbruk og at enheten blir varm. Ved å slå på denne funksjonen bekrefter du at du bruker AI Motion og all styrt maskinvare på eget ansvar. Eventuell skade som følge av bruk av tilkoblet maskinvare er ditt eget ansvar."}},"ko":{"stringUnit":{"state":"needs_review","value":"AI Motion은 기기 내 실시간 비디오 분석을 사용하여 기기를 동기화합니다. 이 과정은 CPU를 많이 사용하므로 배터리 소모가 늘고 기기가 뜨거워질 수 있습니다. 이 기능을 활성화하면 AI Motion 및 제어되는 모든 하드웨어 기기를 사용자 본인의 책임하에 사용하는 것에 동의하는 것입니다. 연결된 하드웨어 사용으로 인해 발생할 수 있는 모든 손상이나 부상은 전적으로 사용자의 책임입니다."}},"it":{"stringUnit":{"state":"needs_review","value":"AI Motion usa l'analisi video in tempo reale sul dispositivo per sincronizzare i tuoi dispositivi. Il processo richiede molta CPU e può aumentare il consumo della batteria e il riscaldamento del dispositivo. Attivando questa funzione, riconosci di usare AI Motion e qualsiasi dispositivo hardware controllato a tuo rischio. Eventuali danni o lesioni derivanti dall'uso dell'hardware connesso sono esclusivamente sotto la tua responsabilità."}},"pl":{"stringUnit":{"state":"needs_review","value":"AI Motion analizuje wideo w czasie rzeczywistym na urządzeniu, aby synchronizować Twoje urządzenia. Proces ten mocno obciąża procesor i może zwiększyć zużycie baterii oraz nagrzewanie urządzenia. Włączając tę funkcję, potwierdzasz, że korzystasz z AI Motion i wszelkich sterowanych urządzeń sprzętowych na własne ryzyko. Wyłączną odpowiedzialność za ewentualne szkody lub obrażenia wynikające z używania podłączonego sprzętu ponosisz Ty."}},"de":{"stringUnit":{"state":"needs_review","value":"AI Motion nutzt Echtzeit-Videoanalyse auf dem Gerät, um deine Geräte zu synchronisieren. Das beansprucht die CPU stark und kann zu höherem Akkuverbrauch und Erwärmung des Geräts führen. Mit dem Aktivieren dieser Funktion bestätigst du, dass du AI Motion und alle gesteuerten Hardwaregeräte auf eigenes Risiko verwendest. Für mögliche Schäden oder Verletzungen durch die Nutzung verbundener Hardware bist allein du verantwortlich."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O AI Motion usa análise de vídeo em tempo real no dispositivo para sincronizar seus dispositivos. Esse processo exige muito da CPU e pode aumentar o consumo de bateria e o aquecimento do dispositivo. Ao ativar este recurso, você reconhece que usa o AI Motion e quaisquer dispositivos de hardware controlados por sua conta e risco. Qualquer dano ou lesão decorrente do uso de hardware conectado é de sua exclusiva responsabilidade."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"AI Motion 會在裝置上即時分析影片，以同步你的裝置。此過程會大量使用 CPU，可能導致耗電增加和裝置發熱。啟用此功能即表示你了解使用 AI Motion 及任何受控硬體裝置的風險需自行承擔。因使用已連接硬體而可能造成的任何損壞或傷害，均由你自行負責。"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"AI Motion 使用设备上的实时视频分析来同步你的设备。此过程会占用大量 CPU，可能导致耗电增加和设备发热。启用此功能即表示你确认使用 AI Motion 及任何受控硬件设备的风险由你自行承担。因使用已连接硬件而导致的任何潜在损坏或伤害均由你本人负责。"}},"sv":{"stringUnit":{"state":"needs_review","value":"AI Motion använder videoanalys i realtid på enheten för att synkronisera dina enheter. Processen kräver mycket CPU och kan leda till ökad batteriförbrukning och att enheten blir varm. Genom att aktivera funktionen bekräftar du att du använder AI Motion och all styrd hårdvara på egen risk. Eventuella skador på egendom eller person till följd av användning av ansluten hårdvara är helt ditt eget ansvar."}},"tr":{"stringUnit":{"state":"needs_review","value":"AI Motion, aygıtlarını eşzamanlamak için aygıt üzerinde gerçek zamanlı video analizi kullanır. Bu işlem işlemciyi yoğun kullanır ve pil tüketiminin artmasına ve aygıtın ısınmasına yol açabilir. Bu özelliği açarak AI Motion'ı ve denetlenen tüm donanım aygıtlarını kendi sorumluluğunda kullandığını kabul edersin. Bağlı donanımın kullanımından doğabilecek her türlü hasar veya yaralanmanın sorumluluğu yalnızca sana aittir."}}}},"hint_ai_subtitles_are_part_of":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"AI altyazılar stashy+'nın parçasıdır"}},"sv":{"stringUnit":{"state":"needs_review","value":"AI-undertexter ingår i stashy+"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"AI 字幕是 stashy+ 的一部分"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"AI 字幕属于 stashy+"}},"ko":{"stringUnit":{"state":"needs_review","value":"AI 자막은 stashy+의 일부입니다"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Legendas por IA fazem parte do stashy+"}},"da":{"stringUnit":{"state":"needs_review","value":"AI-undertekster er en del af stashy+"}},"nl":{"stringUnit":{"state":"needs_review","value":"AI-ondertiteling maakt deel uit van stashy+"}},"es":{"stringUnit":{"state":"needs_review","value":"Los subtítulos con IA forman parte de stashy+"}},"de":{"stringUnit":{"state":"needs_review","value":"KI-Untertitel sind Teil von stashy+"}},"nb":{"stringUnit":{"state":"needs_review","value":"AI-undertekster er en del av stashy+"}},"ru":{"stringUnit":{"state":"needs_review","value":"ИИ-субтитры входят в stashy+"}},"en":{"stringUnit":{"state":"needs_review","value":"AI subtitles are part of stashy+"}},"it":{"stringUnit":{"state":"needs_review","value":"I sottotitoli IA fanno parte di stashy+"}},"ja":{"stringUnit":{"state":"needs_review","value":"AI字幕はstashy+の機能です"}},"fr":{"stringUnit":{"state":"needs_review","value":"Les sous-titres IA font partie de stashy+"}},"pl":{"stringUnit":{"state":"needs_review","value":"Napisy AI są częścią stashy+"}}}},"hint_ai_subtitles_are_part_of_stashy":{"localizations":{"de":{"stringUnit":{"state":"needs_review","value":"KI-Untertitel sind Teil von stashy+ – in den Einstellungen freischalten"}},"nb":{"stringUnit":{"state":"needs_review","value":"AI-undertekster er en del av stashy+ – lås opp i Innstillinger"}},"ko":{"stringUnit":{"state":"needs_review","value":"AI 자막은 stashy+의 일부입니다 — 설정에서 잠금 해제하세요"}},"es":{"stringUnit":{"state":"needs_review","value":"Los subtítulos con IA forman parte de stashy+; desbloquéalo en Ajustes"}},"nl":{"stringUnit":{"state":"needs_review","value":"AI-ondertiteling maakt deel uit van stashy+ – ontgrendel in Instellingen"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Legendas por IA fazem parte do stashy+ — desbloqueie em Ajustes"}},"it":{"stringUnit":{"state":"needs_review","value":"I sottotitoli IA fanno parte di stashy+: sbloccali in Impostazioni"}},"en":{"stringUnit":{"state":"needs_review","value":"AI subtitles are part of stashy+ — unlock in Settings"}},"ja":{"stringUnit":{"state":"needs_review","value":"AI字幕はstashy+の機能です。設定でロックを解除してください"}},"fr":{"stringUnit":{"state":"needs_review","value":"Les sous-titres IA font partie de stashy+ — débloquez-les dans les réglages"}},"pl":{"stringUnit":{"state":"needs_review","value":"Napisy AI są częścią stashy+ — odblokuj w Ustawieniach"}},"da":{"stringUnit":{"state":"needs_review","value"