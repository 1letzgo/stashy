,"en":{"stringUnit":{"state":"translated","value":"Use this image as the profile picture of %@."}}}},"hint_used_instead_of_address_above":{"localizations":{"zh-Hant":{"stringUnit":{"state":"needs_review","value":"只要能連上，就會取代上方的位址，例如在你的家用網路中。連不上時會自動改用原位址。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Yanıt verdiği sürece, örneğin ev ağında, yukarıdaki adres yerine kullanılır. Otomatik olarak geri döner."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"只要该地址有响应（例如在家庭网络中），就会代替上方地址使用。会自动回退。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Brukes i stedet for adressen ovenfor når den svarer, for eksempel på hjemmenettverket. Faller automatisk tilbake."}},"fr":{"stringUnit":{"state":"needs_review","value":"Utilisée à la place de l'adresse ci-dessus dès qu'elle répond, par exemple sur votre réseau domestique. Bascule automatiquement sinon."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Usado no lugar do endereço acima sempre que responder, por exemplo na sua rede doméstica. Volta automaticamente ao outro."}},"de":{"stringUnit":{"state":"needs_review","value":"Wird statt der Adresse oben verwendet, sobald sie antwortet, etwa in deinem Heimnetz. Wechselt automatisch zurück."}},"sv":{"stringUnit":{"state":"needs_review","value":"Används i stället för adressen ovan när den svarar, till exempel på ditt hemnätverk. Faller tillbaka automatiskt."}},"en":{"stringUnit":{"state":"translated","value":"Used instead of the address above whenever it answers, for example on your home network. Falls back automatically."}},"da":{"stringUnit":{"state":"needs_review","value":"Bruges i stedet for adressen ovenfor, når den svarer, f.eks. på dit hjemmenetværk. Skifter automatisk tilbage."}},"ja":{"stringUnit":{"state":"needs_review","value":"応答がある場合（自宅のネットワークなど）は、上のアドレスの代わりに使用されます。自動的に切り替わります。"}},"nl":{"stringUnit":{"state":"needs_review","value":"Wordt gebruikt in plaats van het adres hierboven zodra het antwoordt, bijvoorbeeld op je thuisnetwerk. Valt automatisch terug."}},"es":{"stringUnit":{"state":"needs_review","value":"Se usa en lugar de la dirección de arriba siempre que responda, por ejemplo en tu red doméstica. Si no, se vuelve a la otra automáticamente."}},"ko":{"stringUnit":{"state":"needs_review","value":"홈 네트워크 등에서 응답할 때마다 위의 주소 대신 사용됩니다. 응답하지 않으면 자동으로 되돌아갑니다."}},"pl":{"stringUnit":{"state":"needs_review","value":"Używany zamiast powyższego adresu, gdy tylko odpowiada, np. w sieci domowej. W razie potrzeby automatycznie wraca do zwykłego adresu."}},"it":{"stringUnit":{"state":"needs_review","value":"Usato al posto dell'indirizzo qui sopra ogni volta che risponde, ad esempio sulla rete di casa. Altrimenti torna automaticamente all'altro."}},"ru":{"stringUnit":{"state":"needs_review","value":"Используется вместо адреса выше, когда отвечает, например в домашней сети. При недоступности — автоматический возврат."}}}},"hint_using_arg_speech_recognition_scene":{"localizations":{"pl":{"stringUnit":{"state":"needs_review","value":"Używane jest rozpoznawanie mowy %@ (język sceny nie jest zainstalowany)."}},"sv":{"stringUnit":{"state":"needs_review","value":"Använder taligenkänning för %@ (scenens språk är inte installerat)."}},"nb":{"stringUnit":{"state":"needs_review","value":"Bruker talegjenkjenning for %@ (scenespråket er ikke installert)."}},"da":{"stringUnit":{"state":"needs_review","value":"Bruger talegenkendelse til %@ (scenens sprog er ikke installeret)."}},"it":{"stringUnit":{"state":"needs_review","value":"Uso del riconoscimento vocale %@ (lingua della scena non installata)."}},"fr":{"stringUnit":{"state":"needs_review","value":"Reconnaissance vocale %@ utilisée (langue de la scène non installée)."}},"de":{"stringUnit":{"state":"needs_review","value":"Spracherkennung für %@ wird verwendet (Sprache der Szene nicht installiert)."}},"ja":{"stringUnit":{"state":"needs_review","value":"%@の音声認識を使用しています（シーンの言語がインストールされていません）。"}},"es":{"stringUnit":{"state":"needs_review","value":"Usando reconocimiento de voz en %@ (el idioma de la escena no está instalado)."}},"nl":{"stringUnit":{"state":"needs_review","value":"Spraakherkenning %@ wordt gebruikt (scènetaal niet geïnstalleerd)."}},"ru":{"stringUnit":{"state":"needs_review","value":"Используется распознавание речи %@ (язык сцены не установлен)."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Usando o reconhecimento de fala em %@ (idioma da cena não instalado)."}},"en":{"stringUnit":{"state":"translated","value":"Using %@ speech recognition (scene language not installed)."}},"ko":{"stringUnit":{"state":"needs_review","value":"%@ 음성 인식을 사용 중입니다(영상 언어가 설치되지 않음)."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"正在使用%@語音辨識（未安裝短片語言）。"}},"tr":{"stringUnit":{"state":"needs_review","value":"%@ konuşma tanıma kullanılıyor (sahne dili yüklü değil)."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"正在使用%@语音识别（未安装短片语言）。"}}}},"hint_version_and_build_number_of":{"localizations":{"sv":{"stringUnit":{"state":"needs_review","value":"Version och byggnummer för appen."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"此 App 的版本和版本号。"}},"tr":{"stringUnit":{"state":"needs_review","value":"Bu uygulamanın sürümü ve derleme numarası."}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"此 App 的版本和組建編號。"}},"ru":{"stringUnit":{"state":"needs_review","value":"Версия и номер сборки этого приложения."}},"es":{"stringUnit":{"state":"needs_review","value":"Versión y número de compilación de esta app."}},"da":{"stringUnit":{"state":"needs_review","value":"Version og buildnummer for denne app."}},"fr":{"stringUnit":{"state":"needs_review","value":"Version et numéro de build de cette app."}},"pl":{"stringUnit":{"state":"needs_review","value":"Wersja i numer kompilacji tej aplikacji."}},"ko":{"stringUnit":{"state":"needs_review","value":"이 앱의 버전 및 빌드 번호입니다."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Versão e número de build deste app."}},"de":{"stringUnit":{"state":"needs_review","value":"Version und Build-Nummer dieser App."}},"nl":{"stringUnit":{"state":"needs_review","value":"Versie- en buildnummer van deze app."}},"it":{"stringUnit":{"state":"needs_review","value":"Versione e numero di build di questa app."}},"ja":{"stringUnit":{"state":"needs_review","value":"このアプリのバージョンとビルド番号です。"}},"nb":{"stringUnit":{"state":"needs_review","value":"Versjon og byggnummer for denne appen."}},"en":{"stringUnit":{"state":"translated","value":"Version and build number of this app."}}}},"hint_video_file_is_removed_from":{"localizations":{"da":{"stringUnit":{"state":"needs_review","value":"Videofilen fjernes fra denne enhed."}},"es":{"stringUnit":{"state":"needs_review","value":"El archivo de video se quita de este dispositivo."}},"en":{"stringUnit":{"state":"translated","value":"The video file is removed from this device."}},"nb":{"stringUnit":{"state":"needs_review","value":"Videofilen fjernes fra denne enheten."}},"de":{"stringUnit":{"state":"needs_review","value":"Die Videodatei wird von diesem Gerät entfernt."}},"nl":{"stringUnit":{"state":"needs_review","value":"Het videobestand wordt van dit apparaat verwijderd."}},"pl":{"stringUnit":{"state":"needs_review","value":"Plik wideo zostanie usunięty z tego urządzenia."}},"ja":{"stringUnit":{"state":"needs_review","value":"動画ファイルはこのデバイスから削除されます。"}},"ko":{"stringUnit":{"state":"needs_review","value":"비디오 파일이 이 기기에서 제거됩니다."}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"O arquivo de vídeo será removido deste dispositivo."}},"it":{"stringUnit":{"state":"needs_review","value":"Il file video viene rimosso da questo dispositivo."}},"ru":{"stringUnit":{"state":"needs_review","value":"Видеофайл будет удален с этого устройства."}},"fr":{"stringUnit":{"state":"needs_review","value":"Le fichier vidéo est retiré de cet appareil."}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"视频文件将从此设备中移除。"}},"sv":{"stringUnit":{"state":"needs_review","value":"Videofilen tas bort från den här enheten."}},"zh-Hant":{"stringUnit":{"state