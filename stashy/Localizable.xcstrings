y lub wygasł"}},"nb":{"stringUnit":{"state":"needs_review","value":"API-nøkkelen er ugyldig eller utløpt"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"A chave de API é inválida ou expirou"}},"es":{"stringUnit":{"state":"needs_review","value":"La clave de API no es válida o ha caducado"}},"da":{"stringUnit":{"state":"needs_review","value":"API-nøglen er ugyldig eller udløbet"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"API 密钥无效或已过期"}},"tr":{"stringUnit":{"state":"needs_review","value":"API anahtarı geçersiz veya süresi dolmuş"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"API 金鑰無效或已過期"}}}},"hint_api_key_not_found_in":{"localizations":{"tr":{"stringUnit":{"state":"needs_review","value":"API anahtarı sunucu yapılandırmasında bulunamadı"}},"zh-Hant":{"stringUnit":{"state":"needs_review","value":"在伺服器設定中找不到 API 金鑰"}},"zh-Hans":{"stringUnit":{"state":"needs_review","value":"服务器配置中未找到 API 密钥"}},"sv":{"stringUnit":{"state":"needs_review","value":"API-nyckeln hittades inte i serverkonfigurationen"}},"de":{"stringUnit":{"state":"needs_review","value":"API-Schlüssel nicht in der Serverkonfiguration gefunden"}},"nl":{"stringUnit":{"state":"needs_review","value":"API-sleutel niet gevonden in serverconfiguratie"}},"pl":{"stringUnit":{"state":"needs_review","value":"Nie znaleziono klucza API w konfiguracji serwera"}},"fr":{"stringUnit":{"state":"needs_review","value":"Clé API introuvable dans la configuration du serveur"}},"nb":{"stringUnit":{"state":"needs_review","value":"Fant ikke API-nøkkelen i serverkonfigurasjonen"}},"es":{"stringUnit":{"state":"needs_review","value":"No se encontró la clave de API en la configuración del servidor"}},"pt-BR":{"stringUnit":{"state":"needs_review","value":"Chave de API não encontrada na configuração do servidor"}},"en":{"stringUnit":{"state":"needs_review","value":"API key not found in server configuration"}},"ja":{"stringUnit":{"state":"needs_review","value":"サーバー設定にAPIキーが見つかりません"}},"ko":{"stringUnit":{